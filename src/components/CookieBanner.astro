---
// Cookie banner (CNIL): Google Analytics only loads after "Accepter", and only on the real
// domain (studio-ode.fr), so staging visits are never counted. "Refuser" is as visible as "Accepter".
// The choice is kept 6 months in localStorage ("odeConsent"); any element with [data-cookie-settings] (the footer's
// "Cookies" link) opens the banner again. Withdrawing consent deletes the Google Analytics cookies.
const GA_ID = "G-L4RGBZPCJV";   // Google Analytics 4 measurement ID
const HOSTS = ["studio-ode.fr", "www.studio-ode.fr"];
---
<div class="ock" id="ock" role="dialog" aria-modal="false" aria-labelledby="ock-h" aria-describedby="ock-p" hidden>
  <p class="ock-h" id="ock-h">Un petit cookie&nbsp;?<img src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></p>
  <p class="ock-p" id="ock-p">On aimerait utiliser Google Analytics pour savoir comment le site est visité et l’améliorer. Uniquement si tu es d’accord&nbsp;: tu peux changer d’avis à tout moment via «&nbsp;Cookies&nbsp;» en bas de page. <a href="/confidentialite#cookies">En savoir plus</a></p>
  <div class="ock-btns">
    <button type="button" class="ock-btn" data-ock="denied">Refuser</button>
    <button type="button" class="ock-btn" data-ock="granted">Accepter</button>
  </div>
</div>

<script is:inline define:vars={{ GA_ID, HOSTS }}>
  (() => {
    const KEY = "odeConsent", SIX_MONTHS = 1000 * 60 * 60 * 24 * 182;
    const box = document.getElementById("ock");
    const read = () => { try { const v = JSON.parse(localStorage.getItem(KEY) || "null"); return v && Date.now() - v.t < SIX_MONTHS ? v.c : null; } catch { return null; } };
    const save = (c) => { try { localStorage.setItem(KEY, JSON.stringify({ c, t: Date.now() })); } catch {} };

    const loadGA = () => {
      if (window.__odeGA || !HOSTS.includes(location.hostname)) return;
      window.__odeGA = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag("js", new Date());
      window.gtag("config", GA_ID, { cookie_expires: 60 * 60 * 24 * 395 });   // 13 months, as the CNIL recommends
      const s = document.createElement("script"); s.async = true; s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
      document.head.appendChild(s);
    };
    // refusing after accepting: remove the Google Analytics cookies (_ga, _ga_XXXX) on this domain and its parent
    const clearGA = () => {
      const parts = location.hostname.split("."), domains = ["", location.hostname, "." + parts.slice(-2).join(".")];
      document.cookie.split(";").map((c) => c.split("=")[0].trim()).filter((n) => /^_ga|^_gid|^_gat/.test(n)).forEach((n) => {
        domains.forEach((d) => { document.cookie = `${n}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${d ? "; domain=" + d : ""}`; });
      });
    };

    const show = () => { box.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => box.classList.add("on"))); };
    const hide = () => { box.classList.remove("on"); setTimeout(() => { if (!box.classList.contains("on")) box.hidden = true; }, 450); };

    const choice = read();
    if (choice === "granted") loadGA();
    // let the page's own entrance play first: on the homepage the preloader (~2.4 s) and the hero intro run until ~4.3 s
    else if (choice === null) setTimeout(show, document.documentElement.classList.contains("has-pl") ? 5000 : 2200);

    box.addEventListener("click", (e) => {
      const b = e.target.closest("[data-ock]"); if (!b) return;
      const c = b.dataset.ock, before = read();
      save(c); hide();
      if (c === "granted") loadGA();
      else if (before === "granted") { clearGA(); location.reload(); }   // the tag is already running: reload without it
    });
    document.addEventListener("click", (e) => { if (e.target.closest("[data-cookie-settings]")) { e.preventDefault(); show(); } });
  })();
</script>

<style is:global>
  /* small frosted-glass card bottom-left, like the navbar's glass buttons; burgundy "Accepter", outlined "Refuser" (same size) */
  .ock { position: fixed; z-index: 900; left: 1.25rem; bottom: 1.25rem; width: 23rem; max-width: calc(100vw - 2.5rem); padding: 1.25rem 1.25rem 1.125rem; border-radius: 1.125rem;
    background: rgb(255 255 255 / 78%); border: 1px solid rgb(31 29 30 / 10%); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    box-shadow: 0 24px 60px -28px rgb(31 29 30 / 45%); color: #1f1d1e; font-family: var(--_typography---font--primary-family), sans-serif;
    opacity: 0; transform: translateY(1rem); transition: opacity .45s ease, transform .6s cubic-bezier(.16, 1, .3, 1); }
  .ock.on { opacity: 1; transform: none; }
  .ock[hidden] { display: none; }
  .ock-h { position: relative; display: inline-block; margin: 0 0 .625rem; font-family: var(--_typography---font--secondary-family); font-weight: 500; font-size: 1.625rem; line-height: 1; letter-spacing: -.02em; }
  .ock-h img { position: absolute; right: -2rem; top: -.75rem; width: 1.5rem; height: auto; transform: rotate(12deg); filter: drop-shadow(0 2px 3px rgb(0 0 0 / 25%)); }
  .ock-p { margin: 0 0 1rem; font-size: .8125rem; line-height: 1.5; color: #4a4547; }
  .ock-p a { color: #401f28; text-decoration: underline; text-underline-offset: .15em; white-space: nowrap; }
  .ock-btns { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .ock-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0 1rem; text-align: center; height: 2.625rem; border-radius: 9999px; border: 1px solid #401f28; background: transparent; color: #401f28; font: inherit; font-size: .8125rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; transition: background-color .3s, color .3s; }
  .ock-btn:hover, .ock-btn:focus-visible { background: #401f28; color: #fff; }
  .ock-btn[data-ock="granted"] { background: #401f28; color: #fff; }
  .ock-btn[data-ock="granted"]:hover, .ock-btn[data-ock="granted"]:focus-visible { background: #2b141b; }
  .ock-btn:focus-visible { outline: 2px solid #401f28; outline-offset: 3px; }
  @media (max-width: 767px) { .ock { left: .75rem; right: .75rem; bottom: .75rem; width: auto; max-width: none; } }
  @media (prefers-reduced-motion: reduce) { .ock { transition: opacity .2s; transform: none; } }
</style>
