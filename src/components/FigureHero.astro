---
// The catalogue / trick-page hero: same markup as the homepage hero, so it gets the
// same fluted glass and the same letter-by-letter load animation (needs wfPage = home page id).
interface Props { title: string; image: string; short?: boolean; labels?: string[]; intro?: string }
const { title, image, short = false, labels = [], intro } = Astro.props;
const text = title.toUpperCase();
// One line when it fits; long names go on two balanced lines. Size so the longest line fills the width.
let lines = [text];
if (text.length > 12 && text.includes(" ")) {
  const words = text.split(" ");
  let best = [text], bestMax = Infinity;
  for (let i = 1; i < words.length; i++) {
    const a = words.slice(0, i).join(" "), b = words.slice(i).join(" ");
    const m = Math.max(a.length, b.length);
    if (m < bestMax) { bestMax = m; best = [a, b]; }
  }
  lines = best;
}
const longest = Math.max(...lines.map((l) => l.length));
const sizeMobile = `min(18vw, ${(125 / longest).toFixed(2)}vw)`;
const size = short
  ? `min(${lines.length > 1 ? 11 : 18}vw, ${(130 / longest).toFixed(2)}vw)`
  : `min(21vw, ${(147 / longest).toFixed(2)}vw)`;
---
    <section slide-down="" data-wf--section--variant="100svh" data-w-id="9cd849af-5c85-da69-3983-2e49dba72900" class:list={["u-section w-variant-f69fa043-d68c-1f67-d426-c93e24510eb4 u-padding-bottom-0 u-theme-dark fh-hero", { "fh-short": short, "fh-tall": !short }]}>
      <div class="u-background-slot">
        <div tlg-fluted-glass-canvas="" tlg-fluted-glass-mode="scroll" tlg-fluted-glass-segments="60" class="keypoints_visual_wrap"><img class="keypoints_visual_img" src={`${image}.webp`} alt="" sizes="100vw" loading="eager" srcset={`${image}-p-500.webp 500w, ${image}-p-800.webp 800w, ${image}.webp 1024w`} tlg-fluted-glass-image=""></div>
        <div data-wf--media-overlay--variant="gradient" data-number="20" class="u-overlay w-variant-9653c0cc-21fc-fb82-1373-c98b1644e5a8"></div>
      </div>
      <div class="u-container w-variant-f69fa043-d68c-1f67-d426-c93e24510eb4">
        <div data-wf--layout--variant="breakout-reversed" class="u-layout-wrapper w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7">
          <div class="u-layout w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7">
            <div class="fh-col u-layout-column-2 w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7  ">
              <div data-wf--content-wrapper--variant="left" style="" class="u-content-wrapper w-variant-e85a4315-14bc-e5ef-0d3e-2c8c9ed7d2f1">
                <div class="u-display-contents">
                  <h1 class="heading fh-heading" style={`font-size: ${size}; --fh-m: ${sizeMobile}`}>{lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</h1>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {!short && (labels.length > 0 || intro) && (
        <div fade-in="" class="fh-labels">{labels.map((l) => <span class="card_classes_btn u-text-style-small">{l}</span>)}</div>
        <div fade-in="" class="fh-aside">
          {intro && <p>{intro}</p>}
          <a href="#catalogue" class="fh-down" aria-label="Voir les figures"><svg width="14" height="18" viewBox="0 0 14 18" fill="none" aria-hidden="true"><path d="M7 1v15.5M1 11l6 6 6-6" stroke="currentColor" stroke-width="1.4"></path></svg></a>
        </div>
      )}
    </section>

<style>
  .fh-col { grid-column: 1 / -1; width: 100%; }
  .fh-heading { width: auto; white-space: nowrap; letter-spacing: -.02em; }
  .fh-short .fh-heading { line-height: .95; }
  /* Trick pages: a shorter hero, name centred (long names stay fully visible) */
  .fh-short { height: 64svh; min-height: 30rem; justify-content: center; }
  .fh-short .fh-col, .fh-short .u-content-wrapper { text-align: center; justify-content: center; align-items: center; }
  .fh-short .fh-heading { top: 0; margin: 0 auto; text-align: center; }
  @media (max-width: 767px) { .fh-short { height: 56svh; min-height: 24rem; } .fh-short .fh-heading { font-size: var(--fh-m) !important; } }
  .fh-hero { position: relative; }
  .fh-aside, .fh-labels { display: none; }
  /* Phone, catalogue hero (design N3): shorter hero; labels above the word, intro + scroll button under it */
  @media (max-width: 767px) {
    .fh-tall { height: 80svh; min-height: 34rem; padding-bottom: 5.75rem; }
    .fh-tall .fh-heading { top: 0; font-size: 20vw !important; line-height: 1; margin-left: -.04em; }
    .fh-tall .fh-labels { position: absolute; z-index: 2; left: var(--site--margin); right: var(--site--margin); bottom: calc(5.75rem + 20vw + .75rem); display: flex; flex-wrap: wrap; gap: .375rem; color: #fff; }
    .fh-tall .fh-aside { position: absolute; z-index: 2; left: var(--site--margin); right: var(--site--margin); bottom: 1.375rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; color: #fff; }
    .fh-aside p { margin: 0; max-width: 14rem; font-size: .9375rem; line-height: 1.45; }
    .fh-down { width: 3.25rem; height: 3.25rem; flex: none; border-radius: 9999px; border: 1px solid rgb(255 255 255 / 35%); background: rgb(255 255 255 / 14%); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); display: flex; align-items: center; justify-content: center; color: #fff; }
    .fh-down:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  }
</style>

<script>
  // smooth scroll (Lenis) to the catalogue from the hero arrow
  document.querySelectorAll<HTMLAnchorElement>(".fh-down").forEach((a) => a.addEventListener("click", (e) => {
    const t = document.querySelector(a.getAttribute("href")!);
    const lenis = (window as any).lenis;
    if (t && lenis) { e.preventDefault(); lenis.scrollTo(t, { offset: -24 }); }
  }));
</script>
