<style is:global>
  /* the chrome letters carry width/height (no layout shift while they load); they still share the row equally */
  .footer_bottom_letter { min-width: 0; flex: 1 1 0; height: auto; }
  .footer_wrap { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; }
  .fo-mid { flex: 1 0 auto; }
  /* engraved: spaced capitals pressed into the silver, like the invitation card */
  .fo-eng { font-family: "Cinzel", Georgia, serif; font-weight: 400; text-transform: uppercase; letter-spacing: .32em; color: #4b4b4b; text-shadow: 0 1px 0 rgb(255 255 255 / 60%), 0 -1px 0 rgb(0 0 0 / 18%); }
  .fo-mid { display: flex; flex-direction: column; align-items: center; padding: 2.5rem var(--site--margin, 2.5rem) 3rem; text-align: center; }
  .fo-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; width: min(38.75rem, 100%); margin-top: 2.125rem; }
  .fo-card { display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: .5rem; padding: 1.75rem 1.5rem 1.625rem; border-radius: 1.25rem; background: rgb(255 255 255 / 20%); }
  .fo-ct { margin: 0; font-size: .875rem; }
  .fo-ct::after { content: ""; display: block; width: 2.5rem; height: 2px; margin: .75rem auto 0; background: linear-gradient(#fff 0 50%, rgb(0 0 0 / 22%) 50% 100%); }
  .fo-vis { width: 6rem; height: 6rem; object-fit: contain; margin: .5rem 0; }
  .fo-icons { display: flex; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .fo-ic { display: flex; align-items: center; justify-content: center; width: 2.125rem; height: 2.125rem; background: #fff; transition: background-color .4s; }
  .fo-ic svg { width: .875rem; height: .875rem; }
  .fo-ic svg path { fill: #3b3b3b; transition: fill .4s; }
  .fo-ic:hover, .fo-ic:focus-visible { background: #401f28; }
  .fo-ic:hover svg path, .fo-ic:focus-visible svg path { fill: #fff; }
  .fo-ic:focus-visible { outline: 2px solid #401f28; outline-offset: 3px; }
  /* site map (desktop): plain heading and links on the left, the two cards on the right; phones show the cards only */
  .fo-map { display: none; }
  @media (min-width: 768px) {
    .fo-mid { flex-direction: row; justify-content: space-between; align-items: flex-end; gap: 3rem; padding: 4.5rem var(--site--margin, 2.5rem) 3.5rem; text-align: left; }
    .fo-map { display: block; }
    /* plain white text, like the rest of the site */
    .fo-map-t { margin: 0 0 1.25rem; font-size: 2rem; font-weight: 400; line-height: 1.2; color: #fff; }
    .fo-map ul { display: grid; gap: .625rem; margin: 0; padding: 0; list-style: none; }
    .fo-map a { font-size: .9375rem; color: #fff; text-decoration: none; transition: opacity .3s; }
    .fo-map ul:hover a { opacity: .6; }
    .fo-map ul a:hover, .fo-map a:focus-visible { opacity: 1; }
    .fo-cards { margin-top: 0; }
    }
  .fo-bar { display: flex; justify-content: space-between; align-items: center; gap: 1.25rem; margin: 0 var(--site--margin, 2.5rem); padding: 1.125rem 0 1.75rem; border-top: 1px solid rgb(255 255 255 / 45%); box-shadow: 0 -1px 0 rgb(0 0 0 / 12%); }
  .fo-bar .fo-eng { font-size: .625rem; letter-spacing: .24em; text-decoration: none; }
  .fo-bar-r { display: flex; gap: 1.625rem; }
  @media (max-width: 767px) {
    .fo-mid { justify-content: center; padding: 1.5rem 1.125rem 2.25rem; }
    .fo-cards { gap: .75rem; margin-top: 1.75rem; }
    .fo-card { padding: 1.375rem .625rem 1.25rem; }
    .fo-ct { font-size: .75rem; letter-spacing: .24em; }
    .fo-icons { gap: .375rem; }
    .fo-ic { width: 1.875rem; height: 1.875rem; }
    .fo-ic svg { width: .75rem; height: .75rem; }
    .fo-vis { width: 4.75rem; height: 4.75rem; }
      .fo-bar { flex-direction: column; gap: .75rem; margin: 0 1.125rem; text-align: center; }
    .fo-bar-r { flex-wrap: wrap; justify-content: center; gap: .625rem 1.125rem; }
  }
</style>
