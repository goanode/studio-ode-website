---
// Site navbar (hovering a link shows its own chrome icon: sparkle, heart, book): logo left, page links centred in small capitals, a glass "Réserve ta place" pill on the right
// (turns burgundy with the chrome heart on hover, opens the waitlist). On mobile: logo + "Menu", which opens a
// full-screen dark menu over the blurred page with big Freight links and the glass waitlist button.
// Text is white over dark heroes and dark over light pages; once you scroll, the bar gets a frosted white backing.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/$/, "") || "/";
const lightText = path === "/" || path === "/menu";
const links = [
  { label: "Concept", href: "/concept", on: path === "/concept", icon: "/images/ode-icon-sparkle-s.webp" },
  { label: "Communauté", href: "/communaute", on: path === "/communaute", icon: "/images/ode-heart-s.webp" },
  { label: "Figures", href: "/figures", on: path === "/figures" || path.startsWith("/figures/"), icon: "/images/ode-icon-book-s.webp" },
  { label: "Le studio", href: "/studio", on: path === "/studio", icon: "/images/Glanzend-chromen-hart-op-transparante-achtergrond-p-300.webp" },
];
const HEART = "/images/ode-heart-s.webp";
// the full-screen menu also starts with Accueil (chrome envelope)
const sheetLinks = [{ label: "Accueil", href: "/", on: path === "/" || path === "/index", icon: "/images/Glanzende-chromen-envelop-met-hartzegel-p-300.webp" }, ...links];
---
<a href="#main" class="onav-skip">Aller au contenu</a>
<header class:list={["onav", lightText ? "is-light" : "is-dark"]} data-onav data-base={lightText ? "light" : "dark"}>
  <a class="onav-logo" href="/" aria-label="Studio Ode, accueil" aria-current={path === "/" ? "page" : undefined}>
    <img src="/images/ode-logo-300.webp" srcset="/images/ode-logo-150.webp 150w, /images/ode-logo-300.webp 300w" sizes="(max-width: 991px) 5.25rem, 6.25rem" alt="Studio Ode" width="300" height="80" fetchpriority="high" />
  </a>
  <nav class="onav-links" aria-label="Navigation principale">
    {links.map((l, li) => (
      <a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? "page" : undefined} aria-label={l.label} style={`--li:${li}`}>
        <span class="rl" aria-hidden="true">{[...l.label].map((ch, i) => <span class="ch" style={`--d:${i}`} data-c={ch}>{ch}</span>)}</span><img class="onav-lh" src={l.icon} alt="" aria-hidden="true" />
      </a>
    ))}
  </nav>
  <div class="onav-right">
    <button type="button" class="onav-cta" data-modal-trigger="waitlist">Réserve ta place<img class="onav-heart" src={HEART} alt="" aria-hidden="true" /></button>
    <button type="button" class="onav-menu" aria-expanded="false" aria-controls="onav-sheet"><span class="o">Menu</span><span class="c">Fermer ×</span></button>
  </div>
</header>
<div class="onav-sheet" id="onav-sheet" hidden>
  <div class="onav-mid">
    <ul>
      {sheetLinks.map((l, i) => <li style={`--i:${i}`}><a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? "page" : undefined}><span class="onav-icw" aria-hidden="true"><img class="onav-ic" src={l.icon} alt="" loading="lazy" /></span><span class="w"><span class="wi">{l.label}</span></span></a></li>)}
    </ul>
    <p class="onav-blurb">Ode, le nouveau studio de pole dance à Lille. Ouverture en 2027, 50 places fondatrices, gratuites et sans engagement.</p>
    <span class="onav-num" aria-hidden="true"></span>
  </div>
  <div class="onav-foot">
    <span>Studio de pole dance · Lille</span>
    <span class="onav-soc"><span>Instagram</span><span>TikTok</span></span>
    <span class="onav-cr"><i class="onav-dot"></i>©2026</span>
  </div>
</div>

<style is:global>
  :root { --nav--height-total: calc(2.75rem + var(--site--margin, 2.5rem)); }
  .onav-skip { position: fixed; left: .75rem; top: .75rem; z-index: 1001; padding: .5rem .875rem; border-radius: 9999px; background: #fff; color: #1f1d1e; transform: translateY(-200%); transition: transform .2s; }
  .onav-skip:focus { transform: none; }
  .onav { --fg: #fff; position: fixed; z-index: 1000; left: 0; right: 0; top: 0; height: var(--nav--height-total); display: flex; align-items: center; justify-content: space-between; padding: 0 var(--site--margin, 2.5rem); color: var(--fg); transition: color .35s; font-family: var(--_typography---font--primary-family), sans-serif; }
  .onav.is-dark { --fg: #1f1d1e; }
  /* the silver chrome logo as it is (a soft shadow keeps it readable on light sections) */
  .onav-logo img { display: block; height: 1.625rem; width: auto; filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 28%)); }
  .onav-links { position: absolute; left: 50%; transform: translateX(-50%); display: flex; gap: 2.5rem; }
  /* hover: the other links fade, and the hovered one shows its own chrome icon */
  .onav-links a { position: relative; display: block; font-size: .9375rem; line-height: 1; letter-spacing: .01em; color: inherit; text-decoration: none; transition: opacity .35s; }
  .onav-links .rl { display: flex; overflow: hidden; padding: .125rem 0; }
  .onav-links .ch { position: relative; display: block; white-space: pre; }
  .onav-links:hover a:not(:hover), .onav-links:focus-within a:not(:focus-visible):not(:hover) { opacity: .35; }
  .onav-lh { position: absolute; right: -.875rem; top: -.625rem; width: 1.125rem; height: auto; pointer-events: none; opacity: 0; transform: translateY(.375rem) rotate(-30deg) scale(.3); transition: transform .5s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; filter: drop-shadow(0 2px 3px rgb(0 0 0 / 30%)); }
  .onav-links a:hover .onav-lh, .onav-links a:focus-visible .onav-lh { opacity: 1; transform: rotate(12deg); }
  @media (prefers-reduced-motion: reduce) { .onav-lh { transition: opacity .2s; transform: none; } }
  .onav-right { display: flex; align-items: center; gap: 1rem; }
  .onav-cta { position: relative; display: inline-flex; align-items: center; justify-content: center; height: 2.625rem; padding: 0 1.25rem; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--fg) 45%, transparent); background: color-mix(in srgb, var(--fg) 12%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); color: inherit; font: inherit; font-size: .9375rem; letter-spacing: .01em; white-space: nowrap; cursor: pointer; transition: background-color .35s, border-color .35s, color .35s; }
  .onav-cta:hover, .onav-cta:focus-visible { background: #401f28; border-color: #401f28; color: #fff; }
  .onav-cta:focus-visible, .onav-menu:focus-visible, .onav-links a:focus-visible, .onav-sheet a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .onav-heart { position: absolute; right: -.5rem; top: -.875rem; width: 1.875rem; height: auto; pointer-events: none; opacity: 0; transform: translateY(.75rem) rotate(-30deg) scale(.3); transition: transform .55s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; filter: drop-shadow(0 4px 6px rgb(0 0 0 / 30%)); }
  .onav-cta:hover .onav-heart, .onav-cta:focus-visible .onav-heart { opacity: 1; transform: translateY(-.25rem) rotate(12deg) scale(1); }
  .onav-menu { display: none; padding: .5rem 0; border: 0; background: none; color: inherit; font: inherit; font-size: .9375rem; letter-spacing: .01em; cursor: pointer; }
  .onav-menu .c { display: none; }

  /* full-screen menu (F3): white sheet that slides down like a curtain. Big Freight links on the left; the hovered one (or the
     current page) turns burgundy with its chrome icon sliding in before it, the others fade. A big faint number in the corner
     follows the hovered link. The navbar (logo, Réserve ta place, Fermer) stays on top. */
  .onav-sheet { position: fixed; z-index: 999; inset: 0; display: grid; grid-template-rows: 1fr auto; padding: calc(var(--nav--height-total) + .5rem) var(--site--margin, 1.25rem) 1.5rem; background: #fff; color: #1f1d1e; transform: translateY(-100%); transition: transform .8s cubic-bezier(.76, 0, .24, 1); }
  .onav-sheet[hidden] { display: none; }
  .onav-sheet.is-open { transform: none; }
  .onav-mid { position: relative; display: flex; align-items: center; min-height: 0; }
  .onav-sheet ul { list-style: none; margin: 0; padding: 0; }
  /* the words rise from behind their own edge, like the section titles (no fading) */
  .onav-sheet .w { display: block; overflow: hidden; padding: 0 .2em .14em .08em; margin: 0 -.2em -.14em -.08em; } /* room for the slanted letters */
  .onav-sheet .wi { display: block; transform: translateY(120%); }
  .onav-sheet.is-closing .wi { transform: none; } /* closing: the words stay put while the curtain goes up */
  .onav-sheet.is-open .wi { transform: none; transition: transform 1s cubic-bezier(.16, 1, .3, 1) calc(.5s + .07s * var(--i)); }
  .onav-sheet li a { display: flex; align-items: center; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 3.75rem; line-height: 1.02; letter-spacing: -.03em; white-space: nowrap; color: inherit; text-decoration: none; transition: color .35s, opacity .35s; }
  .onav-icw { display: inline-block; width: 0; margin-right: 0; opacity: 0; transform: scale(.4) rotate(-25deg); transition: width .45s cubic-bezier(.65, 0, .35, 1), margin .45s cubic-bezier(.65, 0, .35, 1), opacity .25s, transform .55s cubic-bezier(.3, 1.6, .5, 1); }
  .onav-ic { display: block; width: 100%; height: auto; filter: drop-shadow(0 .06em .1em rgb(0 0 0 / 22%)); }
  /* active = hovered, or (nothing hovered) the current page, or (no current page) the first link */
  .onav-sheet li a:is(:hover, :focus-visible), .onav-sheet ul:not(:hover) a.on, .onav-sheet ul:not(:hover):not(:has(a.on)) li:first-child a { color: #401f28; }
  .onav-sheet li a:is(:hover, :focus-visible) .onav-icw, .onav-sheet ul:not(:hover) a.on .onav-icw, .onav-sheet ul:not(:hover):not(:has(a.on)) li:first-child .onav-icw { width: .66em; margin-right: .19em; opacity: 1; transform: none; }
  .onav-sheet ul:hover a:not(:hover) { opacity: .3; }
  .onav-blurb { display: none; }
  .onav-num { position: absolute; right: -.04em; bottom: -.06em; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 8.75rem; line-height: .8; letter-spacing: -.04em; color: #401f28; opacity: .2; pointer-events: none; }
  .onav-num::after { content: "01"; }
  .onav-sheet:has(ul:not(:hover) li:nth-child(2) a.on) .onav-num::after { content: "02"; }
  .onav-sheet:has(ul:not(:hover) li:nth-child(3) a.on) .onav-num::after { content: "03"; }
  .onav-sheet:has(li:nth-child(1) a:is(:hover, :focus-visible)) .onav-num::after { content: "01"; }
  .onav-sheet:has(li:nth-child(2) a:is(:hover, :focus-visible)) .onav-num::after { content: "02"; }
  .onav-sheet:has(li:nth-child(3) a:is(:hover, :focus-visible)) .onav-num::after { content: "03"; }
  .onav-sheet:has(ul:not(:hover) li:nth-child(4) a.on) .onav-num::after { content: "04"; }
  .onav-sheet:has(li:nth-child(4) a:is(:hover, :focus-visible)) .onav-num::after { content: "04"; }
  .onav-foot { display: grid; grid-template-columns: 1fr auto; row-gap: .625rem; align-items: center; font-size: .625rem; letter-spacing: .08em; text-transform: uppercase; }
  .onav-soc { grid-column: 1 / -1; order: -1; display: flex; gap: 1.25rem; }
  .onav-cr { justify-self: end; display: flex; align-items: center; gap: .625rem; }
  .onav-dot { width: .5rem; height: .5rem; border-radius: 50%; background: #401f28; }
  @media (min-width: 992px) {
    .onav-sheet { padding: var(--nav--height-total) var(--site--margin, 2.5rem) 1.625rem; }
    .onav-sheet li a { font-size: min(9.375rem, 10.4vw, 16.5vh); }
    .onav-blurb { display: block; position: absolute; right: 0; top: 1.25rem; max-width: 15.5rem; margin: 0; font-size: .6875rem; line-height: 1.45; letter-spacing: .06em; text-transform: uppercase; }
    .onav-num { font-size: min(20rem, 34vh); }
    .onav-foot { grid-template-columns: 1fr auto 1fr; font-size: .6875rem; }
    .onav-soc { grid-column: auto; order: 0; gap: 1.75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .onav-sheet, .onav-sheet .wi, .onav-icw { transition: none; } }
  html.onav-open .onav { --fg: #1f1d1e; }
  html.onav-open .onav-menu .o { display: none; }
  html.onav-open .onav-menu .c { display: inline; }
  html.onav-open, html.onav-open body { overflow: hidden; }
  @media (max-width: 991px) {
    .onav-links, .onav-right > .onav-cta { display: none; }
    /* phones: "Menu" / "Fermer ×" is the same glass pill as on desktop */
    .onav-menu { display: inline-flex; align-items: center; height: 2.625rem; padding: 0 1.25rem; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--fg) 45%, transparent); background: color-mix(in srgb, var(--fg) 12%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: background-color .35s, border-color .35s, color .35s; }
    .onav-logo img { height: 1.375rem; }
  }
  /* desktop, after scrolling (like oharchitecture.com.au): the links in the middle slide away and a glass "Menu" button slides in next to
     "Réserve ta place"; scroll back up and it reverses. "Menu" opens the same full-screen menu as on phones. */
  @media (min-width: 992px) {
    .onav-links { transition: opacity .45s ease, transform .7s cubic-bezier(.16, 1, .3, 1); }
    .onav.is-compact .onav-links, html.onav-open .onav-links { opacity: 0; transform: translate(-50%, -1rem); pointer-events: none; }
    .onav-menu { display: inline-flex; align-items: center; height: 2.625rem; max-width: 0; margin-left: -1rem; padding: 0; overflow: hidden; white-space: nowrap; border: 1px solid transparent; border-radius: 9999px; opacity: 0; pointer-events: none; transform: translateY(-.5rem); transition: max-width .7s cubic-bezier(.16, 1, .3, 1), margin .7s cubic-bezier(.16, 1, .3, 1), padding .7s cubic-bezier(.16, 1, .3, 1), opacity .45s ease, transform .7s cubic-bezier(.16, 1, .3, 1), background-color .35s, border-color .35s, color .35s; }
    .onav.is-compact .onav-menu, html.onav-open .onav-menu { max-width: 8rem; margin-left: 0; padding: 0 1.25rem; opacity: 1; pointer-events: auto; transform: none; border-color: color-mix(in srgb, var(--fg) 45%, transparent); background: color-mix(in srgb, var(--fg) 12%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
    .onav.is-compact .onav-menu:hover { background: #401f28; border-color: #401f28; color: #fff; }
  }
  /* on load the bar comes in: logo first, then the links' letters rise one link after another, then the button / Menu */
  @keyframes onav-in { from { opacity: 0; transform: translateY(-.75rem); } }
  @keyframes onav-ch { from { transform: translateY(115%); } }
  .onav-logo { animation: onav-in .9s cubic-bezier(.16, 1, .3, 1) .1s backwards; }
  .onav-links .ch { animation: onav-ch .9s cubic-bezier(.16, 1, .3, 1) backwards; animation-delay: calc(.25s + var(--li, 0) * .07s + var(--d) * .012s); }
  .onav-right > * { animation: onav-in .9s cubic-bezier(.16, 1, .3, 1) .5s backwards; }
  @media (prefers-reduced-motion: reduce) { .onav-logo, .onav-links .ch, .onav-right > * { animation: none; } }
</style>

<script is:inline>
// clicking Concept, Communauté or Figures in the navbar (or the menu): the clicked word glides and grows into the
// page title, like the "Découvrir" links on the homepage (the homepage's own handler steps aside when this is set)
(() => {
  const VT = { "/concept": "concept-title", "/communaute": "communaute-title", "/figures": "figures-title" };
  const key = (u) => { try { return new URL(u, location.href).pathname.replace(/\.html$/, "").replace(/\/$/, ""); } catch { return ""; } };
  document.addEventListener("click", (e) => {
    const a = e.target.closest && e.target.closest(".onav-links a, .onav-sheet a");
    window.__odeNavVT = a && VT[key(a.href)] && !a.classList.contains("on") ? a.querySelector(".rl, .w") : null;
  }, true);
  addEventListener("pageswap", (e) => {
    if (!e.viewTransition || !e.activation || !e.activation.entry) return;
    const to = key(e.activation.entry.url);
    // leaving for another page (not the homepage, where the title glides back into its section): this page's own big
    // title leaves with the rest of the page instead of lingering on top of the new one
    if (to && to !== key(location.href)) document.querySelectorAll(".vt-title").forEach((t) => { t.style.viewTransitionName = "none"; });
    const el = window.__odeNavVT;
    if (el && VT[to]) { el.style.viewTransitionName = VT[to]; try { sessionStorage.setItem("odeNavVT", "1"); } catch {} }
  });
  addEventListener("pageshow", () => {
    if (window.__odeNavVT) window.__odeNavVT.style.viewTransitionName = ""; window.__odeNavVT = null;
    document.querySelectorAll(".vt-title").forEach((t) => { t.style.viewTransitionName = ""; });
  });
})();
(() => {
  const bar = document.querySelector("[data-onav]");
  const sheet = document.getElementById("onav-sheet");
  const btn = bar.querySelector(".onav-menu");
  // text colour follows what is under the bar: white over dark sections/photos, dark over light ones
  const base = bar.dataset.base;
  const lum = (c) => { const m = c.match(/[\d.]+/g); if (!m) return null; const [r, g, b, a = 1] = m.map(Number); return a < .5 ? null : (0.299 * r + 0.587 * g + 0.114 * b) / 255; };
  const tone = () => {
    bar.classList.toggle("is-compact", scrollY > 500);
    if (document.documentElement.classList.contains("onav-open")) return;
    let light = base === "light";
    if (document.body.classList.contains("cv-dark")) light = true;
    else if (scrollY > 24) {
      const y = bar.offsetHeight / 2;
      bar.style.pointerEvents = "none";
      const el = document.elementFromPoint(innerWidth / 2, y) || document.body;
      bar.style.pointerEvents = "";
      let n = el.closest("section, footer, .u-section") || el, v = null;
      for (let e = n; e && v === null; e = e.parentElement) {
        if (e.classList && e.classList.contains("u-theme-dark")) v = 0;
        else v = lum(getComputedStyle(e).backgroundColor);
      }
      light = v !== null ? v < .5 : base === "light";
    }
    bar.classList.toggle("is-light", light);
    bar.classList.toggle("is-dark", !light);
  };
  let raf = 0;
  addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; tone(); }); }, { passive: true });
  new MutationObserver(tone).observe(document.body, { attributes: true, attributeFilter: ["class"] });
  tone();
  // mobile menu
  const set = (open) => {
    btn.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("onav-open", open);
    tone();
    if (window.lenis) open ? lenis.stop() : lenis.start();
    if (open) { sheet.classList.remove("is-closing"); sheet.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add("is-open"))); }
    else { sheet.classList.add("is-closing"); sheet.classList.remove("is-open"); setTimeout(() => { if (!sheet.classList.contains("is-open")) { sheet.hidden = true; sheet.classList.remove("is-closing"); } }, 850); tone(); }
  };
  btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
  sheet.addEventListener("click", (e) => { if (e.target.closest("a, [data-modal-trigger]")) set(false); });
  addEventListener("keydown", (e) => { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { set(false); btn.focus(); } });
})();
</script>
