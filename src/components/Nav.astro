---
// Site navbar: logo left, page links centred in small capitals, a glass "Réserve ta place" pill on the right
// (turns burgundy with the chrome heart on hover, opens the waitlist). On mobile: logo + "Menu", which opens a
// full-screen dark menu over the blurred page with big Freight links and the glass waitlist button.
// Text is white over dark heroes and dark over light pages; once you scroll, the bar gets a frosted white backing.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/$/, "") || "/";
const lightText = path === "/" || path === "/menu";
const links = [
  { label: "Concept", href: "/concept", on: path === "/concept", icon: "/images/ode-icon-sparkle-s.webp" },
  { label: "Cours", href: "/#cours", on: false, icon: "/images/ode-heart-s.webp" },
  { label: "Figures", href: "/figures", on: path === "/figures" || path.startsWith("/figures/"), icon: "/images/ode-icon-book-s.webp" },
  { label: "Formules", href: "/#formules", on: false, icon: "/images/Glanzende-chromen-envelop-met-hartzegel-p-300.webp" },
];
const HEART = "/images/ode-heart-s.webp";
---
<a href="#main" class="onav-skip">Aller au contenu</a>
<header class:list={["onav", lightText ? "is-light" : "is-dark"]} data-onav data-base={lightText ? "light" : "dark"}>
  <a class="onav-logo" href="/" aria-label="Studio Ode, accueil" aria-current={path === "/" ? "page" : undefined}>
    <img src="/images/ode-logo-300.webp" srcset="/images/ode-logo-150.webp 150w, /images/ode-logo-300.webp 300w" sizes="(max-width: 991px) 5.25rem, 6.25rem" alt="Studio Ode" width="300" height="80" fetchpriority="high" />
  </a>
  <nav class="onav-links" aria-label="Navigation principale">
    {links.map((l, li) => (
      <a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? "page" : undefined} aria-label={l.label} style={`--li:${li}`}>
        <span class="rl" aria-hidden="true">{[...l.label].map((ch, i) => <span class="ch" style={`--d:${i}`} data-c={ch}>{ch}</span>)}</span>
      </a>
    ))}
  </nav>
  <div class="onav-right">
    <button type="button" class="onav-cta" data-modal-trigger="waitlist">Réserve ta place<img class="onav-heart" src={HEART} alt="" aria-hidden="true" /></button>
    <button type="button" class="onav-menu" aria-expanded="false" aria-controls="onav-sheet"><span class="o">Menu</span><span class="c">Fermer ×</span></button>
  </div>
</header>
<div class="onav-sheet" id="onav-sheet" hidden>
  <p class="onav-st"><img src="/images/ode-icon-sparkle-s.webp" alt="" aria-hidden="true" loading="lazy" /><span>Ouverture en 2027<br />100 places fondatrices</span></p>
  <ul>
    {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href} class:list={{ on: l.on }} aria-current={l.on ? "page" : undefined}><img class="onav-ic" src={l.icon} alt="" aria-hidden="true" loading="lazy" /><span class="w">{l.label}</span></a></li>)}
  </ul>
  <div class="onav-foot">
    <div class="onav-inf">
      <p class="h">Infos</p>
      <dl><div><dt>Studio</dt><dd>Lille</dd></div><div><dt>Ouverture</dt><dd>2027</dd></div><div><dt>Instagram</dt><dd>@ode.studio</dd></div><div><dt>Fondatrices</dt><dd><button type="button" class="onav-join" data-modal-trigger="waitlist">Réserve ta place →</button></dd></div></dl>
    </div>
    <p class="onav-tag">Pole dance, force &amp; expression. Depuis Lille, avec amour.</p>
  </div>
</div>

<style is:global>
  :root { --nav--height-total: calc(2.75rem + var(--site--margin, 2.5rem)); }
  .onav-skip { position: fixed; left: .75rem; top: .75rem; z-index: 1001; padding: .5rem .875rem; border-radius: 9999px; background: #fff; color: #1f1d1e; transform: translateY(-200%); transition: transform .2s; }
  .onav-skip:focus { transform: none; }
  .onav { --fg: #fff; position: fixed; z-index: 1000; left: 0; right: 0; top: 0; height: var(--nav--height-total); display: flex; align-items: center; justify-content: space-between; padding: 0 var(--site--margin, 2.5rem); color: var(--fg); transition: color .35s; font-family: var(--_typography---font--primary-family), sans-serif; }
  .onav.is-dark { --fg: #1f1d1e; }
  .onav-logo img { display: block; height: 1.625rem; width: auto; filter: brightness(0) opacity(.88); transition: filter .35s; }
  .onav.is-light .onav-logo img { filter: brightness(0) invert(1); }
  .onav-links { position: absolute; left: 50%; transform: translateX(-50%); display: flex; gap: 2.25rem; }
  /* hover: the letters roll up one after another (a copy rises from below); the current page stays at full strength */
  .onav-links a { position: relative; display: block; font-size: .875rem; line-height: 1; letter-spacing: .01em; color: inherit; text-decoration: none; }
  .onav-links .rl { display: flex; overflow: hidden; padding: .125rem 0; }
  .onav-links .ch { position: relative; display: block; white-space: pre; transition: transform .5s cubic-bezier(.7, 0, .2, 1) calc(var(--d) * .025s); }
  .onav-links .ch::after { content: attr(data-c); position: absolute; left: 0; top: 100%; padding-top: .125rem; }
  .onav-links a:hover .ch, .onav-links a:focus-visible .ch { transform: translateY(calc(-100% - .125rem)); }
  .onav-links a { opacity: .7; transition: opacity .3s; }
  .onav-links a:hover, .onav-links a:focus-visible, .onav-links a.on { opacity: 1; }
  .onav-right { display: flex; align-items: center; gap: 1rem; }
  .onav-cta { position: relative; display: inline-flex; align-items: center; justify-content: center; height: 2.375rem; padding: 0 1.125rem; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--fg) 45%, transparent); background: color-mix(in srgb, var(--fg) 12%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); color: inherit; font: inherit; font-size: .875rem; letter-spacing: .01em; white-space: nowrap; cursor: pointer; transition: background-color .35s, border-color .35s, color .35s; }
  .onav-cta:hover, .onav-cta:focus-visible { background: #401f28; border-color: #401f28; color: #fff; }
  .onav-cta:focus-visible, .onav-menu:focus-visible, .onav-links a:focus-visible, .onav-sheet a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .onav-heart { position: absolute; right: -.5rem; top: -.875rem; width: 1.875rem; height: auto; pointer-events: none; opacity: 0; transform: translateY(.75rem) rotate(-30deg) scale(.3); transition: transform .55s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; filter: drop-shadow(0 4px 6px rgb(0 0 0 / 30%)); }
  .onav-cta:hover .onav-heart, .onav-cta:focus-visible .onav-heart { opacity: 1; transform: translateY(-.25rem) rotate(12deg) scale(1); }
  .onav-menu { display: none; padding: .5rem 0; border: 0; background: none; color: inherit; font: inherit; font-size: .875rem; letter-spacing: .01em; cursor: pointer; }
  .onav-menu .c { display: none; }

  /* full-screen menu (R4): pearl-grey sheet, big right-aligned links (in Freight Big Pro, like the section titles), INFOS block + line at the bottom. The chrome icon of each link pops in before it. */
  .onav-sheet { position: fixed; z-index: 999; inset: 0; display: grid; grid-template-rows: 1fr auto; padding: calc(var(--nav--height-total) + 1rem) var(--site--margin, 1.25rem) 1.75rem; background: #efeded; color: #1f1d1e; opacity: 0; transition: opacity .35s; }
  .onav-sheet[hidden] { display: none; }
  .onav-sheet.is-open { opacity: 1; }
  .onav-st { display: none; }
  .onav-sheet ul { list-style: none; margin: 0; padding: 0; align-self: center; justify-self: end; text-align: right; }
  .onav-sheet li { opacity: 0; transform: translateY(1rem); transition: opacity .45s ease calc(.06s * var(--i) + .1s), transform .55s cubic-bezier(.2, .8, .2, 1) calc(.06s * var(--i) + .1s); }
  .onav-sheet.is-open li { opacity: 1; transform: none; }
  .onav-sheet li a { display: flex; align-items: center; justify-content: flex-end; gap: .2em; padding: .05em 0; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 3.75rem; line-height: 1.12; letter-spacing: var(--_typography---letter-spacing--tight, -.03em); color: inherit; text-decoration: none; transition: opacity .35s; }
  .onav-sheet .w { display: block; transition: transform .5s cubic-bezier(.2, .8, .2, 1); }
  .onav-foot { display: grid; gap: 1.75rem; }
  .onav-inf .h { margin: 0 0 .875rem; font-size: .875rem; font-weight: 500; letter-spacing: .02em; text-transform: uppercase; }
  .onav-inf dl { margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem; }
  .onav-inf dt { font-size: .8125rem; opacity: .5; margin-bottom: .25rem; }
  .onav-inf dd { margin: 0; font-size: .9375rem; }
  .onav-join { padding: 0; border: 0; border-bottom: 1px solid currentColor; background: none; font: inherit; color: #401f28; cursor: pointer; }
  .onav-tag { margin: 0; font-size: .75rem; opacity: .5; text-align: center; }
  html.onav-open .onav { --fg: #1f1d1e; }
  html.onav-open .onav-logo img { filter: brightness(0) opacity(.88); }
  html.onav-open .onav-menu .o { display: none; }
  html.onav-open .onav-menu .c { display: inline; }
  html.onav-open, html.onav-open body { overflow: hidden; }
  @media (max-width: 991px) {
    .onav-links, .onav-right > .onav-cta { display: none; }
    /* phones: "Menu" / "Fermer ×" is the same glass pill as on desktop */
    .onav-menu { display: inline-flex; align-items: center; height: 2.375rem; padding: 0 1.125rem; border-radius: 9999px; border: 1px solid color-mix(in srgb, var(--fg) 45%, transparent); background: color-mix(in srgb, var(--fg) 12%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: background-color .35s, border-color .35s, color .35s; }
    .onav-logo img { height: 1.375rem; }
  }
  /* desktop, after scrolling (like oharchitecture.com.au): the links in the middle slide away and a glass "Menu" button slides in next to
     "Réserve ta place"; scroll back up and it reverses. "Menu" opens the same full-screen menu as on phones. */
  @media (min-width: 992px) {
    .onav-links { transition: opacity .45s ease, transform .7s cubic-bezier(.16, 1, .3, 1); }
    .onav.is-compact .onav-links, html.onav-open .onav-links { opacity: 0; transform: translate(-50%, -1rem); pointer-events: none; }
    .onav-menu { display: inline-flex; align-items: center; height: 2.375rem; max-width: 0; margin-left: -1rem; padding: 0; overflow: hidden; white-space: nowrap; border: 1px solid transparent; border-radius: 9999px; opacity: 0; pointer-events: none; transform: translateY(-.5rem); transition: max-width .7s cubic-bezier(.16, 1, .3, 1), margin .7s cubic-bezier(.16, 1, .3, 1), padding .7s cubic-bezier(.16, 1, .3, 1), opacity .45s ease, transform .7s cubic-bezier(.16, 1, .3, 1), background-color .35s, border-color .35s, color .35s; }
    .onav.is-compact .onav-menu, html.onav-open .onav-menu { max-width: 8rem; margin-left: 0; padding: 0 1.125rem; opacity: 1; pointer-events: auto; transform: none; border-color: color-mix(in srgb, var(--fg) 45%, transparent); background: color-mix(in srgb, var(--fg) 12%, transparent); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
    .onav.is-compact .onav-menu:hover { background: #401f28; border-color: #401f28; color: #fff; }
    /* the full-screen menu, roomier on large screens */
    .onav-sheet { grid-template-rows: auto 1fr auto; padding: 0 var(--site--margin, 2.5rem) 2.25rem; }
    .onav-st { display: flex; align-items: center; gap: .75rem; justify-self: center; height: var(--nav--height-total); margin: 0; font-size: .875rem; line-height: 1.3; opacity: .55; }
    .onav-st img { width: 1.75rem; height: auto; filter: drop-shadow(0 3px 6px rgb(0 0 0 / 25%)); }
    .onav-sheet li a { font-size: min(8.25rem, 9.2vw, 14.5vh); line-height: 1.08; }
    /* hover: the other links fade, this one slides left a little and its Freight letter tilts */
    .onav-sheet ul:hover a { opacity: .35; }
    .onav-sheet ul a:hover, .onav-sheet ul a:focus-visible { opacity: 1; }
    .onav-sheet li a:hover .w, .onav-sheet li a:focus-visible .w { transform: translateX(-.1em); }
    .onav-foot { grid-template-columns: 1fr auto; align-items: end; }
    .onav-inf { display: grid; grid-template-columns: 8.75rem 1fr; }
    .onav-inf dl { grid-template-columns: repeat(4, auto); justify-content: start; gap: .75rem 2.5rem; }
    .onav-tag { font-size: .875rem; }
  }
  @media (prefers-reduced-motion: reduce) { .onav-sheet, .onav-sheet li, .onav-heart { transition: none; } }
  /* menu A: each link carries its chrome icon (as on the section titles). Desktop: the icon pops in on hover (and stays on the
     current page). Phones (no hover): the icons pop in one after another when the menu opens. */
  .onav-ic { width: .45em; height: auto; flex: none; filter: drop-shadow(0 .08em .14em rgb(0 0 0 / 35%)); opacity: 0; transform: translateY(.3em) rotate(-30deg) scale(.3); transition: transform .55s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; }
  .onav-sheet li a:hover .onav-ic, .onav-sheet li a:focus-visible .onav-ic, .onav-sheet li a.on .onav-ic { opacity: 1; transform: rotate(10deg); }
  @media (hover: none) {
    .onav-sheet .onav-ic { transition-delay: calc(.35s + .07s * var(--i, 0)); }
    .onav-sheet.is-open .onav-ic { opacity: 1; transform: rotate(10deg); }
    .onav-sheet li { --i: inherit; }
  }
  @media (prefers-reduced-motion: reduce) { .onav-ic { transition: none; } }
  /* on load the bar comes in: logo first, then the links' letters rise one link after another, then the button / Menu */
  @keyframes onav-in { from { opacity: 0; transform: translateY(-.75rem); } }
  @keyframes onav-ch { from { transform: translateY(115%); } }
  .onav-logo { animation: onav-in .9s cubic-bezier(.16, 1, .3, 1) .1s backwards; }
  .onav-links .ch { animation: onav-ch .9s cubic-bezier(.16, 1, .3, 1) backwards; animation-delay: calc(.25s + var(--li, 0) * .07s + var(--d) * .012s); }
  .onav-right > * { animation: onav-in .9s cubic-bezier(.16, 1, .3, 1) .5s backwards; }
  @media (prefers-reduced-motion: reduce) { .onav-logo, .onav-links .ch, .onav-right > * { animation: none; } }
</style>

<script is:inline>
(() => {
  const bar = document.querySelector("[data-onav]");
  const sheet = document.getElementById("onav-sheet");
  const btn = bar.querySelector(".onav-menu");
  // text colour follows what is under the bar: white over dark sections/photos, dark over light ones
  const base = bar.dataset.base;
  const lum = (c) => { const m = c.match(/[\d.]+/g); if (!m) return null; const [r, g, b, a = 1] = m.map(Number); return a < .5 ? null : (0.299 * r + 0.587 * g + 0.114 * b) / 255; };
  const tone = () => {
    bar.classList.toggle("is-compact", scrollY > 500);
    if (document.documentElement.classList.contains("onav-open")) return;
    let light = base === "light";
    if (document.body.classList.contains("cv-dark")) light = true;
    else if (scrollY > 24) {
      const y = bar.offsetHeight / 2;
      bar.style.pointerEvents = "none";
      const el = document.elementFromPoint(innerWidth / 2, y) || document.body;
      bar.style.pointerEvents = "";
      let n = el.closest("section, footer, .u-section") || el, v = null;
      for (let e = n; e && v === null; e = e.parentElement) {
        if (e.classList && e.classList.contains("u-theme-dark")) v = 0;
        else v = lum(getComputedStyle(e).backgroundColor);
      }
      light = v !== null ? v < .5 : base === "light";
    }
    bar.classList.toggle("is-light", light);
    bar.classList.toggle("is-dark", !light);
  };
  let raf = 0;
  addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; tone(); }); }, { passive: true });
  new MutationObserver(tone).observe(document.body, { attributes: true, attributeFilter: ["class"] });
  tone();
  // mobile menu
  const set = (open) => {
    btn.setAttribute("aria-expanded", String(open));
    document.documentElement.classList.toggle("onav-open", open);
    tone();
    if (window.lenis) open ? lenis.stop() : lenis.start();
    if (open) { sheet.hidden = false; requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add("is-open"))); }
    else { sheet.classList.remove("is-open"); setTimeout(() => { if (!sheet.classList.contains("is-open")) sheet.hidden = true; }, 350); tone(); }
  };
  btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
  sheet.addEventListener("click", (e) => { if (e.target.closest("a, [data-modal-trigger]")) set(false); });
  addEventListener("keydown", (e) => { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { set(false); btn.focus(); } });
})();
</script>
