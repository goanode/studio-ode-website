---
import { WEB3FORMS_ACCESS_KEY } from "../config";
// Waitlist window (design D2): a centred split window over the blurred page. Left: a still of the fluted-glass photo
// with a round close button. Right: burgundy panel with the Freight title, one line of perks,
// first name + e-mail in translucent pills, a white button and the consent line. On phones the photo is a strip on top.
---
<dialog data-wf--modal--variant="split" data-modal-target="waitlist" class="wl" aria-label="Réserve ta place parmi les fondatrices">
  <div class="wl-bd" data-modal-close=""></div>
  <div class="wl-pan" data-lenis-prevent="">
    <div class="wl-ph">
      <img src="/images/ode-invitation-cercle-2x.webp" srcset="/images/ode-invitation-cercle.webp 620w, /images/ode-invitation-cercle-2x.webp 1086w" sizes="(max-width: 767px) 100vw, 29rem" alt="" aria-hidden="true" loading="lazy" width="1086" height="1448" />
      <button type="button" class="wl-x" data-modal-close="" aria-label="Fermer">×</button>
    </div>
    <div class="wl-body">
      <h2 class="wl-h">Réserve ta place</h2>
      <p class="wl-lead" tabindex="-1" autofocus>Les 50 premières inscrites deviennent fondatrices&nbsp;: premier cours offert, -15&nbsp;% sur ta formule et place réservée à l’ouverture.</p>
      <div class="w-form">
        <form id="waitlist-form" name="waitlist" method="POST" action="https://api.web3forms.com/submit" data-waitlist-form="" class="wl-form">
          <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY}>
          <input type="hidden" name="subject" value="Nouvelle fondatrice — Ode">
          <input type="hidden" name="from_name" value="Ode website">
          <input type="hidden" name="formule" value="" data-wl-plan>
          <input type="checkbox" name="botcheck" class="u-display-none" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label class="wl-f"><span class="u-sr-only">Prénom</span><input name="name" type="text" required autocomplete="given-name" placeholder="Prénom" /></label>
          <label class="wl-f"><span class="u-sr-only">E-mail</span><input name="email" type="email" required inputmode="email" autocomplete="email" placeholder="E-mail" /></label>
          <button type="submit" class="wl-btn">Réserver ma place<img src="/images/ode-heart-s.webp" alt="" aria-hidden="true" loading="lazy" /></button>
          <p class="wl-fine">En t’inscrivant, tu acceptes de recevoir les nouvelles d’Ode (ouverture, avantages fondatrices). Désinscription en un clic.</p>
        </form>
        <div class="w-form-done wl-msg"><p class="wl-lead">Bienvenue parmi les fondatrices&nbsp;! Ta place est réservée. On te prévient dès l’ouverture du studio.</p></div>
        <div class="w-form-fail wl-err">Oups, un problème est survenu. Réessaie dans un instant.</div>
      </div>
    </div>
  </div>
  <div class="u-embed-js w-embed w-script">
    <script is:inline>
(function() {
const component = document.currentScript.parentElement.parentElement;
document.addEventListener("DOMContentLoaded", function () {
const modalSystem = ((window.lumos ??= {}).modal ??= {
  list: {}, open(id) { this.list[id]?.open?.(); }, closeAll() { Object.values(this.list).forEach((m) => m.close?.()); },
});
const modalId = component.getAttribute("data-modal-target");
const variant = component.getAttribute("data-wf--modal--variant");
let lastFocusedElement;
if (typeof gsap !== "undefined") {
  gsap.context(() => {
    let tl = gsap.timeline({ paused: true, onReverseComplete: resetModal });
    if (variant === "split") {
      // window fades and rises a little over the blurred page
      tl.fromTo(".wl-bd", { opacity: 0 }, { opacity: 1, duration: 0.35, ease: "power1.out" });
      tl.from(".wl-pan", { opacity: 0, y: "2.5rem", scale: 0.97, duration: 0.5, ease: "power3.out" }, "<0.05");
    } else if (variant === "full-screen") {
      tl.set(".modal_backdrop", { opacity: 0 });
      tl.from(".modal_content", { opacity: 0, duration: 0.2, ease: "power1.out" });
      tl.from(".modal_slot", { opacity: 0, y: "2rem", duration: 0.2, ease: "power1.out" }, "<0.1");
    } else {
      tl.fromTo(".modal_backdrop", { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power1.out" });
      tl.from(".modal_content", { opacity: 0, y: "6rem", duration: 0.3, ease: "power1.out" }, "<");
    }
    component.tl = tl;
  }, component);
}
function resetModal() {
  typeof lenis !== "undefined" && lenis.start ? lenis.start() : (document.body.style.overflow = "");
  component.close();
  if (lastFocusedElement) lastFocusedElement.focus();
  window.dispatchEvent(new CustomEvent("modal-close", { detail: { modal: component } }));
}
function openModal() {
  typeof lenis !== "undefined" && lenis.stop ? lenis.stop() : (document.body.style.overflow = "hidden");
  lastFocusedElement = document.activeElement;
  component.showModal();
  if (typeof gsap !== "undefined") component.tl.play();
  component.querySelectorAll(".wl-pan, .wl-body").forEach((el) => (el.scrollTop = 0));
  window.dispatchEvent(new CustomEvent("modal-open", { detail: { modal: component } }));
}
function closeModal() {
  typeof gsap !== "undefined" ? component.tl.reverse() : resetModal();
}
if (new URLSearchParams(location.search).get("modal-id") === modalId) openModal(), history.replaceState({}, "", ((u) => (u.searchParams.delete("modal-id"), u))(new URL(location.href)));
component.addEventListener("cancel", (e) => (e.preventDefault(), closeModal()));
component.addEventListener("click", (e) => e.target.closest("[data-modal-close]") && closeModal());
document.addEventListener("click", (e) => {
  const trigger = e.target.closest(`[data-modal-trigger='${modalId}'], a[href='#${modalId}']`);
  if (!trigger) return;
  if (trigger.tagName === "A") e.preventDefault();
  openModal();
});
modalSystem.list[modalId] = { open: openModal, close: closeModal };
});
})();
</script>
  </div>
</dialog>
<script is:inline>
  // which formule (and duration) opened the window: sent with the sign-up, e.g. "Signature (Annuel)"; empty from any other button
  document.addEventListener("click", (e) => {
    const t = e.target.closest && e.target.closest('[data-modal-trigger="waitlist"]');
    const f = document.querySelector("[data-wl-plan]");
    if (!t || !f) return;
    const on = document.querySelector(".compare_toggle_option.is-active");
    f.value = t.dataset.plan ? `${t.dataset.plan}${on ? ` (${on.textContent.trim()})` : ""}` : "";
  }, true);
</script>

<style is:global>
  /* Waitlist window D2: centred split window, fluted photo left, burgundy form right. */
  dialog.wl { position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; overflow: hidden; color: #fff; }
  dialog.wl:not([open]) { display: none; }
  dialog.wl[open] { display: grid; place-items: center; }
  dialog.wl::backdrop { background: transparent; }
  .wl-bd { position: absolute; inset: 0; background: rgb(20 18 19 / 50%); -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); }
  .wl-pan { position: relative; display: grid; grid-template-columns: 1fr 1fr; width: min(58rem, calc(100% - 3rem)); height: min(36.25rem, calc(100% - 3rem)); border-radius: 1.375rem; overflow: hidden; background: #401f28; box-shadow: 0 1.875rem 5rem rgb(0 0 0 / 35%); }
  .wl-ph { position: relative; min-height: 0; background: #9a9a9a; }
  .wl-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wl-x { position: absolute; left: 1rem; top: 1rem; display: grid; place-items: center; width: 2.25rem; height: 2.25rem; padding: 0 0 .125rem; border: 0; border-radius: 50%; background: rgb(0 0 0 / 22%); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); color: #fff; font: inherit; font-size: 1.375rem; line-height: 1; cursor: pointer; transition: background-color .3s; }
  .wl-x:hover { background: #401f28; }
  .wl-body { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 0; padding: 2.5rem 3.25rem; text-align: center; overflow-y: auto; overscroll-behavior: contain; }
  .wl-h { margin: 0 0 1.25rem; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 3.375rem; line-height: 1; letter-spacing: -.03em; color: #fff; }
  .wl-lead { margin: 0 auto 1.75rem; max-width: 21.25rem; font-size: .9375rem; line-height: 1.5; color: rgb(255 255 255 / 75%); }
  .wl-lead:focus { outline: none; }
  .wl-body > .w-form { width: 100%; }
  .wl-form { display: flex; flex-direction: column; gap: .75rem; }
  .wl-f { display: block; }
  .wl-f input { display: block; width: 100%; height: 3.125rem; padding: 0 1.25rem; border: 1px solid rgb(255 255 255 / 35%); border-radius: 9999px; background: rgb(255 255 255 / 8%); color: #fff; font: inherit; font-size: .9375rem; outline: none; transition: border-color .25s, background-color .25s; }
  .wl-f input::placeholder { color: rgb(255 255 255 / 60%); }
  .wl-f input:focus { border-color: #fff; background: rgb(255 255 255 / 14%); }
  .wl-f input:-webkit-autofill { -webkit-text-fill-color: #fff; -webkit-box-shadow: 0 0 0 40px #5a3540 inset; caret-color: #fff; }
  .wl-btn { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 3.125rem; margin-top: .375rem; border: 0; border-radius: 9999px; background: #fff; color: #401f28; font: inherit; font-size: .875rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: background-color .3s; }
  .wl-btn:hover { background: #efeded; }
  .wl-btn img { position: absolute; right: -.375rem; top: -.875rem; width: 1.875rem; height: auto; opacity: 0; transform: translateY(.75rem) rotate(-30deg) scale(.3); transition: transform .55s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; filter: drop-shadow(0 4px 6px rgb(0 0 0 / 30%)); pointer-events: none; }
  .wl-btn:hover img, .wl-btn:focus-visible img { opacity: 1; transform: translateY(-.25rem) rotate(12deg) scale(1); }
  .wl-btn:focus-visible, .wl-x:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .wl-fine { margin: .5rem auto 0; max-width: 20rem; font-size: .6875rem; line-height: 1.45; color: rgb(255 255 255 / 55%); }
  .wl-body.is-done .wl-h ~ .wl-lead { display: none; }
  .wl .wl-msg { padding: 0; background: none; color: #fff; }
  .wl .wl-msg .wl-lead { margin-bottom: 0; color: rgb(255 255 255 / 85%); }
  .wl .wl-err { margin-top: 1rem; padding: 0; background: none; font-size: .8125rem; color: #ffc9d2; }
  @media (max-width: 767px) {
    .wl-pan { grid-template-columns: 1fr; grid-template-rows: 34% 1fr; width: calc(100% - 1.5rem); height: calc(100% - 2.5rem); height: calc(100dvh - 2.5rem); border-radius: 1.125rem; }
    .wl-ph img { object-position: 50% 38%; } /* phones: the strip frames the card from ODE STUDIO to « Une invitation exclusive » */
    .wl-body { justify-content: flex-start; padding: 1.75rem 1.375rem 1.5rem; }
    .wl-body > :first-child { margin-top: auto; }
    .wl-body > :last-child { margin-bottom: auto; }
    .wl-h { font-size: 2.625rem; }
   
    .wl-lead { margin-bottom: 1.25rem; font-size: .875rem; }
  }
</style>


<script>
  // Waitlist form: sends each sign-up to your inbox via Web3Forms (https://web3forms.com).
  // Listening on the form itself stops webflow.js (which listens on document) from taking over.
  document.querySelectorAll<HTMLFormElement>("form[data-waitlist-form]").forEach((form) => {
    const wrap = form.closest(".w-form");
    const done = wrap?.querySelector<HTMLElement>(".w-form-done");
    const fail = wrap?.querySelector<HTMLElement>(".w-form-fail");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      event.stopPropagation();
      if (fail) fail.style.display = "none";
      const data = Object.fromEntries(new FormData(form));
      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.success) throw new Error(json.message || String(res.status));
        form.style.display = "none";
        form.closest(".wl-body")?.classList.add("is-done");
        if (done) done.style.display = "block";
      } catch (err) {
        console.error("Waitlist submission failed:", err);
        if (fail) fail.style.display = "block";
      }
    });
  });
</script>
