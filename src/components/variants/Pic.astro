---
// Responsive <img> that picks up the -p-500/-p-800/... variants Webflow generated in /public/images.
import fs from "node:fs";
import path from "node:path";
import sharp from "sharp";

interface Props {
  name: string;
  ext?: string;
  alt?: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  [key: string]: unknown;
}
const { name, ext = "webp", alt = "", sizes = "100vw", class: className, eager = false, ...rest } = Astro.props;

const dir = path.join(process.cwd(), "public/images");
const variants = fs
  .readdirSync(dir)
  .map((f) => f.match(new RegExp(`^${name.replace(/[.*+?^${}()|[\]\\-]/g, "\\$&")}-p-(\\d+)\\.${ext}$`)))
  .filter((m): m is RegExpMatchArray => !!m)
  .map((m) => ({ file: m[0], w: Number(m[1]) }))
  .sort((a, b) => a.w - b.w);

const full = `${name}.${ext}`;
const { width = 1200, height } = await sharp(path.join(dir, full)).metadata();
const srcset = [...variants.map((v) => `/images/${v.file} ${v.w}w`), `/images/${full} ${width}w`].join(", ");
---

<img
  src={`/images/${full}`}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  {...rest}
/>
