---
import "../styles/normalize.css";
import "../styles/webflow.css";
import "../styles/site.css";
import "../styles/lumos-global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Webflow page id — webflow.js uses it to attach this page's interactions. */
  wfPage: string;
  /** Load the "fluted glass" WebGL effect (three.js). */
  flutedGlass?: boolean;
}

const { title, description, wfPage, flutedGlass = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html data-wf-page={wfPage} data-wf-site="6a96e3c056f4431a13f9f154" lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Hide animated elements until Webflow interactions have started (prevents a flash) -->
    <style is:inline>html.w-mod-js:not(.w-mod-ix3):is([slide-down]) {visibility: hidden !important;}html.w-mod-js:not(.w-mod-ix3):is([slide-down]) * {visibility: hidden !important;}html.w-mod-js:not(.w-mod-ix3):is([random-stagger-in]) {visibility: hidden !important;}html.w-mod-js:not(.w-mod-ix3):is([random-stagger-in]) * {visibility: hidden !important;}html.w-mod-js:not(.w-mod-ix3):is([fade-in]) {visibility: hidden !important;}html.w-mod-js:not(.w-mod-ix3):is([fade-in]) * {visibility: hidden !important;}html.w-mod-js:not(.w-mod-ix3) :is([data-wf-component-id="29394d2f-cd0c-8059-7e15-66f93814999f"]:is(.footer_bottom_letter), [data-wf-component-id="29394d2f-cd0c-8059-7e15-66f93814999f"] :is(.footer_bottom_letter), [slide-down], [data-wf-component-id="b9130e59-aa4e-07ef-a822-eda529bf75ca"]:is([text-blur]), [data-wf-component-id="b9130e59-aa4e-07ef-a822-eda529bf75ca"] :is([text-blur]), [random-stagger-in], .heading, [fade-in]) {visibility: hidden !important;}</style>

    <!-- Fonts: Google Fonts + Adobe Fonts (Typekit kit xbu1shi, used for freight-big-pro) -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous" />
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js"></script>
    <script is:inline>WebFont.load({ google: { families: ["Oswald:200,300,400,500,600,700","Bodoni Moda:400,500,600,700","Cormorant Garamond:300,400","Instrument Sans:400","Newsreader:200,300,400,500","Old Standard TT:400","Poppins:400","Urbanist:300,400,500,600"] } });</script>
    <script is:inline src="https://use.typekit.net/xbu1shi.js"></script>
    <script is:inline>try{Typekit.load();}catch(e){}</script>

    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.jpg" rel="apple-touch-icon" />

    {
      flutedGlass && (
        <>
          {/* Fluted Glass by The Lazy God (self-hosted) */}
          <script is:inline type="importmap">{ "imports": { "three": "/vendor/three.module.min.js" } }</script>
          <script is:inline type="module" src="/vendor/tlg-fluted-glass.js"></script>
        </>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot name="body-start" />
    <div class="page_wrap">
      <Nav />
      <slot />
      <Footer />
      <slot name="after-footer" />
    </div>

    <!-- Interaction & animation libraries (self-hosted copies of what Webflow loaded from CDNs) -->
    <script is:inline src="/vendor/jquery-3.5.1.min.js"></script>
    <script is:inline src="/vendor/webflow.js"></script>
    <script is:inline src="/vendor/gsap.min.js"></script>
    <script is:inline src="/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/vendor/SplitText.min.js"></script>
    <script is:inline src="/vendor/lenis.min.js" defer></script>
    <script is:inline src="/vendor/ukiyo.min.js" defer></script>
    <script is:inline defer>
      document.addEventListener("DOMContentLoaded", () => {
        // Smooth scroll
        const lenis = new Lenis();
        window.lenis = lenis;
        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
        // Parallax images
        const images = document.querySelectorAll(".parallax");
        new Ukiyo(images, { scale: 1.5, speed: 1.5, willChange: true });
      });
    </script>
    <slot name="scripts" />
  </body>
</html>
