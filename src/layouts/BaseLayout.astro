---
import "../styles/normalize.css";
import "../styles/webflow.css";
import "../styles/site.css";
import "../styles/lumos-global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Webflow page id — webflow.js uses it to attach this page's interactions. */
  wfPage: string;
  /** Load the "fluted glass" WebGL effect (three.js). */
  flutedGlass?: boolean;
  /** opt in to the browser's page transition (figures catalogue <-> trick pages); value = id of an element that must be parsed before the page shows */
  viewTransition?: string;
  /** leave the footer out (the 404 page is one full-screen space) */
  footer?: boolean;
}

const { title, description, wfPage, flutedGlass = false, viewTransition, footer = true } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html data-wf-page={wfPage} data-wf-site="6a96e3c056f4431a13f9f154" lang="fr">
  <head>
    <meta charset="utf-8" />
    {viewTransition && (
      <>
        {/* page transition opt-in first thing in the head, so it is in place before the first render; and don't show the page until its main content is parsed */}
        <style is:inline>@media (prefers-reduced-motion: no-preference) { @view-transition { navigation: auto; } }</style>
        <link rel="expect" href={`#${viewTransition}`} blocking="render" />
        <script is:inline>
          // arriving from a navbar word: tell the transition, so the small word hands over to the big title right away (see the CSS)
          addEventListener("pagereveal", (e) => { let n = null; try { n = sessionStorage.getItem("odeNavVT"); sessionStorage.removeItem("odeNavVT"); } catch {} if (n && e.viewTransition && e.viewTransition.types) e.viewTransition.types.add("from-nav"); });
        </script>
      </>
    )}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Hide animated elements until the site's animations have set their starting state (prevents a flash) -->
    <style is:inline>html.w-mod-js:not(.w-mod-ix3) :is([random-stagger-in], .footer_bottom_letter) {visibility: hidden !important;}</style>

    <!-- Fonts: only what the site uses — Instrument Sans (Google Fonts) and freight-big-pro (Adobe Fonts kit xbu1shi) -->
    <!-- Instrument Sans is served from the site itself (no trip to Google); freight-big-pro comes from the Adobe Fonts kit as a stylesheet, not a blocking script -->
    <link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/instrument-sans-latin-ext-400-normal.woff2) format("woff2"); unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF; }
      @font-face { font-family: "Instrument Sans"; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/instrument-sans-latin-400-normal.woff2) format("woff2"); unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD; }
    </style>
    <link href="https://use.typekit.net" rel="preconnect" crossorigin="anonymous" />
    <link href="https://p.typekit.net" rel="preconnect" crossorigin="anonymous" />
    <link href="https://use.typekit.net/xbu1shi.css" rel="stylesheet" />

    <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.jpg" rel="apple-touch-icon" />

    {
      flutedGlass && (
        <>
          {/* Fluted Glass by The Lazy God (self-hosted) */}
          <script is:inline type="importmap">{ "imports": { "three": "/vendor/three.module.min.js" } }</script>
          {/* desktop only, loaded once the page has appeared (phones show still images of the effect instead) */}
          <script is:inline>if (matchMedia("(min-width: 768px)").matches) addEventListener("load", () => setTimeout(() => import("/vendor/tlg-fluted-glass.js"), 0));</script>
        </>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <slot name="body-start" />
    <div class="page_wrap">
      <Nav />
      <slot />
      {footer && <Footer />}
      <slot name="after-footer" />
    </div>

    <!-- Interaction & animation libraries (self-hosted copies of what Webflow loaded from CDNs) -->
    <script is:inline src="/vendor/gsap.min.js"></script>
    <script is:inline src="/vendor/ScrollTrigger.min.js"></script>
    <script is:inline src="/vendor/SplitText.min.js"></script>
    <script is:inline>
      // The site's own interactions (these used to come from Webflow's 450 KB webflow.js + jQuery):
      // hero letters rising on load, scroll reveals, the footer "ODE STUDIO" letters, class-card photo stack on hover
      // and the "Contact me" cursor over the teacher photo.
      document.addEventListener("DOMContentLoaded", () => {
        const root = document.documentElement;
        const done = () => root.classList.add("w-mod-ix3"); // un-hides the elements that wait for these animations
        if (!window.gsap || !window.ScrollTrigger) return done();
        gsap.registerPlugin(ScrollTrigger, window.SplitText);
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const desktop = matchMedia("(min-width: 992px)").matches;
        const split = (el) => (window.SplitText ? new SplitText(el, { type: "words,chars", wordsClass: "gsap_split_word", charsClass: "gsap_split_letter", aria: "none" }).chars : [el]);
        const scrub = (trigger, start = "top bottom", end = "bottom top") => ({ trigger, start: `clamp(${start})`, end: `clamp(${end})`, scrub: 0.8 });
        try {
          if (!reduce) {
            // big hero words: letters rise into place on load, then the [fade-in] text and buttons appear
            // (the hero letters rising and the [fade-in] text/buttons are pure CSS now, see the homepage, so they start as soon as the page shows)
            // Text and photos come in the way oharchitecture.com.au does it, once, when they scroll into view:
            // - titles and the paragraph under them: each LINE rises from behind its own edge (yPercent 120 -> 0, small stagger)
            // - photos: a plain cover fades away while the photo settles from 105% to 100%
            const EASE = "expo.out";
            const lineRise = (el, delay = 0) => {
              if (!window.SplitText) return;
              const split = new SplitText(el, { type: "lines", mask: "lines", linesClass: "rv-line", aria: "none" });
              gsap.from(split.lines, { yPercent: 120, rotate: 0.001, duration: 1, ease: EASE, stagger: 0.0625, delay, scrollTrigger: { trigger: el, start: "top 85%", once: true }, onComplete: () => split.revert() });
            };
            const titles = [...document.querySelectorAll('main p[role="heading"][aria-level="2"], main h2.ode-h2, main .j-big')];
            titles.forEach((t) => {
              // titles keep their chrome icon, so they are split into words and the words of one line move together
              const walker = document.createTreeWalker(t, NodeFilter.SHOW_TEXT);
              const nodes = []; while (walker.nextNode()) if (walker.currentNode.nodeValue.trim()) nodes.push(walker.currentNode);
              const inner = [];
              nodes.forEach((n) => {
                const frag = document.createDocumentFragment();
                n.nodeValue.split(/(\s+)/).forEach((part) => {
                  if (!part) return;
                  if (/^\s+$/.test(part)) { frag.append(part); return; }
                  const w = document.createElement("span"); w.className = "rv-w";
                  const i = document.createElement("span"); i.className = "rv-i"; i.textContent = part;
                  w.append(i); frag.append(w); inner.push(i);
                });
                n.replaceWith(frag);
              });
              if (inner.length) {
                const tops = [...new Set(inner.map((i) => Math.round(i.parentElement.offsetTop)))].sort((a, b) => a - b);
                gsap.from(inner, { yPercent: 120, rotate: 0.001, duration: 1, ease: EASE, delay: (k) => tops.indexOf(Math.round(inner[k].parentElement.offsetTop)) * 0.0625, scrollTrigger: { trigger: t, start: "top 85%", once: true } });
              }
              const wrap = t.closest('[class*="u-heading"]') || t;
              let para = wrap.nextElementSibling;
              if (!(para && para.matches(".u-text, .j-perks"))) para = document.querySelector(`[data-reveal-after="${t.textContent.trim().slice(0, 12)}"]`);
              if (para) para.querySelectorAll("p").length ? para.querySelectorAll("p").forEach((pp) => lineRise(pp, 0.15)) : lineRise(para, 0.15);
            });
            document.querySelectorAll("main .keypoints_visual_wrap, main .section_media_visual_wrap").forEach((ph) => {
              if (ph.closest("section[slide-down]") || ph.hasAttribute("data-stack")) return;
              const cover = document.createElement("div");
              cover.className = "rv-cover"; ph.append(cover);
              const media = [...ph.children].flatMap((c) => (c === cover ? [] : c.tagName === "PICTURE" ? [...c.querySelectorAll("img")] : [c]));
              gsap.set(media, { scale: 1.05 });
              ScrollTrigger.create({ trigger: ph, start: "top 90%", once: true, onEnter: () => {
                gsap.to(media, { scale: 1, duration: 1.2, ease: EASE, clearProps: "transform" });
                gsap.to(cover, { autoAlpha: 0, duration: 0.6, onComplete: () => cover.remove() });
              } });
            });
            // homepage middle photo: the class-card hover effect, played when it scrolls into view.
            // Two full-size copies of the sharp photo fold away into the centre one by one, the last one shrinks to its
            // usual spot in the middle, and the fluted photo behind settles from a zoom (scrolling back up reverses it).
            document.querySelectorAll("main [data-stack]").forEach((wrap) => {
              const mid = wrap.querySelector(".test-image-2-copy");
              if (!mid) return;
              const ghosts = [1, 2].map((k) => {
                const g = mid.cloneNode(); g.className = "stack-ghost"; g.style.zIndex = 2 + k; wrap.append(g); return g;
              });
              const spot = () => ({ left: "30%", top: "25%", width: "40%", height: ((0.4 * wrap.offsetWidth * 1.5) / wrap.offsetHeight) * 100 + "%" }); // the photo is 2:3
              gsap.set(mid, { ...spot(), objectFit: "cover" });
              gsap.set(wrap, { "--stack-z": 1.3 });
              const tl = gsap.timeline({ paused: true })
                .fromTo(ghosts.slice().reverse(), { scale: 1 }, { scale: 0, duration: 0.5, ease: "power1.inOut", stagger: 0.1 })
                .fromTo(mid, { left: "0%", top: "0%", width: "100%", height: "100%" }, { ...spot(), duration: 0.6, ease: "power1.inOut" }, 0.2)
                .to(wrap, { "--stack-z": 1, duration: 0.9, ease: "power1.inOut" }, 0.3);
              tl.progress(0);
              ScrollTrigger.create({ trigger: wrap, start: "top 65%", onEnter: () => tl.timeScale(1).play(), onLeaveBack: () => tl.timeScale(1.4).reverse() });
            });
            // sections marked [slide-down] drift down a little as you scroll past them
            document.querySelectorAll("[slide-down]").forEach((el) => gsap.fromTo(el, { yPercent: 0 }, { yPercent: 25, ease: "none", scrollTrigger: scrub(el) }));
            // [random-stagger-in] titles: letters appear in random order while scrolling
            document.querySelectorAll("[random-stagger-in]").forEach((el) => gsap.fromTo(split(el), { opacity: 0, y: "80%" }, { opacity: 1, y: "0%", ease: "power4.out", stagger: { each: 0.05, from: "random" }, scrollTrigger: scrub(el) }));
            // footer: the big chrome letters rise from the centre outwards
            // (each word on its own when "ODE" and "STUDIO" sit on two lines, as on phones)
            document.querySelectorAll(".footer_bottom_logo").forEach((logo) => {
              const rows = [...logo.children], stacked = rows.length > 1 && matchMedia("(max-width: 767px)").matches;
              (stacked ? rows : [logo]).forEach((row) => gsap.fromTo(row.querySelectorAll(".footer_bottom_letter"), { y: "70%" }, { y: "0px", ease: "none", stagger: { each: 0.05, from: "center" }, scrollTrigger: scrub(logo, "top bottom", "bottom 70%") }));
            });
          }
          if (desktop) {
            // class cards: on hover the stacked photos fold away one by one onto the first one
            document.querySelectorAll(".card_classes_wrap").forEach((card) => {
              const img = (n) => card.querySelector(`.card_classes_img.u-cover-absolute._${n}`);
              const [i1, i2, i3, i4] = [1, 2, 3, 4].map(img);
              if (!i1) return;
              gsap.set(i1, { scale: 1.3 });
              card.addEventListener("mouseenter", () => {
                gsap.to([i4, i3, i2].filter(Boolean), { scale: 0, duration: 0.5, ease: "power1.inOut", stagger: 0.1, overwrite: true });
                gsap.to(i1, { scale: 1, duration: 0.5, ease: "power1.inOut", delay: 0.3, overwrite: true });
              });
              card.addEventListener("mouseleave", () => {
                gsap.to(i1, { scale: 1.3, duration: 1.3, ease: "power1.inOut", overwrite: true });
                gsap.to([i2, i3, i4].filter(Boolean), { scale: 1, duration: 0.5, ease: "power1.inOut", stagger: 0.1, delay: 0.1, overwrite: true });
              });
            });
            // "Contact me" bubble follows the mouse over the teacher photo
            const bubble = document.querySelector(".cursor_element.meet_teacher");
            const zone = document.querySelector('[data-w-id="63b7eb76-e579-78ec-09bb-36ed4b1c98f9"]');
            if (bubble) {
              gsap.set(bubble, { opacity: 0 });
              const x = gsap.quickTo(bubble, "x", { duration: 0.5, ease: "power3" }), y = gsap.quickTo(bubble, "y", { duration: 0.5, ease: "power3" });
              addEventListener("mousemove", (e) => { x(e.clientX - innerWidth / 2); y(e.clientY - innerHeight / 2); }, { passive: true });
              if (zone) {
                zone.addEventListener("mouseenter", () => gsap.to(bubble, { opacity: 1, duration: 0.5, ease: "expo.out" }));
                zone.addEventListener("mouseleave", () => gsap.to(bubble, { opacity: 0, duration: 0.5, ease: "expo.out" }));
              }
            }
          } else {
            // phones and tablets: the class-card effect plays on the card the slider moves to (arrow button or swipe),
            // every time (sliding back too). The card is reset instantly first: before and after look the same, so nothing jumps.
            document.querySelectorAll(".card_classes_img.u-cover-absolute._1").forEach((i1) => gsap.set(i1, { scale: 1.3 }));
            addEventListener("ode-class-slide", (e) => {
              const card = e.detail;
              if (!card) return;
              const [i1, i2, i3, i4] = [1, 2, 3, 4].map((n) => card.querySelector(`.card_classes_img.u-cover-absolute._${n}`));
              if (!i1) return;
              gsap.set([i2, i3, i4].filter(Boolean), { scale: 1, overwrite: true });
              gsap.set(i1, { scale: 1.3, overwrite: true });
              gsap.to([i4, i3, i2].filter(Boolean), { scale: 0, duration: 0.5, ease: "power1.inOut", stagger: 0.1, overwrite: true });
              gsap.to(i1, { scale: 1, duration: 0.5, ease: "power1.inOut", delay: 0.3, overwrite: true });
            });
          }
        } finally { done(); }
      });
    </script>
    <script is:inline src="/vendor/lenis.min.js" defer></script>
    <script is:inline src="/vendor/ukiyo.min.js" defer></script>
    <script is:inline defer>
      document.addEventListener("DOMContentLoaded", () => {
        // Smooth scroll
        const lenis = new Lenis();
        window.lenis = lenis;
        // Lenis only measures the page at start; re-measure whenever the content grows or shrinks (e.g. "Voir plus", filters)
        new ResizeObserver(() => lenis.resize()).observe(document.body);
        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
        // Parallax images
        const images = document.querySelectorAll(".parallax");
        new Ukiyo(images, { scale: 1.5, speed: 1.5, willChange: true });

        // Call-to-action pills (waitlist + formules + course filters): on hover they turn burgundy and a small chrome heart pops out (design B7)
        document.querySelectorAll(".button_main_wrap").forEach((wrap) => {
          if (wrap.matches('[class*="w-variant-625d5df4"]')) return; // "See more" text links keep their own effect
          if (!wrap.querySelector("[data-modal-trigger]") && !wrap.closest(".card_primary_wrap") && !wrap.closest(".ode-course-filters") && !wrap.closest(".ode-heart-cta")) return;
          const el = wrap.querySelector(".button_main_element");
          if (!el) return;
          wrap.classList.add("ode-heart-btn");
          const heart = document.createElement("img");
          heart.src = "/images/ode-heart-s.webp";
          heart.alt = "";
          heart.className = "ode-heart";
          heart.setAttribute("aria-hidden", "true");
          el.appendChild(heart);
        });

        // Title hearts further down the page pop in when they come into view (not all at page load)
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver((entries) => entries.forEach((en) => { if (en.isIntersecting) { en.target.style.animationPlayState = "running"; io.unobserve(en.target); } }), { rootMargin: "0px 0px -15% 0px" });
          document.querySelectorAll(".ode-title-heart").forEach((h) => {
            if (h.getBoundingClientRect().top > innerHeight) { h.style.animationPlayState = "paused"; io.observe(h); }
          });
        }

        // Hero sections darken as you scroll past them (like oharchitecture.com.au):
        // a black layer over the hero goes from 0 to 70% while the next section slides over it.
        const heroes = [...document.querySelectorAll("section[slide-down]")].map((hero) => {
          const dim = document.createElement("div");
          dim.className = "hero-dim";
          dim.setAttribute("aria-hidden", "true");
          hero.appendChild(dim);
          return { hero, dim };
        });
        if (heroes.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          const update = () => {
            for (const { hero, dim } of heroes) {
              const r = hero.getBoundingClientRect();
              const p = Math.min(Math.max(-r.top / (r.height || 1), 0), 1);
              dim.style.opacity = (p * 0.7).toFixed(3);
            }
          };
          lenis.on("scroll", update);
          addEventListener("resize", update);
          update();
        }
      });
    </script>
    <style is:global>
      .slider_bullet_list { column-gap: .5rem !important; }
      /* word masks for the title rise: clip only below the line, so italics and descenders are never cut */
      .rv-w { display: inline-block; vertical-align: top; padding-bottom: .14em; margin-bottom: -.14em; clip-path: inset(-.5em -.4em 0 -.4em); }
      .rv-i { display: inline-block; will-change: transform; }
      .rv-cover { position: absolute; inset: 0; z-index: 5; background: #e8e6e6; pointer-events: none; }
      /* bigger touch areas (44px+) on small links, using an invisible layer: nothing visible changes */
      .onav-logo, .footer_link_wrap, .footer_social_link, .footer_bottom_link_wrap, .form_ui_label { position: relative; }
      .onav-logo::before, .footer_link_wrap::before, .footer_social_link::before, .footer_bottom_link_wrap::before, .form_ui_label::before, .back::before { content: ""; position: absolute; }
      .onav-logo::before { inset: -11px -6px; }
      .footer_link_wrap::before { inset: -8px -6px; }
      .footer_social_link::before { inset: -6px; }
      .footer_bottom_link_wrap::before { inset: -10px -4px; }
      .form_ui_label::before { inset: -9px -4px; }
      .back::before { inset: -12px -8px; }
      @media (max-width: 767px) {
      }
      .ode-heart-btn { overflow: visible; }
      .ode-heart-btn .button_main_element { transition: background-color .35s, border-color .35s, color .35s; }
      .ode-heart-btn:hover .button_main_element, .ode-heart-btn:focus-within .button_main_element, .card_primary_wrap:hover .ode-heart-btn .button_main_element, .card_primary_wrap:focus-within .ode-heart-btn .button_main_element { background-color: #401f28 !important; border-color: #401f28 !important; color: #fff !important; }
      .ode-heart { position: absolute; right: -.5rem; top: -.5rem; width: 2.125rem; height: auto; pointer-events: none; opacity: 0; transform: translateY(.875rem) rotate(-30deg) scale(.3); transition: transform .55s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; filter: drop-shadow(0 6px 8px rgb(0 0 0 / 25%)); z-index: 2; }
      .ode-heart-btn:hover .ode-heart, .ode-heart-btn:focus-within .ode-heart, .card_primary_wrap:hover .ode-heart, .card_primary_wrap:focus-within .ode-heart { opacity: 1; transform: translateY(-.625rem) rotate(12deg) scale(1); }
      @media (prefers-reduced-motion: reduce) { .ode-heart { transition: opacity .2s; transform: none; } }
      /* No black buttons: on light sections buttons fill burgundy on hover, and the primary (dark) button is burgundy */
      :is(:root, .u-theme-light) { --_theme---button-secondary--background-hover: #401f28; --_theme---button-secondary--text-hover: #fff; --_theme---button-primary--background: #401f28; --_theme---button-primary--background-hover: #2b141b; --_theme---button-primary--text-hover: #fff; }
      .u-theme-dark { --_theme---button-primary--background: #401f28; --_theme---button-primary--background-hover: #2b141b; --_theme---button-primary--text-hover: #fff; }
      /* Brand signature: a small chrome heart at the top right of each page's main title (one per page), and burgundy label dots */
      .ode-th { position: relative; display: inline-block; }
      /* title icons: sparkle (Concept), book (Figures), question mark (Questions?), heart elsewhere; --icon-k keeps them visually the same size as the heart */
      .ode-icon-sparkle { --icon-k: .95; }
      .ode-icon-book { --icon-k: 1.05; right: -.55em; }
      .ode-icon-question { --icon-k: .62; right: -.32em; top: -.22em; }
      .ode-title-heart { position: absolute; right: -.4em; top: -.1em; width: calc((var(--icon-base, max(.34em, 1.5rem)) + 15px) * var(--icon-k, 1)); height: auto; pointer-events: none; transform: rotate(12deg); filter: drop-shadow(0 .06em .1em rgb(0 0 0 / 25%)); animation: ode-heart-in .75s cubic-bezier(.3, 1.8, .5, 1) var(--heart-delay, .4s) both; }
      @keyframes ode-heart-in { from { opacity: 0; transform: translateY(.25em) rotate(-30deg) scale(.3); } }
      @media (prefers-reduced-motion: reduce) { .ode-title-heart { animation: none; } }
      .u-eyebrow-marker { background-color: #401f28 !important; }
      /* Page transitions (pages that opt in via viewTransition): the old page fades, shared elements glide, the new page fades in */
      ::view-transition-old(root) { animation: .4s ease both vt-out; }
      ::view-transition-new(root) { animation: .5s ease .9s both vt-in; }
      @keyframes vt-out { to { opacity: 0; } }
      @keyframes vt-in { from { opacity: 0; } }
      /* figures → trick: the other photos squash into lines, then the clicked photo grows into place */
      ::view-transition-group(trick-photo) { animation-duration: .95s; animation-delay: .35s; animation-timing-function: cubic-bezier(.76, 0, .24, 1); }
      ::view-transition-old(trick-photo), ::view-transition-new(trick-photo) { width: 100%; height: 100%; object-fit: cover; overflow: clip; animation-duration: .95s; animation-delay: .35s; }
      ::view-transition-old(*.fg-gone) { animation: .45s cubic-bezier(.76, 0, .24, 1) both vt-line; transform-origin: 50% 50%; }
      /* the word swaps in a short moment mid-glide, so it never shows twice */
