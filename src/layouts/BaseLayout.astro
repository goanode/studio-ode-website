      html:active-view-transition-type(from-nav)::view-transition-old(concept-title), html:active-view-transition-type(from-nav)::view-transition-old(communaute-title), html:active-view-transition-type(from-nav)::view-transition-old(figures-title) { animation: .2s ease .15s both vt-out; }
      html:active-view-transition-type(from-nav)::view-transition-new(concept-title), html:active-view-transition-type(from-nav)::view-transition-new(communaute-title), html:active-view-transition-type(from-nav)::view-transition-new(figures-title) { animation: .3s ease .15s both vt-in; }
