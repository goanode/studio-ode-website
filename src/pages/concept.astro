---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
// Concept page (design Z1, after "The Wild Core", in Ode branding): links in the corners,
// a tall fluted photo with "Concept" written across it, three short columns, two photos, Ensemble.
const I = {
  main: "/images/Hello-please-take-the-style-of-t-391374-HCn.webp",
  oval: "/images/Hello-please-take-the-style-of-t-11755-EU2.webp",
  a: "/images/ac743b8e553553c0be56bc5dbaabf5b6.avif",
  b: "/images/7053819a90a239bb9f6686d8d1df9a9d.webp",
};
---

<BaseLayout title="Concept — Studio Ode" description="Le concept du studio de pole dance Ode, à Lille." wfPage="6adb80ddd07ffba4e0c0cb69">
  <main id="main" class="page_main wc">
    <section class="frame">
      <a class="corner c-tl" href="/#cours">Cours</a>
      <a class="corner c-tr" href="/figures">Figures</a>
      <a class="corner c-bl" href="/#studio">Studio</a>
      <a class="corner c-br" href="#contact">Contact</a>
      <figure class="photo"><img src={I.main} alt="Élève à la barre au studio Ode" /><span class="flute" aria-hidden="true"></span></figure>
      <p class="vert">Studio Ode, Lille</p>
      <h1 class="word">Concept</h1>
      <span class="oval" aria-hidden="true"><img src={I.oval} alt="" /></span>
      <p class="tag">Pole dance &amp; expression,<br />pour un mouvement plus libre, plus fort et plus doux.</p>
    </section>

    <section class="man">
      <div><p class="eb">Force</p><h2>Pas besoin d'être forte.</h2><p>Ni souple, ni sportive, ni sûre de soi. Pas besoin d'avoir déjà dansé. On commence là où tu es, avec ton corps tel qu'il est aujourd'hui. La force vient en chemin, cours après cours, sans forcer, sans se comparer.</p><p class="q">Tu viens comment ?</p></div>
      <div><p class="eb">Expression</p><h2>On veut de la profondeur.</h2><p>Des cours qui ont du sens. Une professeure qui connaît ton prénom et ton corps. Huit élèves maximum. De la technique, de la musique, du flow. Le droit d'essayer, de rater, de recommencer.</p><p class="q">Qu'est-ce que tu cherches ?</p></div>
      <div><p class="eb">Communauté</p><h2>On avance ensemble.</h2><p>Dans un lieu calme et lumineux, à Lille. Un studio pensé pour bouger, se renforcer et s'exprimer. Pour se sentir bien dans son corps, et peut-être un peu plus fière de lui.</p><p class="q">Qu'est-ce que tu espères ?</p></div>
    </section>

    <section class="duo">
      <figure><img src={I.a} alt="Élève au studio" loading="lazy" style="object-position: 50% 25%" /><span class="flute" aria-hidden="true"></span></figure>
      <figure><img src={I.b} alt="Renforcement au studio" loading="lazy" /></figure>
    </section>

    <section class="end">
      <h2 class="word-end">Ensemble</h2>
      <button type="button" class="pill" data-modal-trigger="waitlist">Rejoins la liste d'attente</button>
    </section>
  </main>
  <WaitlistModal slot="after-footer" />
</BaseLayout>

<style>
  .wc { --red: #842636; color: #3b3b3b; background: #fff; overflow-x: clip; }
  :global(.nav_button_wrap) { color: #141414; border-color: rgb(20 20 20 / 20%) !important; }
  :global(.nav_button_line) { background-color: #141414 !important; }
  .wc p, .wc h1, .wc h2 { margin: 0; }
  .wc p::before, .wc p::after, .wc h1::before, .wc h1::after, .wc h2::before, .wc h2::after { content: none; }
  .wc .eb::before { content: ""; display: block; width: 6px; height: 6px; border-radius: 9999px; background: currentColor; }

  .frame { position: relative; height: max(100svh, 46rem); padding-top: var(--nav--height-total, 6rem); }
  .corner { position: absolute; z-index: 4; display: inline-flex; align-items: center; height: 2.5rem; padding: 0 1.125rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: rgb(255 255 255 / 60%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); font-size: 1rem; color: #3b3b3b; text-decoration: none; transition: background-color .25s, color .25s, border-color .25s; }
  .corner:hover { background: #3b3b3b; border-color: #3b3b3b; color: #fff; }
  .corner:focus-visible, .pill:focus-visible { outline: 2px solid #1f1d1e; outline-offset: 3px; }
  .c-tl { left: var(--site--margin, 1.5rem); top: calc(var(--nav--height-total, 6rem) + .5rem); }
  .c-tr { right: var(--site--margin, 1.5rem); top: calc(var(--nav--height-total, 6rem) + .5rem); }
  .c-bl { left: var(--site--margin, 1.5rem); bottom: 1.25rem; }
  .c-br { right: var(--site--margin, 1.5rem); bottom: 1.25rem; }
  .photo { position: absolute; left: 50%; top: calc(var(--nav--height-total, 6rem) + .5rem); width: min(21rem, 26vw); height: min(56svh, 33rem); margin: 0; transform: translateX(-50%); overflow: hidden; background: var(--red); }
  .photo img, .duo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; }
  .flute { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgb(255 255 255 / 10%) 0, transparent 2px, transparent 20px, rgb(31 29 30 / 16%) 28px, rgb(255 255 255 / 10%) 32px); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  .vert { position: absolute; left: calc(50% + min(10.5rem, 13vw) + 1rem); top: calc(var(--nav--height-total, 6rem) + 7rem); writing-mode: vertical-rl; transform: rotate(180deg); font-size: 1.375rem; }
  .word { position: absolute; z-index: 3; left: 50%; top: calc(var(--nav--height-total, 6rem) + min(36svh, 21rem)); transform: translateX(-50%); font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(5rem, 17vw, 15.5rem); line-height: .9; letter-spacing: -.02em; color: var(--red); white-space: nowrap; animation: write 2.4s cubic-bezier(.6, .05, .3, 1) .4s both; }
  @keyframes write { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 -5% 0 0); } }
  .oval { position: absolute; right: calc(var(--site--margin, 1.5rem) + .5rem); bottom: 4.5rem; width: 1.875rem; height: 2.5rem; border-radius: 50%; overflow: hidden; z-index: 4; }
  .oval img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; }
  .tag { position: absolute; z-index: 4; left: 50%; bottom: 1.75rem; transform: translateX(-50%); width: max-content; max-width: calc(100% - 16rem); text-align: center; font-size: 1.25rem; line-height: 1.35; }

  .man { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6rem; margin-top: 6rem; padding: 5rem 4.5rem; border-top: 1px solid rgb(31 29 30 / 12%); border-bottom: 1px solid rgb(31 29 30 / 12%); }
  .man > div { display: flex; flex-direction: column; gap: .875rem; }
  .eb { display: inline-flex; align-items: center; gap: .625rem; color: var(--red); margin-bottom: .25rem !important; }
  .man h2 { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 2rem; line-height: 1.1; color: #1f1d1e; }
  .man p { font-size: 1rem; line-height: 1.5; }
  .man .q { color: var(--red); margin-top: .75rem; }

  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; padding: 7.5rem var(--site--margin, 1.5rem) 0; }
  .duo figure { position: relative; margin: 0; height: min(44rem, 70vh); overflow: hidden; background: var(--red); }
  .end { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; padding: 10rem 1.5rem 12rem; text-align: center; }
  .word-end { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(4.5rem, 12.5vw, 11.25rem); line-height: .9; letter-spacing: -.02em; color: var(--red); }
  .pill { display: inline-flex; align-items: center; height: 3rem; padding: 0 1.5rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: none; font-family: inherit; font-size: 1rem; font-weight: 500; color: #3b3b3b; cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .pill:hover { background: #3b3b3b; border-color: #3b3b3b; color: #fff; }
  @media (prefers-reduced-motion: reduce) { .word { animation: none; } }
  @media (max-width: 767px) {
    .frame { height: 48rem; }
    .corner { height: 2.125rem; padding: 0 .75rem; font-size: .8125rem; }
    .photo { width: 13.75rem; height: 23.75rem; top: calc(var(--nav--height-total, 6rem) + 3.25rem); }
    .vert { left: calc(50% + 7.5rem); font-size: .9375rem; top: calc(var(--nav--height-total, 6rem) + 8rem); }
    .word { font-size: 6rem; top: calc(var(--nav--height-total, 6rem) + 18rem); }
    .oval { display: none; }
    .tag { left: 1rem; right: 1rem; transform: none; width: auto; max-width: none; bottom: 4.5rem; font-size: 1rem; }
    .man { grid-template-columns: 1fr; gap: 2.5rem; margin-top: 4rem; padding: 3.5rem 1rem; }
    .duo { grid-template-columns: 1fr; padding: 4.5rem 1rem 0; }
    .duo figure { height: 26rem; }
    .end { padding: 6rem 1rem 7.5rem; }
    .word-end { font-size: 5rem; }
  }
</style>
