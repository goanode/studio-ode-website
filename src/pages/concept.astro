---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkButton from "../components/LinkButton.astro";
import FigureHero from "../components/FigureHero.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
import { tricks, LEVELS } from "../data/tricks";
---

<!-- Home page id: same hero load animation as the homepage and /figures -->
<BaseLayout title="Concept — Studio Ode" wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <div>
    <FigureHero title="Concept" image="/images/ea27f15c4ddd5e50ea8bd0309f3aae76" />
    <section data-wf--section--variant="inherit" data-w-id="9cd849af-5c85-da69-3983-2e49dba72900" class="u-section u-padding-top-large u-padding-bottom-small u-theme-light">
      <div class="u-container  ">
        <div data-wf--layout--variant="stack" class="u-layout-wrapper">
          <div class="u-layout">
            <div class="u-layout-column-1  ">
              <div data-wf--content-wrapper--variant="center" style="" class="u-content-wrapper w-variant-4f54624e-ceb1-0769-a238-365d5e220b70">
                <div class="u-display-contents"></div>
              </div>
              <div class="div">
                <p class="paragraph reveal-type">Nous ne <span class="text-span-3">t&#x27;apprenons</span> pas des <span class="text-span-3">figures</span>. Nous t&#x27;apprenons <span class="text-span-3">l&#x27;art</span> du mouvement, et la beauté d&#x27;une <span class="text-span-3">danse</span> pleinement incarnée.</p>
              </div>
            </div>
            <div class="u-layout-column-2  ">
              <div data-wf--layout--variant="sticky-left" class="u-layout-wrapper">
                <div class="u-layout w-variant-81232c92-6578-ef9a-1e3e-35e3204ae0fd">
                  <div class="u-layout-column-1 w-variant-81232c92-6578-ef9a-1e3e-35e3204ae0fd u-column-span-3">
                    <div class="u-eyebrow-wrapper">
                      <div class="u-eyebrow-layout">
                        <div class="u-eyebrow-marker"></div>
                        <div class="u-eyebrow-text w-richtext">
                          <p>Our Concept</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="u-layout-column-2 w-variant-81232c92-6578-ef9a-1e3e-35e3204ae0fd u-column-span-8 u-column-start-4">
                    <div data-wf--layout--variant="stack" class="u-layout-wrapper">
                      <div class="u-layout">
                        <div class="u-layout-column-1  ">
                          <div data-wf--content-wrapper--variant="left" style="" class="u-content-wrapper w-variant-e85a4315-14bc-e5ef-0d3e-2c8c9ed7d2f1">
                            <div class="u-display-contents">
                              <div data-anim="" data-number="20" data-wf--typography-heading--variant="bigtext" data-wf-component-id="b9130e59-aa4e-07ef-a822-eda529bf75ca" data-wf-variant-state="a520658d-fa31-fc0b-27f3-743ef8f2b00b" class="u-heading w-variant-a520658d-fa31-fc0b-27f3-743ef8f2b00b w-richtext u-margin-bottom-8">
                                <h2>STRENGTH</h2>
                              </div>
                              <div data-anim="" data-number="20" data-wf--typography-heading--variant="bigtext" data-wf-component-id="b9130e59-aa4e-07ef-a822-eda529bf75ca" data-wf-variant-state="a520658d-fa31-fc0b-27f3-743ef8f2b00b" class="u-heading w-variant-a520658d-fa31-fc0b-27f3-743ef8f2b00b w-richtext u-margin-bottom-8">
                                <h2>FLEXIBILITY</h2>
