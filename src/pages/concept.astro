---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
// Concept page (design "ConceptValues", after the Telha Clarke video):
// 1. a collage of photos around "Concept"; scrolling makes one photo grow to fill the screen
// 2. on that photo, the four pillars slide past one by one as you scroll, with their text
const I = {
  r0: "/images/37165de30ebb4909ab52aaa06a86c422.avif",
  r1: "/images/7053819a90a239bb9f6686d8d1df9a9d.webp",
  r2: "/images/Hello-please-take-the-style-of-t-11755-EU2.webp",
  r3: "/images/Hello-please-take-the-style-of-t-329741-ZHu.webp",
  r4: "/images/Hello-please-take-the-style-of-t-391374-HCn.webp",
  r5: "/images/a919359daba17134b7c9ce30dbfe9490.avif",
  r6: "/images/ac743b8e553553c0be56bc5dbaabf5b6.avif",
  r7: "/images/ea27f15c4ddd5e50ea8bd0309f3aae76.webp",
  r8: "/images/f830ef2fd533f1f45b6d4d1beba1face.avif",
  r9: "/images/please-look-at-the-first-pose----265877-w4L.webp",
  big: "/images/please-keep-the-background--the-233555-iP0.webp",
};
// collage, laid out on a 1440 × 900 board: [image, x, y, w, h, faded, hidden on mobile, depth]
const COL: [string, number, number, number, number, boolean, boolean, number][] = [
  [I.r1, 140, 70, 90, 110, true, true, 1.4],
  [I.r2, 330, 140, 190, 240, false, false, 1],
  [I.r9, 570, 80, 90, 130, true, true, 1.6],
  [I.r0, 1290, 120, 130, 170, true, false, 1.3],
  [I.r3, -30, 230, 130, 180, true, false, 1.5],
  [I.r8, 200, 500, 120, 150, true, true, 1.2],
  [I.r6, 430, 600, 200, 220, false, false, 1],
  [I.r7, 690, 610, 200, 290, false, true, 0.8],
  [I.r5, 1140, 560, 120, 160, true, false, 1.4],
  [I.r1, 1300, 700, 160, 200, true, true, 1.1],
];
const pct = (x: number, total: number) => `${((x / total) * 100).toFixed(3)}%`;
const PILLARS = [
  ["Force", "Pas besoin d'être forte pour commencer. On construit des bases solides, cours après cours : dos, épaules, gainage. La force vient en chemin, sans forcer et sans se comparer."],
  ["Expression", "La barre devient un langage. On travaille la technique, puis on la laisse disparaître derrière le mouvement, pour que chaque élève trouve sa propre façon de danser."],
  ["Souplesse", "Des étirements guidés et progressifs, adaptés à ton corps d'aujourd'hui. Gagner en amplitude, en confiance, et en douceur."],
  ["Communauté", "Huit élèves maximum, une professeure qui connaît chaque corps. On s'encourage, on progresse ensemble, dans un lieu calme et lumineux à Lille."],
];
---

<BaseLayout viewTransition="concept-title" title="Concept — Studio Ode" description="Le concept du studio de pole dance Ode, à Lille : force, expression, souplesse, communauté." wfPage="6adb80ddd07ffba4e0c0cb69">
  <main id="main" class="page_main cv">
    <section class="intro u-theme-light" aria-label="Concept">
      <div class="stage">
        <div class="col">
          {COL.map(([src, x, y, w, h, faded, hm, depth], i) => (
            <figure class:list={["cf", { faded, hm }]} data-depth={depth} data-side={x + w / 2 < 720 ? -1 : 1} style={`--x:${pct(x, 1440)};--y:${pct(y, 900)};--w:${pct(w, 1440)};--h:${pct(h, 900)}`}>
              <img src={src} alt="" loading={i < 4 ? "eager" : "lazy"} />
            </figure>
          ))}
        </div>
        <span class="slot" aria-hidden="true" style={`--x:${pct(1030, 1440)};--y:${pct(60, 900)};--w:${pct(260, 1440)};--h:${pct(400, 900)}`}></span>
        <h1 class="ttl"><span class="ode-th"><span id="concept-title" class="vt-title">Concept</span><img class="ode-title-heart ode-icon-sparkle" src="/images/ode-icon-sparkle.webp" alt="" aria-hidden="true" /></span></h1>
        <p class="meta m-l">Studio Ode</p>
        <p class="meta m-r"><span class="clock" aria-hidden="true">10:23</span>&nbsp;&nbsp;Lille, FR</p>
        <figure class="grow">
          <img src={I.big} alt="Élève au studio Ode" />
          <span class="dim" aria-hidden="true"></span>
        </figure>
        <div class="pil u-theme-dark" aria-label="Nos quatre piliers">
          <div class="tick-wrap"><ul class="tick" role="list">
            {PILLARS.map(([name]) => <li class="w"><span class="ode-th">{name}<img class="ode-title-heart" src="/images/Glanzend-chromen-hart-op-transparante-achtergrond-p-500.webp" alt="" aria-hidden="true" /></span></li>)}
          </ul></div>
          <div class="para">
            {PILLARS.map(([name, text]) => <p><span class="sr">{name} : </span>{text}</p>)}
          </div>
          <div class="b-pil">
            <div data-wf--button-main--variant="secondary" data-trigger="hover focus" class="button_main_wrap">
            <div data-wf--clickable--variant="focus-ring-outside" class="clickable_wrap u-cover-absolute"><button type="button" aria-label="Rejoins la liste d&#x27;attente" data-modal-trigger="waitlist" class="clickable_btn"></button></div>
            <div data-button="" class="button_main_element w-variant-e85564cd-af30-a478-692b-71732aefb3ab"><div aria-hidden="true" class="button_main_text u-text-style-main">Rejoins la liste d&#x27;attente</div></div>
          </div>
          </div>
        </div>
      </div>
    </section>
    <!-- under the animated hero: "Deviens fondatrice" — the silver invitation hangs on a burgundy lanyard between the words; perks + CTA open the waitlist -->
    <section class="join" aria-labelledby="join-title">
      <div class="lanyard">
        <div class="strap" aria-hidden="true"><span>STUDIO ODE</span><span>STUDIO ODE</span></div>
        <img class="clip" src="/images/ode-lanyard-clip.webp" alt="" aria-hidden="true" width="390" height="662" loading="lazy" />
        <button type="button" class="inv" data-modal-trigger="waitlist" aria-label="Deviens membre fondatrice"><img src="/images/ode-invitation.webp" alt="" width="620" height="827" loading="lazy" /><span class="j-tab" aria-hidden="true">Ouvrir l’invitation <i>→</i></span></button>
      </div>
      <h2 class="j-big" id="join-title"><span>Deviens</span> <span>fondatrice.</span></h2>
<p class="j-perks"><span>Une place réservée</span><img src="/images/ode-icon-sparkle.webp" alt="" aria-hidden="true" width="16" height="17" /><span>Un tarif fondatrice</span><img src="/images/ode-icon-sparkle.webp" alt="" aria-hidden="true" width="16" height="17" /><span>Ton premier cours offert</span></p>
    </section>

  </main>
  <WaitlistModal slot="after-footer" />
  <Fragment slot="head">
    <script is:inline>
      // arriving with the page transition: the heart pops in after the title has landed
      addEventListener("pagereveal", (e) => { if (e.viewTransition) document.documentElement.classList.add("vt-in"); });
    </script>
  </Fragment>

  <Fragment slot="scripts">
    <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const root = document.querySelector(".cv");
      if (!root) return;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const intro = root.querySelector(".intro");
      const stage = root.querySelector(".stage");
      const figs = [...root.querySelectorAll(".cf")];
      const slot = root.querySelector(".slot");
      const grow = root.querySelector(".grow");
      const gimg = grow.querySelector("img");
      const words = [...root.querySelectorAll(".tick .w")];
      const paras = [...root.querySelectorAll(".para p")];
      const tick = root.querySelector(".tick");
      const N = words.length;

      // Live Lille time in the corner
      const clock = root.querySelector(".clock");
      const tickClock = () => { clock.textContent = new Intl.DateTimeFormat("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Paris" }).format(new Date()); };
      tickClock(); setInterval(tickClock, 30000);



      if (reduce || !window.gsap || !window.ScrollTrigger) { root.classList.add("still"); return; }
      gsap.registerPlugin(ScrollTrigger);
      // keep ScrollTrigger in step with the smooth scroll, so nothing lags or jumps
      if (window.lenis) window.lenis.on("scroll", ScrollTrigger.update);

      // the growing photo: a full-screen photo seen through a window the size of the collage slot
      const box = () => {
        const s = stage.getBoundingClientRect(), r = slot.getBoundingClientRect();
        return { t: r.top - s.top, l: r.left - s.left, b: s.bottom - r.bottom, rr: s.right - r.right, w: r.width, h: r.height, W: s.width, H: s.height };
      };
      const clipFrom = () => { const b = box(); return `inset(${b.t}px ${b.rr}px ${b.b}px ${b.l}px)`; };
      const imgFrom = () => {
        const b = box(); const sc = Math.max(b.w / b.W, b.h / b.H) * 1.08;
        return { x: b.l + b.w / 2 - b.W / 2, y: b.t + b.h / 2 - b.H / 2, scale: sc };
      };
      gsap.set(grow, { clipPath: clipFrom() });
      gsap.set(gimg, imgFrom());


      // pinned scroll: the photo opens up to full screen and blurs (homepage frosted glass, 20px) while it grows, then the four pillars slide past
      gsap.set(words, { opacity: (k) => (k === 0 ? 1 : .3) });
      gsap.set(paras, { opacity: (k) => (k === 0 ? 1 : 0) });
      let dark = false;
      const tl = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: intro, start: "top top", end: "bottom bottom", scrub: true, invalidateOnRefresh: true,
          onUpdate: (st) => { const d = st.progress > 0.1 && st.progress < 0.995; if (d !== dark) { dark = d; document.body.classList.toggle("cv-dark", d); } },
        },
      });
      tl.fromTo(grow, { clipPath: clipFrom }, { clipPath: "inset(0px 0px 0px 0px)", duration: 1.4, ease: "power1.inOut" }, 0)
        .fromTo(gimg, { x: () => imgFrom().x, y: () => imgFrom().y, scale: () => imgFrom().scale }, { x: 0, y: 0, scale: 1, duration: 1.4, ease: "power1.inOut" }, 0)
        .to(figs, { y: (i, el) => -innerHeight * 0.45 * +el.dataset.depth, x: (i, el) => +el.dataset.side * innerWidth * 0.06 * +el.dataset.depth, opacity: 0, duration: 1.2, ease: "power1.in" }, 0)
        .fromTo(".cv .dim", { opacity: 0 }, { opacity: 1, duration: 1.2, ease: "power1.in" }, .2)
        .fromTo(".cv .pil", { autoAlpha: 0 }, { autoAlpha: 1, duration: .4 }, 1.2)

      // the active word sits in the middle of the screen: shift the row so word k's centre lands on the screen's centre
      const off = (k) => innerWidth / 2 - (words[k].offsetLeft + words[k].offsetWidth / 2);
      tl.fromTo(tick, { x: () => off(0) }, { x: () => off(0), duration: 0.01 }, 0); // part of the scroll timeline so it re-measures on resize
      let t = 2.2;
      for (let k = 1; k < N; k++) {
        tl.to(tick, { x: () => off(k), duration: 1, ease: "power1.inOut" }, t)
          .to(words[k - 1], { opacity: .3, duration: .5 }, t)
          .to(words[k], { opacity: 1, duration: .5 }, t + .5)
          .to(paras[k - 1], { opacity: 0, duration: .4 }, t)
          .to(paras[k], { opacity: 1, duration: .4 }, t + .6);
        t += 1.8;
      }
      tl.to({}, { duration: .5 }, t);



      addEventListener("load", () => ScrollTrigger.refresh());
      document.fonts?.ready.then(() => ScrollTrigger.refresh());
    });
    </script>
  </Fragment>
</BaseLayout>

<style>
  /* 3 · join section under the hero: the silver invitation on a burgundy lanyard, between the words of a big call to action */
  .join { position: relative; padding: 0 var(--site--margin, 2.5rem) 9rem; background: #fff; overflow: hidden; }
  .lanyard { position: absolute; left: 50%; top: 0; z-index: 3; width: 18.75rem; margin-left: -9.375rem; display: flex; flex-direction: column; align-items: center; transform-origin: 50% 0; animation: sway 6s ease-in-out infinite; }
  @keyframes sway { 0%, 100% { transform: rotate(1.6deg); } 50% { transform: rotate(-1.6deg); } }
  .strap { width: 2.77rem; height: 16rem; background: var(--red); display: flex; flex-direction: column; align-items: center; justify-content: space-around; overflow: hidden; }
  .strap span { writing-mode: vertical-rl; white-space: nowrap; color: #fff; font-size: .6875rem; letter-spacing: .24em; font-weight: 500; opacity: .85; }
  .clip { position: relative; z-index: 1; display: block; width: 5rem; height: auto; margin-top: -1px; filter: drop-shadow(0 3px 4px rgb(0 0 0 / 18%)); }
  .inv { position: relative; z-index: 2; display: block; padding: 0; border: 0; cursor: pointer; transition: transform .35s cubic-bezier(.3, 1.4, .5, 1), box-shadow .35s; width: 16.25rem; margin-top: -1.2rem; aspect-ratio: 620 / 827; border-radius: 1rem; overflow: visible; background: #8a8888; box-shadow: 0 18px 40px rgb(31 29 30 / 22%); }
  .inv:hover { transform: translateY(4px) rotate(-1deg); box-shadow: 0 24px 48px rgb(31 29 30 / 28%); }
  .inv:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; }
  .inv::before { content: ""; position: absolute; z-index: 2; left: 50%; top: .5625rem; width: 2.125rem; height: .375rem; margin-left: -1.0625rem; border-radius: 9999px; background: rgb(255 255 255 / 55%); box-shadow: inset 0 1px 2px rgb(0 0 0 / 35%); }
  .inv img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 1rem; }
  /* burgundy tab on the bottom edge of the card: makes it clear the card opens something */
  .j-tab { position: absolute; z-index: 3; left: 50%; bottom: -1.25rem; display: inline-flex; align-items: center; gap: .5rem; height: 2.5rem; padding: 0 1.125rem; border-radius: 9999px; background: var(--red); color: #fff; font-size: .875rem; white-space: nowrap; box-shadow: 0 8px 18px rgb(64 31 40 / 30%); transform: translateX(-50%); animation: j-peek 3s ease-in-out infinite; }
  .j-tab i { font-style: normal; transition: transform .3s; }
  .inv:hover .j-tab i { transform: translateX(4px); }
  @keyframes j-peek { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(4px); } }
  .j-big { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr 19rem 1fr; align-items: center; margin: 0; padding-top: 29.5rem; white-space: nowrap; font-family: var(--_typography---font--secondary-family); font-weight: 500; font-size: clamp(3.5rem, 7.2vw, 7.5rem); line-height: .9; letter-spacing: -.04em; color: var(--ink); }
  .j-big span:first-child { grid-column: 1; justify-self: end; }
  .j-big span:last-child { grid-column: 3; justify-self: start; }
  /* the founder perks: one quiet line of small capitals joined by chrome sparkles, under the card */
  .join { min-height: 57rem; }
  .j-perks { position: absolute; left: var(--site--margin, 2.5rem); right: var(--site--margin, 2.5rem); top: 49.5rem; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 1.375rem; margin: 0; font-size: .8125rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ink); }
  .j-perks img { width: 1rem; height: auto; filter: drop-shadow(0 1px 2px rgb(0 0 0 / 20%)); }
  @media (prefers-reduced-motion: reduce) { .lanyard, .j-tab { animation: none; } }
  @media (min-width: 768px) and (max-width: 991px) { .j-big { font-size: 5vw; } }
  @media (max-width: 767px) {
    .join { padding: 0 .75rem 5rem; min-height: 0; }
    .lanyard { width: 15rem; margin-left: -7.5rem; }
    .strap { height: 7rem; }
    .strap span + span { display: none; }
    .inv { width: 13.75rem; }
    .join { min-height: 0; }
    .j-perks { display: none; }
    .j-tab { height: 2.125rem; padding: 0 .875rem; font-size: .75rem; bottom: -1rem; }
    .j-big { display: flex; flex-direction: column; align-items: flex-start; padding-top: 36rem; margin-top: 0; font-size: 20vw; }
    .j-big span:last-child { align-self: flex-end; }
  }

  .cv { --red: #401f28; --ink: #1f1d1e; color: var(--ink); background: #fff; overflow-x: clip; font-family: var(--_typography---font--primary-family), sans-serif; }
  :global(body:not(.cv-dark) .nav_button_wrap) { color: #141414; border-color: rgb(20 20 20 / 20%) !important; }
  :global(body:not(.cv-dark) .nav_button_line) { background-color: #141414 !important; }
  .cv p, .cv h1, .cv ul { margin: 0; padding: 0; }
  .cv p::before, .cv p::after, .cv h1::before, .cv h1::after { content: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  /* titles: Freight Big Pro, exactly like the homepage headings */
  .ttl, .tick, .line { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); letter-spacing: var(--_typography---letter-spacing--tight, -.01em); }

  /* 1 · collage + growing photo (pinned) */
  .intro { position: relative; height: 520svh; background: #fff; }
  .stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .col { position: absolute; inset: 0; z-index: 1; }
  .cf, .slot { position: absolute; left: var(--mx, var(--x)); top: var(--my, var(--y)); width: var(--mw, var(--w)); height: var(--mh, var(--h)); }
  .cf { margin: 0; overflow: hidden; }
  .cf { will-change: transform, opacity; }
  .cf.faded img { opacity: .35; }
  .cf img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; }
  .slot { visibility: hidden; pointer-events: none; }
  .ttl { position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%); font-size: 9.375rem; line-height: 1; white-space: nowrap; color: var(--ink); }
  .vt-title { view-transition-name: concept-title; }
  :global(html.vt-in) .ttl { --heart-delay: 1.4s; }
  .meta { position: absolute; bottom: 1.75rem; z-index: 2; font-size: .9375rem; }
  .meta .clock { opacity: .5; }
  .m-l { left: var(--site--margin, 1.25rem); }
  .m-r { right: var(--site--margin, 1.25rem); }
  .b-pil :global(.button_main_text) { white-space: nowrap; }
  .b-pil { position: absolute; left: 50%; bottom: 1.25rem; transform: translateX(-50%); z-index: 2; white-space: nowrap; }
  .grow { position: absolute; inset: 0; z-index: 3; margin: 0; overflow: hidden; background: var(--red); will-change: clip-path; }
  .grow img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; display: block; transform-origin: 50% 50%; will-change: transform; }
  .dim { position: absolute; inset: 0; background: rgb(31 29 30 / 35%); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); opacity: 0; will-change: opacity; }

  /* 2 · pillars over the photo */
  .pil { position: absolute; inset: 0; z-index: 4; color: #fff; visibility: hidden; background: none; }
  .tick-wrap { position: absolute; left: 0; right: 0; bottom: calc(50% - .5rem); }
  .tick { display: flex; gap: 14vw; list-style: none; font-size: clamp(4.5rem, 8.3vw, 8.5rem); line-height: 1; white-space: nowrap; will-change: transform; }
  .tick .ode-title-heart { animation: none; }
  .tick .w { will-change: opacity; }
  .para { position: absolute; left: 50%; top: calc(50% + 2.5rem); width: 26rem; transform: translateX(-50%); font-size: .9375rem; line-height: 1.5; text-align: center; }
  .para p { position: absolute; top: 0; left: 0; right: 0; }

  /* no motion: everything shown in place, pillars listed on the photo */
  .still .intro { height: auto; }
  .still .stage { position: relative; height: auto; overflow: visible; }
  .still .col { position: relative; height: 100svh; }
  .still .grow { position: relative; height: 100svh; clip-path: none; }
  .still .dim { opacity: 1; }
  .still .pil { visibility: visible; top: 100svh; height: 100svh; }
  .still .tick { flex-direction: column; gap: .25rem; }
  .still .para, .still .slot { display: none; }

  @media (max-width: 767px) {
    .cf.hm { display: none; }
    .slot { --mx: 52%; --my: 13%; --mw: 40%; --mh: 30%; }
    .cf:nth-child(2) { --mx: 8%; --my: 19%; --mw: 34%; --mh: 22%; }
    .cf:nth-child(4) { --mx: 74%; --my: 57%; --mw: 22%; --mh: 13%; }
    .cf:nth-child(5) { --mx: -4%; --my: 49%; --mw: 22%; --mh: 14%; }
    .cf:nth-child(7) { --mx: 20%; --my: 60%; --mw: 38%; --mh: 20%; }
    .cf:nth-child(9) { --mx: 64%; --my: 72%; --mw: 24%; --mh: 13%; }
    .ttl { font-size: 4.375rem; }
    .meta { font-size: .8125rem; bottom: 5.25rem; }
    .tick-wrap { left: 0; bottom: calc(50% - .25rem); }
    .tick { font-size: 3.75rem; gap: 5rem; }
    .para { width: calc(100% - 2.5rem); top: calc(50% + 2rem); }
  }
</style>
