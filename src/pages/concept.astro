  const SCRUB      = 1;      // smoothing in seconds (higher = softer, true = instant)
  const START      = "top 100%";   // begins the moment the element touches the bottom of the viewport
  const END        = "bottom 0%";  // ends when the element's bottom leaves the top of the viewport
  const IN_END     = 0.45;   // fade-in spans 0% -> 45% of the range
  const OUT_START  = 0.55;   // fade-out spans 55% -> 100% of the range
  const STAGGER    = 0.5;    // 0 = all words together, 1 = fully one after another
  const DIRECTIONS = {
    "fade-up":    { x: 0,         y: DISTANCE },
    "fade-down":  { x: 0,         y: -DISTANCE },
    "fade-left":  { x: -DISTANCE, y: 0 },
    "fade-right": { x: DISTANCE,  y: 0 }
  };
  const hidden  = (x, y) => ({ opacity: 0, x, y, filter: `blur(${BLUR_START}px)` });
  const visible = { opacity: 1, x: 0, y: 0, filter: "blur(0px)" };
  function splitWords(el) {
    const text = el.textContent.trim();
    el.setAttribute("aria-label", text);
    el.textContent = "";
    return text.split(/\s+/).map((word, i, arr) => {
      const span = document.createElement("span");
      span.textContent = word;
      span.setAttribute("aria-hidden", "true");
      span.style.display = "inline-block";
      span.style.willChange = "opacity, filter";
      el.appendChild(span);
      if (i < arr.length - 1) el.appendChild(document.createTextNode(" "));
      return span;
    });
  }
  document.querySelectorAll("[data-anim]").forEach(el => {
    let type = el.dataset.anim || "fade-up";
    const split = type === "words" || el.dataset.split === "words";
    if (type === "words") type = "fade-up";
    const dir     = DIRECTIONS[type] || DIRECTIONS["fade-up"];
    const once    = el.dataset.once === "true";
    const delay   = parseFloat(el.dataset.delay) || 0;
    const stagger = el.dataset.stagger !== undefined ? parseFloat(el.dataset.stagger) : STAGGER;
    const targets = split ? splitWords(el) : [el];
    gsap.set(targets, hidden(dir.x, dir.y));
    // Old behaviour: simple one-time fade in (no scrub, no out)
    if (once) {
      ScrollTrigger.create({
        trigger: el,
        start: "top 95%",
        once: true,
        onEnter: () => gsap.to(targets, {
          ...visible, duration: 1.2, ease: "power1.out", delay,
          stagger: split ? 0.06 : 0, overwrite: true
        })
      });
      return;
    }
    // Scrubbed timeline: fade in -> hold -> fade out, tied to scroll progress (0..1)
    const n       = targets.length;
    const inDur   = IN_END;
    const outDur  = 1 - OUT_START;
    const inEach  = n > 1 ? (inDur * stagger) / (n - 1) : 0;
    const outEach = n > 1 ? (outDur * stagger) / (n - 1) : 0;
    const inWord  = inDur - inEach * (n - 1);
    const outWord = outDur - outEach * (n - 1);
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: el,
        start: START,
        end: END,
        scrub: SCRUB
      }
    });
    tl.fromTo(targets, hidden(dir.x, dir.y), {
        ...visible,
        duration: inWord,
        ease: "none",          // linear = gradual, no sudden speed-up
        stagger: inEach
      }, 0)
      .to(targets, {
        ...hidden(dir.x, dir.y),   // fades out in place (no upward movement)
        duration: outWord,
        ease: "none",
        stagger: outEach,
        immediateRender: false
      }, OUT_START);
  });
});
</script>
  </Fragment>
</BaseLayout>
