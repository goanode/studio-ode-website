                                  <div data-wf--content-wrapper--variant="left" style="" class="u-content-wrapper w-variant-e85a4315-14bc-e5ef-0d3e-2c8c9ed7d2f1">
                                    <div class="u-display-contents">
                                      <div data-number="20" data-wf--typography-heading--variant="h4" data-wf-component-id="b9130e59-aa4e-07ef-a822-eda529bf75ca" data-wf-variant-state="7c7eb163-b37d-338d-2369-5eae7e6d458a" class="u-heading w-variant-7c7eb163-b37d-338d-2369-5eae7e6d458a w-richtext">
                                        <h2><strong>Un groupe qui te porte</strong></h2>
                                      </div>
                                      <div data-number="60" data-wf--typography-paragraph--variant="inherit" class="u-text u-rich-text w-richtext">
