---
import BaseLayout from "../layouts/BaseLayout.astro";
import FigureHero from "../components/FigureHero.astro";
import LinkButton from "../components/LinkButton.astro";
import WaitlistModal from "../components/WaitlistModal.astro";

const IMG_A = "/images/please-look-at-the-first-pose----820406-SN7";
const IMG_B = "/images/please-keep-the-background--the-233555-iP0";
const IMG_C = "/images/ea27f15c4ddd5e50ea8bd0309f3aae76";
const srcset = (b: string) => `${b}-p-500.webp 500w, ${b}-p-800.webp 800w, ${b}.webp 1024w`;

const pillars = [
  ["Notre histoire", "Ode est né d'une envie simple : créer à Lille un studio où chaque femme peut découvrir la pole dance sans pression, à son rythme. Un lieu calme, lumineux, pensé autour du mouvement et de la confiance en soi."],
  ["Force", "Un renforcement progressif du dos, des épaules et du gainage, cours après cours."],
  ["Souplesse", "Des séances dédiées pour gagner en amplitude et protéger ton corps sur le long terme."],
  ["Expression", "La barre comme langage : des lignes, du flow et de la musicalité."],
  ["Communauté", "Des petits groupes bienveillants, où l'on progresse ensemble, sans jugement."],
];
const pad = (n: number) => String(n).padStart(2, "0");
---

<!-- Home page id: same hero load animation as the homepage and /figures -->
<BaseLayout title="Concept — Studio Ode" description="Le concept du studio de pole dance Ode, à Lille." wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <main id="main" class="page_main">
    <FigureHero title="Concept" image={IMG_C} />

    <div class="cp-body">
      <!-- About: centred statement, two overlapping photos, short text -->
      <section class="cp-about">
        <div class="u-eyebrow-wrapper cp-eb"><div class="u-eyebrow-layout"><div class="u-eyebrow-marker"></div><div class="u-eyebrow-text w-richtext"><p>À propos</p></div></div></div>
        <h2 class="cp-serif cp-title">Un studio construit sur le mouvement, la force et la lumière</h2>
        <div class="cp-duo">
          <figure class="cp-a"><img src={`${IMG_A}.webp`} srcset={srcset(IMG_A)} sizes="(max-width: 767px) 50vw, 25vw" alt="Danseuse à la barre" loading="lazy" /></figure>
          <figure class="cp-b"><img src={`${IMG_B}.webp`} srcset={srcset(IMG_B)} sizes="(max-width: 767px) 65vw, 25vw" alt="Danseuse en figure inversée" loading="lazy" /></figure>
          <div class="cp-txt">
            <p>Ode ouvre à Lille un espace pensé pour la pole dance, la souplesse et le renforcement. Des cours en petits groupes, une professeure attentive, et un programme clair, de la première rotation aux inversions.</p>
            <LinkButton href="/figures" label="Découvrir les figures →" />
          </div>
        </div>
      </section>

      <!-- Numbered index + photo -->
      <section class="cp-idx">
        <ol>
          {pillars.map(([t, d], i) => (
            <li>
              <span class="cp-n">({pad(i + 1)}.)</span>
              <div><h3 class="cp-serif">{t}</h3><p>{d}</p></div>
            </li>
          ))}
        </ol>
        <figure class="cp-ph"><img src={`${IMG_A}.webp`} srcset={srcset(IMG_A)} sizes="(max-width: 767px) 100vw, 25vw" alt="" loading="lazy" /></figure>
      </section>
    </div>
  </main>

  <WaitlistModal slot="after-footer" />
</BaseLayout>

<style>
  .cp-body { position: relative; z-index: 1; background: var(--_theme---background, #fff); padding-top: 1px; }
  .cp-serif { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); }
  .cp-about, .cp-idx { width: calc(100% - var(--site--margin) * 2); max-width: var(--max-width--main); margin: 0 auto; }
  /* about */
  .cp-about { padding: 7.5rem 0; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .cp-eb { margin: 0 0 1.75rem; }
  .cp-title { margin: 0; max-width: 62rem; font-size: clamp(2.75rem, 5.4vw, 5rem); line-height: 1.1; letter-spacing: -.01em; color: var(--swatch--dark-800); text-wrap: balance; }
  .cp-duo { width: 100%; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; align-items: end; margin-top: 7rem; text-align: left; }
  .cp-duo figure { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius--main); background: var(--swatch--dark-800); }
  .cp-duo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale .9s cubic-bezier(.2, .7, .2, 1); }
  .cp-duo figure:hover img { scale: 1.04; }
  .cp-a { grid-row: 1; grid-column: 3 / 6; aspect-ratio: 3 / 4; z-index: 1; transform: translateY(-3rem); }
  .cp-a img { object-position: 50% 25%; }
  .cp-b { grid-row: 1; grid-column: 5 / 8; aspect-ratio: 4 / 5; margin-left: -2.5rem; }
  .cp-b img { object-position: 50% 35%; }
  .cp-txt { grid-row: 1; grid-column: 9 / 12; display: flex; flex-direction: column; align-items: flex-start; gap: 1.25rem; padding-bottom: .75rem; }
  .cp-txt p { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--swatch--dark-800); }
  /* index */
  .cp-idx { padding: 3rem 0 9rem; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; align-items: start; }
  .cp-idx ol { grid-column: 1 / 8; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2.5rem; }
  .cp-idx li { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); column-gap: 1.5rem; }
  .cp-n { grid-column: 1 / 3; padding-top: .5rem; font-size: .8125rem; color: var(--swatch--dark-800); opacity: .6; }
  .cp-idx li div { grid-column: 3 / 8; }
  .cp-idx h3 { margin: 0 0 .75rem; line-height: 1.2; font-size: 1.75rem; line-height: 1.15; color: var(--swatch--dark-900); }
  .cp-idx p { margin: 0; max-width: 30rem; font-size: 1rem; line-height: 1.6; color: var(--swatch--dark-800); }
  .cp-ph { grid-column: 9 / 13; position: sticky; top: 1.5rem; margin: 0; aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius--main); background: var(--swatch--dark-800); }
  .cp-ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 60% 40%; filter: grayscale(1); }
  @media (max-width: 767px) {
    .cp-about { padding: 4.5rem 0; }
    .cp-duo { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: .75rem; margin-top: 3rem; }
    .cp-a { grid-column: 1 / 4; transform: translateY(-1.5rem); }
    .cp-b { grid-column: 3 / 7; margin-left: 0; }
    .cp-txt { grid-row: 2; grid-column: 1 / -1; padding-top: 2rem; }
    .cp-idx { grid-template-columns: 1fr; padding: 1rem 0 5rem; }
    .cp-idx ol, .cp-ph { grid-column: 1 / -1; }
    .cp-ph { position: relative; top: 0; margin-top: 2.5rem; }
    .cp-idx li { grid-template-columns: 3rem minmax(0, 1fr); column-gap: .75rem; }
    .cp-n, .cp-idx li div { grid-column: auto; }
    .cp-idx h3 { font-size: 1.5rem; }
  }
</style>
