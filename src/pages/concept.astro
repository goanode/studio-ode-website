---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
// Concept page (design W1, after the "Reviews" reference): big title with small offset labels,
// a tall photo in the middle and one statement on each side.
---

<BaseLayout title="Concept — Studio Ode" description="Le concept du studio de pole dance Ode, à Lille." wfPage="6adb80ddd07ffba4e0c0cb69">
  <main id="main" class="page_main rv">
    <section class="hero">
      <div class="tb"><div class="tb-in"><p class="tag wine tb-l">Studio Ode</p><h1 class="tb-title">Concept</h1><p class="tag wine tb-r">à Lille</p></div>
        <p class="tag sub">Un studio de pole dance pour bouger,<br />se renforcer et s'exprimer.</p>
      </div>
      <p class="tag edge l">Ouverture</p><p class="tag edge r">2027</p>
    </section>
    <div class="trio">
      <div class="col">
        <p class="tag soft">Force</p>
        <p class="st"><em>Pas besoin d'être forte</em><br />pour commencer.<br />On le devient.</p>
        <div class="stat"><p class="num">8</p><p class="tag soft">élèves max par cours</p></div>
      </div>
      <figure class="ph ph-main"><img src="/images/Hello-please-take-the-style-of-t-11755-EU2.webp" alt="Élève à la barre au studio Ode" style="object-position: 50% 30%" /></figure>
      <div class="col">
        <p class="tag soft">Expression</p>
        <p class="st"><em>La barre devient</em><br />un langage,<br />à ton rythme.</p>
        <div class="stat"><img class="ava" src="/images/ea27f15c4ddd5e50ea8bd0309f3aae76.webp" alt="" loading="lazy" /><p class="tag soft">Justine L., fondatrice</p></div>
      </div>
    </div>

    <section class="sec">
      <div class="tb" style="margin-bottom: 3.5rem"><div class="tb-in"><p class="tag wine tb-l">Petits</p><h2 class="tb-title">Ensemble</h2><p class="tag wine tb-r">groupes</p></div></div>
      <div class="duo">
        <figure class="ph ph-side"><img src="/images/please-look-at-the-first-pose----265877-w4L.webp" alt="Élève au studio" loading="lazy" style="object-position: 50% 35%" /></figure>
        <div class="col">
          <p class="tag soft">Communauté</p>
          <p class="st"><em>On progresse ensemble,</em><br />sans jamais<br />se comparer.</p>
          <div class="stat"><p class="num">4</p><p class="tag soft">types de cours</p></div>
        </div>
        <figure class="ph ph-side low"><img src="/images/Hello-please-take-the-style-of-t-391374-HCn.webp" alt="Figure de force à la barre" loading="lazy" style="object-position: 50% 30%" /></figure>
      </div>
    </section>

    <section class="end">
      <div class="tb-in"><p class="tag wine tb-l">Liste</p><h2 class="tb-title">Rejoins-nous</h2><p class="tag wine tb-r">d'attente</p></div>
      <p class="tag soft">Ode ouvre bientôt ses portes.<br />Sois prévenue en premier.</p>
      <button type="button" class="pill" data-modal-trigger="waitlist">Rejoins la liste d'attente →</button>
    </section>
  </main>
  <WaitlistModal slot="after-footer" />
</BaseLayout>

<style>
  .rv { font-family: var(--_typography---font--primary-family), sans-serif; color: #1f1d1e; background: #fff; overflow-x: clip; padding-top: calc(var(--nav--height-total, 6rem) + 1.5rem); }
  :global(.nav_button_wrap) { color: #141414; border-color: rgb(20 20 20 / 20%) !important; }
  :global(.nav_button_line) { background-color: #141414 !important; }
  .rv p, .rv h1, .rv h2 { margin: 0; }
  .rv p::before, .rv p::after, .rv h1::before, .rv h1::after, .rv h2::before, .rv h2::after { content: none !important; display: none !important; }
  .tag { font-size: .6875rem; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; line-height: 1.25; }
  .soft { opacity: .6; }
  .wine { color: #842636; }
  .hero { position: relative; padding-top: 1rem; }
  .tb { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 var(--site--margin, 3rem); }
  .tb-in { position: relative; display: inline-block; }
  .tb-title { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(4rem, 10.4vw, 9.5rem); line-height: .9; letter-spacing: -.01em; text-transform: uppercase; }
  .tb-l { position: absolute; left: -.875rem; top: -.25rem; transform: translateX(-100%); white-space: nowrap; }
  .tb-r { position: absolute; right: -.875rem; bottom: .125rem; transform: translateX(100%); white-space: nowrap; }
  .sub { margin-top: 2.5rem !important; opacity: .7; }
  .edge { position: absolute; bottom: 0; opacity: .55; }
  .edge.l { left: 3rem; } .edge.r { right: 3rem; }
  .trio { display: grid; grid-template-columns: 1fr minmax(0, 21rem) 1fr; gap: 3rem; align-items: center; padding: 1.75rem 3rem 0; }
  .col { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2.5rem; padding: 0 1.5rem; }
  .st { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(1.75rem, 2.8vw, 2.5rem); line-height: 1.15; }
  .st em { font-style: normal; color: #842636; }
  .stat { display: flex; flex-direction: column; align-items: center; gap: .375rem; }
  .num { font-family: var(--_typography---font--secondary-family); font-size: 2.5rem; line-height: 1; color: #842636; }
  .ava { width: 2.125rem; height: 2.125rem; border-radius: 9999px; object-fit: cover; }
  .ph { position: relative; margin: 0; overflow: hidden; background: #842636; }
  .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 1.1s cubic-bezier(.2, .7, .2, 1); }
  .ph:hover img { scale: 1.03; }
  .ph-main { width: 100%; aspect-ratio: 333 / 630; }
  .sec { padding-top: 10rem; }
  .duo { display: grid; grid-template-columns: minmax(0, 21rem) 1fr minmax(0, 21rem); gap: 3rem; align-items: center; padding: 0 3rem; }
  .ph-side { width: 100%; aspect-ratio: 333 / 500; }
  .ph-side.low { margin-top: 7.5rem; }
  .end { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 2rem; padding: 10rem 3rem 8.75rem; }
  .pill { height: 3rem; display: inline-flex; align-items: center; padding: 0 1.5rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: none; font-family: inherit; font-size: 1rem; font-weight: 500; color: #3b3b3b; cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .pill:hover { background: #3b3b3b; border-color: #3b3b3b; color: #fff; }
  .pill:focus-visible { outline: 2px solid #1f1d1e; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .ph img { transition: none; } }
  @media (max-width: 767px) {
    .tb { padding: 0 1rem; }
    .tb-title { font-size: 16vw; }
    .tb-in { display: flex; flex-direction: column; align-items: center; }
    .tb-l, .tb-r { position: static; transform: none; margin: .375rem 0; }
    .edge { display: none; }
    .sub { margin-top: 1.25rem !important; }
    .trio, .duo { grid-template-columns: 1fr; gap: 2.5rem; padding: 2rem 1rem 0; }
    .trio .ph, .duo .ph { width: 72%; margin: 0 auto; }
    .trio > .ph { order: -1; }
    .duo > .ph.low { display: none; }
    .st { font-size: 1.75rem; }
    .sec { padding-top: 6rem; }
    .end { padding: 6rem 1rem 5rem; }
  }
</style>
