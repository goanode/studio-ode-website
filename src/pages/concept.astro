---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
const LAYOUTS = [{"main": {"x": 1.3, "y": 27, "w": 41, "h": 66}, "img": 2, "side": 3, "title": 0, "t": [{"x": 52, "y": 10, "w": 30, "h": 58}, {"x": 84, "y": 48, "w": 14.5, "h": 30}], "cap": ["Le studio", "Lille, 2027"], "para": {"x": 52, "y": 74, "w": 30, "al": "left", "t": "Ode est un studio de pole dance à Lille, pensé pour bouger, se renforcer et s'exprimer. Chaque cours repose sur quatre piliers : la force, la souplesse, l'expression et la communauté."}}, {"main": {"x": 1.3, "y": 30, "w": 36, "h": 63}, "img": 4, "side": 9, "title": 0, "t": [{"x": 50, "y": 4, "w": 43, "h": 90}, {"x": 110, "y": 40, "w": 14, "h": 28, "o": 0}], "cap": ["La force", "Renforcement"], "para": {"x": 39, "y": 72, "w": 9.5, "al": "left", "t": "Un renforcement progressif du dos, des épaules et du gainage, cours après cours."}}, {"main": {"x": 26, "y": 29, "w": 40, "h": 66}, "img": 7, "side": 0, "title": 0, "t": [{"x": 72, "y": 10, "w": 21.5, "h": 46}, {"x": -20, "y": 40, "w": 14, "h": 28, "o": 0}], "cap": ["La souplesse", "Flexibility"], "para": {"x": 2, "y": 60, "w": 20, "al": "left", "t": "Des séances dédiées pour gagner en amplitude tout en protégeant ton dos. La souplesse se travaille avec patience, elle ne se force jamais."}}, {"main": {"x": 1.3, "y": 27, "w": 47, "h": 63}, "img": 6, "side": 3, "title": 0, "t": [{"x": 50.3, "y": 27, "w": 47, "h": 63}, {"x": 110, "y": 40, "w": 14, "h": 28, "o": 0}], "cap": ["L'expression", "Poledance flow"], "para": {"x": 66, "y": 12, "w": 27, "al": "right", "t": "La barre devient un langage : des lignes, du flow, ta musique. Chaque élève trouve sa propre façon de bouger."}}, {"main": {"x": 50, "y": 27, "w": 41, "h": 63}, "img": 1, "side": 8, "title": 0, "t": [{"x": 1.3, "y": 8, "w": 32, "h": 56}, {"x": -20, "y": 40, "w": 14, "h": 28, "o": 0}], "cap": ["La communauté", "Petits groupes"], "para": {"x": 1.3, "y": 70, "w": 28, "al": "left", "t": "Des petits groupes bienveillants, où l'on s'encourage et où l'on progresse ensemble, sans jamais se comparer."}}];
const IMAGES = ["/images/37165de30ebb4909ab52aaa06a86c422.avif", "/images/7053819a90a239bb9f6686d8d1df9a9d.webp", "/images/Hello-please-take-the-style-of-t-11755-EU2.webp", "/images/Hello-please-take-the-style-of-t-329741-ZHu.webp", "/images/Hello-please-take-the-style-of-t-391374-HCn.webp", "/images/a919359daba17134b7c9ce30dbfe9490.avif", "/images/ac743b8e553553c0be56bc5dbaabf5b6.avif", "/images/ea27f15c4ddd5e50ea8bd0309f3aae76.webp", "/images/f830ef2fd533f1f45b6d4d1beba1face.avif", "/images/please-look-at-the-first-pose----265877-w4L.webp"];
const THUMBS = [3, 0];
const first = LAYOUTS[0];
---

<BaseLayout title="Concept — Studio Ode" description="Le concept du studio de pole dance Ode, à Lille." wfPage="6adb80ddd07ffba4e0c0cb69">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" />
  </Fragment>
  <main id="main" class="page_main cw">
    <!-- Animated editorial grid ("Wide" style): 5 layouts that rearrange automatically -->
    <section class="cw-stage" id="cw-stage" aria-roledescription="carrousel" aria-label="Le concept Ode">
      <span class="cw-lab" style="left: 0; top: .6%">SR</span><span class="cw-lab" style="left: 1.9%; top: 1.6%">ODE</span>
      <span class="cw-lab cw-hide-m" style="left: 39.5%; top: .6%">STUDIO<sup>™</sup></span>
      <span class="cw-lab" style="right: 2.6%; top: 1.6%">LILLE</span><span class="cw-lab" style="right: 0; top: .6%">©-’27</span>
      <span class="cw-lab" style="right: 2.6%; bottom: 1.6%">LA</span><span class="cw-lab" style="right: 0; bottom: .6%">VOL.01</span>
      <span class="cw-lab cw-move cw-hide-m" data-el="enjoy">ENJOY</span>
      <span class="cw-lab cw-move cw-hide-m" data-el="vibes">VIBES</span>
      <span class="cw-lab cw-hide-m" style="right: 0; top: 29%" data-el="count">1—4</span>

      <h1 class="cw-title cw-move" data-el="title">CONCEPT<b class="cw-badge" data-el="badge" aria-hidden="true">R</b></h1>
      <div class="cw-slot cw-main cw-move" data-el="main"><img src={IMAGES[first.img]} alt="Élève au studio Ode" /></div>
      <div class="cw-cap cw-move" data-el="cap"><span data-el="captext">{first.cap[0]}<br />{first.cap[1]}</span><span>05.08.2027</span></div>
      {THUMBS.map((k, i) => <div class="cw-slot cw-move cw-thumb" data-thumb={i}><img src={IMAGES[k]} alt="" loading="lazy" /></div>)}
      <p class="cw-para cw-move" data-el="para" aria-live="polite">{first.para.t}</p>
      <div class="cw-arrows"><button type="button" data-dir="-1" aria-label="Précédent">←</button><button type="button" data-dir="1" aria-label="Suivant">→</button></div>
    </section>

    <section class="cw-below">
      <h2>Concept<br />Vol.01</h2>
      <div class="cw-bt">
        <p>Ode ouvre bientôt ses portes à Lille. Un studio lumineux, pensé pour la pole dance, la souplesse et le renforcement, où chaque cours est construit pour te faire progresser en confiance.</p>
        <p>Des groupes de huit élèves maximum, un programme clair de la première rotation aux inversions, et une ambiance où l'on vient pour soi, jamais pour se comparer.</p>
        <button type="button" class="cw-cta" data-modal-trigger="waitlist">Rejoins la liste d'attente →</button>
      </div>
    </section>
  </main>
  <WaitlistModal slot="after-footer" />
</BaseLayout>

<script define:vars={{ LAYOUTS, IMAGES, THUMBS }}>
  const stage = document.getElementById("cw-stage");
  const q = (k) => stage.querySelector(`[data-el="${k}"]`);
  const thumbs = [...stage.querySelectorAll("[data-thumb]")];
  const mainImg = q("main").querySelector("img");
  const mobile = () => window.matchMedia("(max-width: 767px)").matches;
  let i = 0, timer;
  const box = (el, b) => Object.assign(el.style, { left: b.x + "%", top: b.y + "%", width: b.w + "%", height: b.h + "%", opacity: b.o === 0 ? 0 : 1 });
  function apply(n) {
    const l = LAYOUTS[n], m = l.main;
    if (!mobile()) {
      box(q("main"), m);
      thumbs.forEach((t, k) => box(t, l.t[k]));
      // title is sized to the main photo's width; place it just above the photo whatever the stage height
      const W = stage.clientWidth, H = stage.clientHeight, fs = 0.0019 * m.w * W;
      const tTop = (m.y / 100) * H - 0.8 * fs - 0.02 * H;
      Object.assign(q("title").style, { left: m.x + "%", top: tTop + "px", fontSize: fs + "px" });
      Object.assign(q("cap").style, { left: m.x + "%", top: (m.y + m.h + 2.4) + "%", width: m.w + "%" });
      Object.assign(q("enjoy").style, { left: (m.x + m.w + 1.3) + "%", top: (tTop + 0.1 * fs) + "px" });
      Object.assign(q("vibes").style, { left: (m.x + m.w + 1.3) + "%", top: (m.y + 3) + "%", opacity: l.t.some((t) => t.o !== 0 && Math.abs(t.x - (m.x + m.w)) < 4 && t.y < m.y + 6 && t.y + t.h > m.y + 3) ? 0 : 1 });
      Object.assign(q("para").style, { left: l.para.x + "%", top: l.para.y + "%", width: l.para.w + "%", textAlign: l.para.al });
    } else {
      [q("main"), q("title"), q("cap"), q("para"), ...thumbs].forEach((e) => e.removeAttribute("style"));
    }
    thumbs[0].querySelector("img").src = IMAGES[l.side ?? THUMBS[0]];
    const src = IMAGES[l.img];
    mainImg.src = src;
    q("title").style.backgroundImage = `url("${src}")`;
    q("badge").style.display = n >= 2 && n <= 3 ? "" : "none";
    q("captext").innerHTML = `${l.cap[0]}<br>${l.cap[1]}`;
    q("para").textContent = l.para.t;
    q("count").textContent = "1—" + (n + 4);
  }
  const go = (d) => { i = (i + d + LAYOUTS.length) % LAYOUTS.length; apply(i); };
  const start = () => { clearInterval(timer); if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) timer = setInterval(() => go(1), 4000); };
  stage.querySelectorAll("[data-dir]").forEach((b) => b.addEventListener("click", () => { go(Number(b.dataset.dir)); start(); }));
  window.addEventListener("resize", () => apply(i));
  apply(0); start();
</script>

<style>
  .cw { font-family: "Archivo", var(--_typography---font--primary-family), sans-serif; color: #141414; background: #fbf9f1; }
  .cw-stage { position: relative; width: 100%; height: calc(100svh - var(--nav--height-total, 6rem) - 2.5rem); min-height: 38rem; max-height: 62rem; overflow: hidden; margin-top: calc(var(--nav--height-total, 6rem) + 2.5rem); }
  /* light page: dark menu button */
  :global(.nav_button_wrap) { color: #141414; border-color: rgb(20 20 20 / 20%) !important; }
  :global(.nav_button_line) { background-color: #141414 !important; }
  .cw-lab { position: absolute; z-index: 5; font-size: .6875rem; font-weight: 600; letter-spacing: -.01em; text-transform: uppercase; line-height: 1.05; }
  .cw-lab sup { font-size: .5625rem; vertical-align: top; }
  .cw-move { transition: left 1.1s cubic-bezier(.75, 0, .2, 1), top 1.1s cubic-bezier(.75, 0, .2, 1), width 1.1s cubic-bezier(.75, 0, .2, 1), height 1.1s cubic-bezier(.75, 0, .2, 1), font-size 1.1s cubic-bezier(.75, 0, .2, 1), opacity .6s; }
  .cw-slot { position: absolute; overflow: hidden; }
  .cw-slot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cw-main { z-index: 2; }
  .cw-title { position: absolute; z-index: 3; margin: 0; font-family: "Archivo", sans-serif; font-weight: 900; font-stretch: 125%; line-height: .74; letter-spacing: -.045em; white-space: nowrap; color: transparent; -webkit-background-clip: text; background-clip: text; background-size: cover; background-position: 50% 30%; transform-origin: 0 0; transform: scaleX(1.15); }
  .cw-badge { position: absolute; left: 100%; margin-left: -.45em; top: -.55em; font-size: .22em; font-stretch: 100%; -webkit-text-fill-color: #1d4a32; color: #1d4a32; border: 2px solid #1d4a32; border-radius: 9999px; padding: .05em .35em; line-height: 1; letter-spacing: 0; transform: scaleX(.87); transform-origin: 0 0; }
  .cw-cap { position: absolute; z-index: 4; display: flex; justify-content: space-between; gap: .75rem; font-size: .6875rem; font-weight: 600; text-transform: uppercase; line-height: 1.05; }
  .cw-para { position: absolute; z-index: 4; margin: 0; font-size: .6875rem; font-weight: 600; text-transform: uppercase; line-height: 1.2; }
  .cw-arrows { position: absolute; z-index: 6; right: 2.2%; top: 14.4%; display: flex; gap: .625rem; }
  .cw-arrows button { background: none; border: 0; padding: .125rem; font-size: 1rem; color: inherit; cursor: pointer; transition: opacity .2s; }
  .cw-arrows button:hover { opacity: .5; }
  .cw-arrows button:focus-visible { outline: 2px solid #141414; outline-offset: 3px; }
  .cw-below { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; padding: 7.5rem 1.3% 10rem; border-top: 1px solid rgb(20 20 20 / 12%); }
  .cw-below h2 { grid-column: 1 / 8; margin: 0; font-family: "Archivo", sans-serif; font-weight: 900; font-stretch: 125%; font-size: clamp(3rem, 7vw, 7rem); line-height: .85; letter-spacing: -.045em; text-transform: uppercase; }
  .cw-bt { grid-column: 8 / 12; align-self: end; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .cw-bt p { margin: 0; font-size: .6875rem; font-weight: 600; text-transform: uppercase; line-height: 1.2; }
  .cw-cta { grid-column: 1 / -1; justify-self: start; margin-top: 1rem; padding: 0 0 .25rem; background: none; border: 0; border-bottom: 1px solid #141414; font: inherit; font-size: .75rem; font-weight: 600; text-transform: uppercase; color: inherit; cursor: pointer; }
  /* Phone: same pieces, stacked */
  @media (max-width: 767px) {
    .cw-stage { aspect-ratio: auto; max-height: none; min-height: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; padding: 3rem 1rem 3.5rem; overflow: visible; }
    .cw-hide-m { display: none; }
    .cw-title { position: relative; grid-column: 1 / -1; font-size: 15vw; transform: scaleX(1.12); margin-top: 1rem; }
    .cw-badge { display: none !important; }
    .cw-main { position: relative; grid-column: 1 / -1; aspect-ratio: 4 / 5; }
    .cw-cap { position: relative; grid-column: 1 / -1; margin-top: .25rem; }
    .cw-para { position: relative; grid-column: 1 / -1; margin: 1.25rem 0; font-size: .75rem; }
    .cw-thumb { position: relative; aspect-ratio: 3 / 4; }
    .cw-thumb:nth-child(n+0) { opacity: 1; }
    .cw-arrows { position: relative; grid-column: 1 / -1; right: auto; top: auto; justify-content: flex-end; order: 2; }
    .cw-below { grid-template-columns: 1fr; padding: 4.5rem 1rem 6rem; }
    .cw-below h2, .cw-bt { grid-column: 1 / -1; }
    .cw-bt { grid-template-columns: 1fr; margin-top: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cw-move { transition: none; } }
</style>
