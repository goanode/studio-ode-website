---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
// Concept page (design X1, after the Echoraid reference): homepage hero with STORY,
// course list with a matching photo, a big statement and a staggered text/photo grid.
---

<BaseLayout title="Story — Studio Ode" description="Le concept et l'histoire du studio de pole dance Ode, à Lille." wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <main id="main" class="page_main">
    <section slide-down="" data-wf--section--variant="100svh" data-w-id="9cd849af-5c85-da69-3983-2e49dba72900" class="u-section w-variant-f69fa043-d68c-1f67-d426-c93e24510eb4 u-padding-bottom-0 u-theme-dark">
      <div class="u-background-slot">
        <div tlg-fluted-glass-canvas="" tlg-fluted-glass-mode="scroll" tlg-fluted-glass-segments="60" class="keypoints_visual_wrap"><img class="keypoints_visual_img" src="/images/please-keep-the-background--the-233555-iP0.webp" alt="" sizes="(max-width: 939px) 100vw, 939px" loading="eager" srcset="/images/please-keep-the-background--the-233555-iP0-p-500.webp 500w, /images/please-keep-the-background--the-233555-iP0-p-800.webp 800w, /images/please-keep-the-background--the-233555-iP0.webp 939w" tlg-fluted-glass-image=""></div>
        <div data-wf--media-overlay--variant="gradient" data-number="20" class="u-overlay w-variant-9653c0cc-21fc-fb82-1373-c98b1644e5a8"></div>
      </div>
      <div class="u-container w-variant-f69fa043-d68c-1f67-d426-c93e24510eb4">
        <div data-wf--layout--variant="breakout-reversed" class="u-layout-wrapper w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7">
          <div class="u-layout w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7">
            <div class="u-layout-column-1 w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7 u-padding-bottom-0">
              <div data-wf--content-wrapper--variant="right" style="" class="u-content-wrapper w-variant-405b6754-709a-81de-bf32-f0102c0c7aa2">
                <div class="u-display-contents">
                  <div fade-in="" data-number="40" data-wf--typography-paragraph--variant="text-main" class="u-text w-variant-61d538b2-709c-eb7a-4258-8c0890dc07fc u-rich-text w-richtext">
                    <p>Ode est un studio de pole dance à Lille, pensé pour bouger, se renforcer et s’exprimer. Voici d’où il vient.</p>
                  </div>
                  <div fade-in="" class="u-button-wrapper">
                    <div class="u-display-contents">
                      <div data-wf--button-main--variant="secondary" data-trigger="hover focus" class="button_main_wrap">
                        <div data-wf--clickable--variant="focus-ring-outside" class="clickable_wrap u-cover-absolute"><button type="button" aria-label="Rejoins la liste d&#x27;attente" data-modal-trigger="waitlist" class="clickable_btn"></button></div>
                        <div data-button="" class="button_main_element w-variant-e85564cd-af30-a478-692b-71732aefb3ab">
                          <div aria-hidden="true" class="button_main_text u-text-style-main">Rejoins la liste d&#x27;attente</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="u-layout-column-2 w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7  ">
              <div data-wf--content-wrapper--variant="left" style="" class="u-content-wrapper w-variant-e85a4315-14bc-e5ef-0d3e-2c8c9ed7d2f1">
                <div class="u-display-contents">
                  <h1 class="heading cx-story">STORY</h1>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <div class="cx">
      <section class="cx-list">
        <span class="cx-br cx-acc">Cours</span>
        <ul class="cx-items"><li class="is-on">Poledance technique<sup>[04]</sup></li><li class="">Flow &amp; balance<sup>[03]</sup></li><li class="">Flexibilité<sup>[02]</sup></li><li class="">Renforcement<sup>[02]</sup></li><li class="">Chorégraphie<sup>[01]</sup></li></ul>
        <figure class="cx-lp" aria-hidden="true"><img class="is-on" src="/images/Hello-please-take-the-style-of-t-391374-HCn.webp" alt="" loading="lazy" /><img class="" src="/images/ac743b8e553553c0be56bc5dbaabf5b6.avif" alt="" loading="lazy" /><img class="" src="/images/Hello-please-take-the-style-of-t-329741-ZHu.webp" alt="" loading="lazy" /><img class="" src="/images/7053819a90a239bb9f6686d8d1df9a9d.webp" alt="" loading="lazy" /><img class="" src="/images/f830ef2fd533f1f45b6d4d1beba1face.avif" alt="" loading="lazy" /></figure>
      </section>

      <section class="cx-stm">
        <span class="cx-br cx-acc">Notre idée</span>
        <p class="cx-big">Pas besoin d'être forte.<br />On le devient ensemble.</p>
      </section>

      <section class="cx-mos">
        <p class="cx-tx" style="grid-column: 1 / 4; grid-row: 1; align-self: end"><b>Pourquoi Ode ?</b><br />Une ode, c'est un hommage. Le nôtre va au mouvement, à la force qu'on découvre et au plaisir de danser.<br /><br />Petits groupes, huit élèves maximum, une professeure qui connaît chaque corps.</p>
        <figure class="cx-ph" style="grid-column: 6 / 9; grid-row: 1; aspect-ratio: 1"><img src="/images/Hello-please-take-the-style-of-t-391374-HCn.webp" alt="Figure de force à la barre" loading="lazy" /></figure>
        <figure class="cx-ph" style="grid-column: 10 / 13; grid-row: 1; aspect-ratio: 1; margin-top: -2.5rem"><img src="/images/please-look-at-the-first-pose----265877-w4L.webp" alt="Élève au studio" loading="lazy" style="object-position: 50% 35%" /></figure>
        <figure class="cx-ph" style="grid-column: 1 / 4; grid-row: 2; aspect-ratio: 4 / 3; margin-top: 2.5rem"><img src="/images/ac743b8e553553c0be56bc5dbaabf5b6.avif" alt="Élève en mouvement" loading="lazy" /></figure>
        <p class="cx-tx" style="grid-column: 6 / 9; grid-row: 2; margin-top: 2.5rem"><b>Ode</b> est un studio de pole dance à Lille.<br /><b>On avance pas à pas</b> : technique, souplesse, renforcement.<br /><b>Chaque cours</b> laisse de la place à l'expression.</p>
        <figure class="cx-ph" style="grid-column: 10 / 13; grid-row: 2; aspect-ratio: 3 / 4; margin-top: 2.5rem"><img src="/images/Hello-please-take-the-style-of-t-329741-ZHu.webp" alt="Chorégraphie au studio" loading="lazy" /></figure>
      </section>

      <div class="cx-more"><button type="button" data-modal-trigger="waitlist"><span>[</span><span>Rejoins la liste d'attente</span><span>]</span></button></div>
    </div>
  </main>
  <WaitlistModal slot="after-footer" />
</BaseLayout>

<script>
  // Course list: hovering (or focusing) a course swaps the photo beside it.
  const list = document.querySelector<HTMLElement>(".cx-list");
  if (list) {
    const lis = [...list.querySelectorAll("li")];
    const imgs = [...list.querySelectorAll<HTMLImageElement>(".cx-lp img")];
    lis.forEach((li, i) => {
      li.tabIndex = 0;
      const show = () => { lis.forEach((l, j) => l.classList.toggle("is-on", i === j)); imgs.forEach((im, j) => im.classList.toggle("is-on", i === j)); };
      li.addEventListener("mouseenter", show);
      li.addEventListener("focus", show);
    });
  }
</script>

<style>
  .cx-story { font-size: min(21vw, 19rem); white-space: nowrap; }
  @media (max-width: 767px) { .cx-story { font-size: 26vw !important; } }
  .cx { position: relative; z-index: 1; background: #fff; color: #1f1d1e; padding-top: 1px; overflow-x: clip; }
  .cx p, .cx ul { margin: 0; }
  .cx p::before, .cx p::after { content: none !important; display: none !important; }
  .cx-br { font-size: .6875rem; font-weight: 500; text-transform: uppercase; letter-spacing: .02em; }
  .cx-acc { color: #842636; }
  .cx-list { display: grid; grid-template-columns: 15rem 1fr 18.75rem; gap: 2.5rem; align-items: start; padding: 7.5rem var(--site--margin, 3rem) 0; max-width: var(--max-width--main, 90rem); margin: 0 auto; }
  .cx-items { padding: 0; list-style: none; }
  .cx-items li { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(2.25rem, 3.6vw, 3.25rem); line-height: 1.1; letter-spacing: -.01em; color: #b9b4b5; cursor: default; transition: color .25s; outline: none; }
  .cx-items li.is-on, .cx-items li:focus-visible { color: #842636; }
  .cx-items sup { display: inline-block; position: static; margin-left: .375rem; font-family: var(--_typography---font--primary-family); font-size: .6875rem; line-height: 1; letter-spacing: 0; vertical-align: super; transform: translateY(-.6em); }
  .cx-lp { position: relative; width: 100%; aspect-ratio: 300 / 340; margin: 0; overflow: hidden; background: #842636; }
  .cx-lp img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; opacity: 0; transition: opacity .35s; }
  .cx-lp img.is-on { opacity: 1; }
  .cx-stm { display: grid; grid-template-columns: 15rem 1fr; gap: 2.5rem; padding: 10rem var(--site--margin, 3rem) 0; max-width: var(--max-width--main, 90rem); margin: 0 auto; }
  .cx-big { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(3rem, 6.7vw, 6rem); line-height: .98; letter-spacing: -.01em; text-transform: uppercase; text-align: right; color: #842636; }
  .cx-mos { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.25rem; padding: 7.5rem var(--site--margin, 3rem) 0; max-width: var(--max-width--main, 90rem); margin: 0 auto; }
  .cx-tx { font-size: .8125rem; line-height: 1.4; }
  .cx-tx b { font-weight: 600; }
  .cx-ph { margin: 0; overflow: hidden; background: #842636; }
  .cx-ph img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; transition: scale 1.1s cubic-bezier(.2, .7, .2, 1); }
  .cx-ph:hover img { scale: 1.03; }
  .cx-more { display: flex; justify-content: center; padding: 4rem 0 8.75rem; }
  .cx-more button { display: inline-flex; gap: 3.5rem; background: none; border: 0; padding: .5rem 0; font: inherit; font-size: .75rem; font-weight: 500; text-transform: uppercase; color: #1f1d1e; cursor: pointer; transition: color .2s; }
  .cx-more button:hover { color: #842636; }
  .cx-more button:focus-visible { outline: 2px solid #1f1d1e; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .cx-lp img, .cx-ph img { transition: none; } }
  @media (max-width: 767px) {
    .cx-list { grid-template-columns: 1fr; gap: 1.25rem; padding: 5rem 1rem 0; }
    .cx-items li { font-size: 2.25rem; }
    .cx-stm { grid-template-columns: 1fr; gap: 1rem; padding: 6rem 1rem 0; }
    .cx-big { font-size: 3rem; text-align: left; }
    .cx-mos { grid-template-columns: 1fr 1fr; row-gap: 1.25rem; padding: 5rem 1rem 0; }
    .cx-mos > * { grid-column: auto !important; grid-row: auto !important; margin-top: 0 !important; }
    .cx-mos > .cx-tx { grid-column: 1 / -1 !important; }
    .cx-more { padding: 3rem 0 6rem; }
  }
</style>
