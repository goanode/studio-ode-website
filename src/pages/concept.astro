---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";

// Stacked editorial page (design S3): panoramic "STORY" hero, then Force, Expression, Communauté and the waitlist call — one line of text per section.
const I = {
  studio: "/images/Hello-please-take-the-style-of-t-11755-EU2.webp",
  force: "/images/Hello-please-take-the-style-of-t-391374-HCn.webp",
  renfo: "/images/7053819a90a239bb9f6686d8d1df9a9d.webp",
  expression: "/images/ac743b8e553553c0be56bc5dbaabf5b6.avif",
  mouvement: "/images/Hello-please-take-the-style-of-t-329741-ZHu.webp",
  ensemble: "/images/please-look-at-the-first-pose----265877-w4L.webp",
  recup: "/images/37165de30ebb4909ab52aaa06a86c422.avif",
};
---

<BaseLayout title="Story — Studio Ode" description="L'histoire et le concept du studio de pole dance Ode, à Lille." wfPage="6adb80ddd07ffba4e0c0cb69">
  <main id="main" class="page_main st">
    <section class="sec">
      <div class="g">
        <div class="stack c-full"><span class="n">(00) Introduction</span><h1 class="u-text-trim-off ti ti-hero" data-fit="1" data-fit-m="1" style={`--fs: 30vw; --fs-m: 28vw; background-image: url(${I.studio}); background-position: 50% 35%`}>STORY</h1></div>
        <div class="c-full mt22"><figure class="ph" style="aspect-ratio: 21/9"><img src={I.studio} alt="Le studio Ode à Lille" style="object-position: 50% 28%" /><div class="flute" aria-hidden="true"></div></figure><p class="u-text-trim-off cap"><span>Le studio</span></p></div>
        <div class="mt28" style="grid-column: 1 / 6"><p class="u-text-trim-off tx big">Ode est un studio de pole dance à Lille, pensé pour bouger, se renforcer et s'exprimer.</p></div>
      </div>
    </section>

    <section class="sec">
      <div class="g">
        <div class="stack" style="grid-column: 1 / 4; align-self: start"><span class="n">(01)</span><h2 class="u-text-trim-off ti" data-fit=".24" data-fit-m=".5" style={`--fs: 7vw; --fs-m: 13vw; background-image: url(${I.force}); background-position: 50% 30%`}>FORCE</h2></div>
        <div class="stack" style="grid-column: 1 / 4; grid-row: 2; align-self: end">
          <p class="u-text-trim-off tx big">Pas besoin d'être forte pour commencer. On le devient.</p>
        </div>
        <div class="half" style="grid-column: 5 / 7; grid-row: 1 / 3; align-self: end"><figure class="ph" style="aspect-ratio: 3/4"><img src={I.renfo} alt="Renforcement au studio" loading="lazy" style="object-position: 50% 35%" /></figure><p class="u-text-trim-off cap"><span>Renforcement</span></p></div>
        <div class="half" style="grid-column: 7 / 13; grid-row: 1 / 3"><figure class="ph" style="aspect-ratio: 4/5"><img src={I.force} alt="Figure de force à la barre" loading="lazy" style="object-position: 50% 30%" /></figure><p class="u-text-trim-off cap"><span>La force</span></p></div>
      </div>
    </section>

    <section class="sec">
      <div class="g">
        <div class="stack" style="grid-column: 1 / 7"><span class="n">(02)</span><h2 class="u-text-trim-off ti" data-fit=".5" data-fit-m=".92" style={`--fs: 8vw; --fs-m: 13vw; background-image: url(${I.expression}); background-position: 50% 30%`}>EXPRESSION</h2></div>
        <div class="stack" style="grid-column: 8 / 12; align-self: end"><p class="u-text-trim-off tx big">La barre devient un langage : des lignes, du flow, ta musique.</p></div>
        <div class="mt22 half" style="grid-column: 1 / 7"><figure class="ph" style="aspect-ratio: 4/5"><img src={I.expression} alt="Élève en mouvement à la barre" loading="lazy" style="object-position: 50% 30%" /></figure><p class="u-text-trim-off cap"><span>L'expression</span></p></div>
        <div class="mt22 half" style="grid-column: 7 / 13"><figure class="ph" style="aspect-ratio: 4/5"><img src={I.mouvement} alt="Chorégraphie au studio" loading="lazy" style="object-position: 50% 30%" /></figure><p class="u-text-trim-off cap"><span>Le mouvement</span></p></div>
      </div>
    </section>

    <section class="sec">
      <div class="g">
        <div class="stack" style="grid-column: 1 / 6"><span class="n">(03)</span><h2 class="u-text-trim-off ti" data-fit=".39" data-fit-m=".92" style={`--fs: 5.5vw; --fs-m: 13vw; background-image: url(${I.force}); background-position: 50% 40%`}>COMMUNAUTÉ</h2><p class="u-text-trim-off tx big" style="margin-top: 16px">Huit élèves maximum.</p></div>
        <div class="half" style="grid-column: 7 / 10; align-self: end"><figure class="ph" style="aspect-ratio: 3/4"><img src={I.ensemble} alt="Élèves ensemble au studio" loading="lazy" style="object-position: 50% 35%" /></figure><p class="u-text-trim-off cap"><span>Ensemble</span></p></div>
        <div class="half" style="grid-column: 10 / 13"><figure class="ph" style="aspect-ratio: 3/5"><img src={I.recup} alt="Récupération après le cours" loading="lazy" style="object-position: 50% 30%" /></figure><p class="u-text-trim-off cap"><span>Après le cours</span></p></div>
      </div>
    </section>

    <section class="cta">
      <span class="n">(04) Rejoins-nous</span>
      <h2 class="u-text-trim-off ti" data-fit=".66" data-fit-m=".86" style={`--fs: 12vw; --fs-m: 13vw; background-image: url(${I.renfo}); background-position: 50% 40%`}>ENSEMBLE</h2>
      <p class="u-text-trim-off tx big" style="max-width: 440px">Ode ouvre bientôt ses portes. Inscris-toi sur la liste d'attente pour être prévenue en premier.</p>
      <button type="button" class="cta-btn" data-modal-trigger="waitlist">Rejoins la liste d'attente →</button>
    </section>
  </main>
  <WaitlistModal slot="after-footer" />
</BaseLayout>

<script>
  // Size each big title to its share of the row once the real fonts are in, so nothing is cut off or overflows.
  const titles = [...document.querySelectorAll<HTMLElement>(".st .ti[data-fit]")];
  const fit = () => {
    const mobile = window.matchMedia("(max-width: 700px)").matches;
    titles.forEach((t) => {
      t.style.fontSize = "";
      const box = t.closest(".g, .cta") as HTMLElement;
      const cs = getComputedStyle(box);
      const avail = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const share = parseFloat((mobile ? t.dataset.fitM : t.dataset.fit) || "1");
      const fs = parseFloat(getComputedStyle(t).fontSize);
      t.style.fontSize = (fs * (avail * share)) / t.getBoundingClientRect().width + "px";
    });
  };
  fit();
  document.fonts?.ready.then(fit);
  let r = 0;
  window.addEventListener("resize", () => { cancelAnimationFrame(r); r = requestAnimationFrame(fit); });
</script>

<style>
  .st { font-family: var(--_typography---font--primary-family), sans-serif; color: #141414; background: #fbf9f1; overflow-x: clip; padding-top: calc(var(--nav--height-total, 6rem) + 1rem); }
  /* light page: dark menu button */
  :global(.nav_button_wrap) { color: #141414; border-color: rgb(20 20 20 / 20%) !important; }
  :global(.nav_button_line) { background-color: #141414 !important; }
  .g { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.11vw; padding: 0 1.3vw; }
  .c-full { grid-column: 1 / 13; }
  .mt22 { margin-top: 22px; }
  .mt28 { margin-top: 28px; }
  .flute { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: repeating-linear-gradient(90deg, rgba(255,255,255,.1) 0px, rgba(255,255,255,0) 2px, rgba(255,255,255,0) 20px, rgba(31,29,30,.16) 28px, rgba(255,255,255,.1) 32px); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); }
  .lab, .cap, .tx, .n { font-size: 11px; font-weight: 600; text-transform: uppercase; line-height: 1.2; letter-spacing: -.005em; margin: 0; }
  .lab sup { font-size: 9px; vertical-align: top; }
  .tx { line-height: 1.25; }
  .tx.big { font-size: 15px; line-height: 1.25; }
  .n { opacity: .55; }
  .cap { display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; }
  .ti { position: relative; align-self: flex-start; margin: 0 0 -.16em; padding: .1em .02em 0; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: var(--fs); line-height: 1; letter-spacing: -.01em; white-space: nowrap; color: transparent; -webkit-background-clip: text; background-clip: text; background-size: cover; }
  .ph { position: relative; margin: 0; overflow: hidden; background: #842636; }
  .ph img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 1.1s cubic-bezier(.2, .7, .2, 1); }
  .ph:hover img { scale: 1.035; }
  .sec { padding: 96px 0 0; }
  .sec:first-of-type { padding-top: 48px; }
  .stack { display: flex; flex-direction: column; gap: 22px; }
  .cta .ti { align-self: center; }
  .cta { padding: 120px 1.3vw 96px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .cta-btn { height: 3rem; display: inline-flex; align-items: center; padding: 0 1.5rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: none; font-family: var(--_typography---font--primary-family); font-size: 1rem; font-weight: 500; color: #3b3b3b; cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .cta-btn:hover { background: #3b3b3b; border-color: #3b3b3b; color: #fff; }
  .cta-btn:focus-visible { outline: 2px solid #141414; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .ph img { transition: none; } }
  @media (max-width: 700px) {
    .g { grid-template-columns: repeat(4, 1fr); column-gap: 8px; padding: 0 16px; }
    .g > * { grid-column: 1 / -1 !important; grid-row: auto !important; margin-top: 0 !important; }
    .g > * + * { margin-top: 20px !important; }
    .ti { font-size: var(--fs-m); }
    .sec { padding-top: 64px; }
    .tx.big { font-size: 13px; }
    .hide-m { display: none; }
    .g { grid-template-columns: 1fr 1fr; }
    .g > .half { grid-column: auto !important; align-self: start !important; }
    .g > .half .ph { aspect-ratio: 3 / 4 !important; }
    .g > .half + .half { margin-top: 20px !important; }
      }
</style>
