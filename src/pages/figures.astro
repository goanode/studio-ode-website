---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
import { tricks, LEVELS, CATEGORIES } from "../data/tricks";

const ORDER = { "Débutante": 0, "Intermédiaire": 1, "Avancée": 2 };
const srcset = (base: string) => `${base}-p-500.webp 500w, ${base}-p-800.webp 800w, ${base}.webp 1000w`;
---

<!-- Uses the home page's Webflow page id so the hero gets the exact same load animation (title letters rising, intro fading in) -->
<BaseLayout title="Figures — Studio Ode" description="Le catalogue des figures de pole dance du studio Ode, à Lille." wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <main id="main" class="page_main">
    <section slide-down="" data-wf--section--variant="100svh" data-w-id="9cd849af-5c85-da69-3983-2e49dba72900" class="u-section w-variant-f69fa043-d68c-1f67-d426-c93e24510eb4 u-padding-bottom-0 u-theme-dark">
      <div class="u-background-slot">
        <div tlg-fluted-glass-canvas="" tlg-fluted-glass-mode="scroll" tlg-fluted-glass-segments="60" class="keypoints_visual_wrap"><img class="keypoints_visual_img" src="/images/please-look-at-the-first-pose----820406-SN7.webp" alt="" sizes="100vw" loading="eager" srcset="/images/please-look-at-the-first-pose----820406-SN7-p-500.webp 500w, /images/please-look-at-the-first-pose----820406-SN7-p-800.webp 800w, /images/please-look-at-the-first-pose----820406-SN7.webp 1024w" tlg-fluted-glass-image=""></div>
        <div data-wf--media-overlay--variant="gradient" data-number="20" class="u-overlay w-variant-9653c0cc-21fc-fb82-1373-c98b1644e5a8"></div>
      </div>
      <div class="u-container w-variant-f69fa043-d68c-1f67-d426-c93e24510eb4">
        <div data-wf--layout--variant="breakout-reversed" class="u-layout-wrapper w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7">
          <div class="u-layout w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7">
            <div class="fg-hero-col u-layout-column-2 w-variant-6bb5e515-55a9-1fc8-d29b-ff898d8b40f7  ">
              <div data-wf--content-wrapper--variant="left" style="" class="u-content-wrapper w-variant-e85a4315-14bc-e5ef-0d3e-2c8c9ed7d2f1">
                <div class="u-display-contents">
                  <h1 class="heading fg-heading">FIGURES</h1>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="fg-body">
    <!-- Filters (design G5): centred like the homepage "Choisis ton cours" -->
    <div class="fg-filters" id="catalogue">
      <!-- Same heading component as "Choisis ton cours" on the homepage -->
      <div data-number="20" data-wf--typography-heading--variant="h1" class="u-heading w-variant-792802b6-ccdb-f982-5023-5fa970cf03d0 w-richtext fg-filters-title">
        <h2>Choisis ta figure</h2>
      </div>
      <p class="fg-filters-intro">Toutes les figures enseignées au studio, de la première rotation aux inversions avancées, avec les étapes pour les réussir.</p>
      <!-- Filters (design I1): search + two multi-select dropdowns with checkboxes -->
      <div class="fg-bar">
        <label class="fg-search">
          <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.25" stroke="currentColor" stroke-width="1.2"></circle><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.2"></path></svg>
          <span class="fg-sr">Rechercher une figure</span>
          <input type="search" id="fg-q" placeholder="Rechercher une figure" autocomplete="off" />
        </label>
        <div class="dd" data-dd="cat">
          <button type="button" class="dd-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="dd-cat" data-title="Type de mouvement">
            <span class="dd-text">Type de mouvement</span><span class="dd-chev"><svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.3"></path></svg></span>
          </button>
          <div class="dd-panel" id="dd-cat" role="listbox" aria-multiselectable="true" aria-label="Type de mouvement" hidden>
            {CATEGORIES.map((c) => (
              <button type="button" role="option" class="dd-opt" aria-selected="false" data-value={c}>
                <span class="dd-box"><svg width="12" height="10" viewBox="0 0 12 10" fill="none" aria-hidden="true"><path d="M1 5l3.5 3.5L11 1.5" stroke="#1f1d1e" stroke-width="1.8"></path></svg></span><span class="dd-name">{c}</span><span class="dd-n"></span>
              </button>
            ))}
            <div class="dd-foot">
              <button type="button" class="dd-clear">Effacer</button>
              <button type="button" class="dd-done">Voir les figures</button>
            </div>
          </div>
        </div>
        <div class="dd" data-dd="level">
          <button type="button" class="dd-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="dd-level" data-title="Niveau">
            <span class="dd-text">Niveau</span><span class="dd-chev"><svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.3"></path></svg></span>
          </button>
          <div class="dd-panel" id="dd-level" role="listbox" aria-multiselectable="true" aria-label="Niveau" hidden>
            {LEVELS.map((lv) => (
              <button type="button" role="option" class="dd-opt" aria-selected="false" data-value={lv}>
                <span class="dd-box"><svg width="12" height="10" viewBox="0 0 12 10" fill="none" aria-hidden="true"><path d="M1 5l3.5 3.5L11 1.5" stroke="#1f1d1e" stroke-width="1.8"></path></svg></span><span class="dd-name">{lv}</span><span class="dd-n"></span>
              </button>
            ))}
            <div class="dd-foot">
              <button type="button" class="dd-clear">Effacer</button>
              <button type="button" class="dd-done">Voir les figures</button>
            </div>
          </div>
        </div>
      </div>
      <div class="fg-chips" id="fg-chips" aria-live="polite"></div>
    </div>

    <!-- Catalogue -->
    <section class="fg-section fg-section--grid">
      <div class="fg-head">
        <h2 class="fg-h2" id="fg-grid-title">Toutes les figures</h2>
        <p class="fg-note" id="fg-count" aria-live="polite">{tricks.length} figures</p>
      </div>
      <div class="fg-grid" id="fg-grid">
        {tricks.map((t) => (
          <a href="#" class="fg-card" data-name={t.name} data-alias={t.alias ?? ""} data-level={t.level} data-cat={t.category} data-order={ORDER[t.level]}>
            <span class="fg-card-img"><img src={`${t.image}-p-500.webp`} srcset={srcset(t.image)} sizes="(max-width: 700px) 50vw, 25vw" alt="" loading="lazy" style={`object-position: ${t.imagePosition}; ${t.mirrored ? "transform: scaleX(-1);" : ""}`} /></span>
            <span class="u-overlay" data-number="20" aria-hidden="true"></span>
            <span class="fg-tile-fade" aria-hidden="true"></span>
            <span class="fg-tile-content">
              <span class="fg-tile-labels"><span class="card_classes_btn u-text-style-small">{t.level}</span><span class="card_classes_btn u-text-style-small">{t.category}</span></span>
              <span class="fg-tile-name">{t.name}</span>
            </span>
          </a>
        ))}
      </div>
      <div class="fg-more-wrap"><button type="button" class="fg-btn" id="fg-more">Voir plus</button></div>
      <div class="fg-empty" id="fg-empty" hidden>
        <p class="fg-empty-title">Aucune figure ne correspond à ta recherche.</p>
        <p>Essaie un autre nom, ou retire un filtre.</p>
        <button type="button" class="fg-btn" id="fg-reset">Voir toutes les figures</button>
      </div>
    </section>
    </div>
  </main>

  <WaitlistModal slot="after-footer" />
</BaseLayout>

<script>
  const PAGE = 12;
  const grid = document.getElementById("fg-grid")!;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".fg-card"));
  const q = document.getElementById("fg-q") as HTMLInputElement;
  const more = document.getElementById("fg-more") as HTMLButtonElement;
  const count = document.getElementById("fg-count")!;
  const empty = document.getElementById("fg-empty")!;
  const gridTitle = document.getElementById("fg-grid-title")!;
  const chipsBox = document.getElementById("fg-chips")!;
  const sel: Record<string, string[]> = { cat: [], level: [] };
  const state = { limit: PAGE };
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  const field = { cat: "cat", level: "level" } as const;
  const dds = Array.from(document.querySelectorAll<HTMLElement>("[data-dd]"));

  const okQ = (c: HTMLElement, nq: string) => !nq || norm(`${c.dataset.name} ${c.dataset.alias}`).includes(nq);
  const okSel = (c: HTMLElement, key: "cat" | "level", list = sel[key]) => !list.length || list.includes(c.dataset[field[key]]!);

  function render() {
    const nq = norm(q.value.trim());
    const matches = cards.filter((c) => okQ(c, nq) && okSel(c, "cat") && okSel(c, "level"));
    matches.sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order) || a.dataset.name!.localeCompare(b.dataset.name!));
    cards.forEach((c) => (c.hidden = true));
    matches.forEach((c, i) => { grid.appendChild(c); c.hidden = i >= state.limit; });
    const n = matches.length;
    const browsing = !sel.cat.length && !sel.level.length && !nq;
    gridTitle.textContent = browsing ? "Toutes les figures" : "Résultats";
    count.textContent = n === 1 ? "1 figure" : `${n} figures`;
    const remaining = n - Math.min(n, state.limit);
    more.hidden = remaining <= 0;
    more.textContent = `Voir plus (${remaining} ${remaining === 1 ? "figure restante" : "figures restantes"})`;
    empty.hidden = n > 0;

    // dropdowns: label, filled state, ticks and live counts
    dds.forEach((dd) => {
      const key = dd.dataset.dd as "cat" | "level";
      const other = key === "cat" ? "level" : "cat";
      const list = sel[key];
      const trigger = dd.querySelector<HTMLButtonElement>(".dd-trigger")!;
      trigger.querySelector(".dd-text")!.textContent = !list.length ? trigger.dataset.title! : list.length === 1 ? list[0] : `${list.length} sélectionnés`;
      trigger.classList.toggle("is-on", list.length > 0);
      dd.querySelectorAll<HTMLButtonElement>(".dd-opt").forEach((o) => {
        const v = o.dataset.value!;
        o.setAttribute("aria-selected", String(list.includes(v)));
        o.querySelector(".dd-n")!.textContent = String(cards.filter((c) => okQ(c, nq) && okSel(c, other) && c.dataset[field[key]] === v).length);
      });
      dd.querySelector(".dd-done")!.textContent = n === 1 ? "Voir 1 figure" : `Voir ${n} figures`;
    });

    // active filters as removable chips
    chipsBox.replaceChildren();
    (["cat", "level"] as const).forEach((key) => sel[key].forEach((v) => {
      const b = document.createElement("button");
      b.type = "button"; b.className = "fg-chip"; b.setAttribute("aria-label", `Retirer le filtre ${v}`);
      b.innerHTML = `<span></span><svg width="10" height="10" viewBox="0 0 20 19" fill="none" aria-hidden="true"><path d="M1.5 1l17 17M1.5 18l17-17" stroke="currentColor" stroke-width="2"></path></svg>`;
      b.firstElementChild!.textContent = v;
      b.addEventListener("click", () => { sel[key] = sel[key].filter((x) => x !== v); update(); });
      chipsBox.appendChild(b);
    }));
    if (sel.cat.length || sel.level.length) {
      const r = document.createElement("button");
      r.type = "button"; r.className = "fg-chips-reset"; r.textContent = "Tout effacer";
      r.addEventListener("click", clearAll);
      chipsBox.appendChild(r);
    }
  }
  const update = () => { state.limit = PAGE; render(); };
  const clearAll = () => { q.value = ""; sel.cat = []; sel.level = []; close(); update(); };

  // open / close
  let openDD: HTMLElement | null = null;
  function close(focus = false) {
    if (!openDD) return;
    const t = openDD.querySelector<HTMLButtonElement>(".dd-trigger")!;
    t.setAttribute("aria-expanded", "false");
    openDD.querySelector<HTMLElement>(".dd-panel")!.hidden = true;
    if (focus) t.focus();
    openDD = null;
  }
  function open(dd: HTMLElement) {
    close();
    dd.querySelector(".dd-trigger")!.setAttribute("aria-expanded", "true");
    dd.querySelector<HTMLElement>(".dd-panel")!.hidden = false;
    openDD = dd;
  }
  dds.forEach((dd) => {
    const key = dd.dataset.dd as "cat" | "level";
    dd.querySelector(".dd-trigger")!.addEventListener("click", () => (openDD === dd ? close() : open(dd)));
    dd.querySelectorAll<HTMLButtonElement>(".dd-opt").forEach((o) => o.addEventListener("click", () => {
      const v = o.dataset.value!;
      sel[key] = sel[key].includes(v) ? sel[key].filter((x) => x !== v) : [...sel[key], v];
      update();
    }));
    dd.querySelector(".dd-clear")!.addEventListener("click", () => { sel[key] = []; update(); });
    dd.querySelector(".dd-done")!.addEventListener("click", () => close(true));
    // arrow keys move between options
    dd.querySelector(".dd-panel")!.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== "ArrowDown" && ev.key !== "ArrowUp") return;
      ev.preventDefault();
      const opts = Array.from(dd.querySelectorAll<HTMLButtonElement>(".dd-opt"));
      const i = opts.indexOf(document.activeElement as HTMLButtonElement);
      opts[(i + (ev.key === "ArrowDown" ? 1 : -1) + opts.length) % opts.length].focus();
    });
  });
  document.addEventListener("click", (e) => { if (openDD && !openDD.contains(e.target as Node)) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(true); });

  q.addEventListener("input", update);
  more.addEventListener("click", () => { state.limit += PAGE; render(); });
  document.getElementById("fg-reset")!.addEventListener("click", clearAll);

  render();
</script>

<style>
  /* Hero: the home page's .heading is sized for "ODE"; fit "Figures" */
  .fg-hero-col { grid-column: 1 / -1; width: 100%; }
  .fg-heading { width: auto; white-space: nowrap; font-size: 21vw; letter-spacing: -.02em; }
  /* Everything below the hero sits on a white layer that slides over it, like the homepage sections */
  .fg-body { position: relative; z-index: 1; background: var(--_theme---background, #fff); padding-top: 1px; }

  .fg-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Filters (G5) */
  .fg-filters { position: relative; z-index: 2; padding: 6rem var(--site--margin) 2rem; display: flex; flex-direction: column; align-items: center; gap: .75rem; text-align: center; }
  .fg-filters-intro { max-width: 30rem; margin: 0 0 2rem; font-size: 1.125rem; line-height: 1.5; color: var(--swatch--dark-800); text-wrap: pretty; }
  .fg-filters-title h2 { margin: 0; font: inherit; color: inherit; }
  /* homepage spacing: 40px from heading to buttons (32px on phone) */
  .fg-filters-title { margin-top: 0; margin-bottom: 1.75rem; }
  .fg-search { width: 25rem; max-width: 100%; height: 2.75rem; display: flex; align-items: center; gap: .75rem; padding: 0 1.375rem; border-radius: var(--radius--round); background: color-mix(in srgb, var(--swatch--dark-900) 6%, transparent); color: var(--swatch--dark-800); }
  .fg-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; font-size: 1.125rem; color: var(--swatch--dark-900); }
  .fg-search input::placeholder { color: var(--swatch--dark-800); opacity: .6; }
  .fg-search:focus-within, .dd-trigger:focus-visible, .dd-opt:focus-visible, .fg-chips :global(.fg-chip:focus-visible) { outline: 2px solid var(--swatch--dark-900); outline-offset: 2px; }

  /* Filter bar (I1) */
  .fg-bar { position: relative; z-index: 20; display: flex; justify-content: center; align-items: flex-start; gap: .75rem; }
  .dd { position: relative; }
  .dd-trigger { height: 2.75rem; min-width: 15rem; padding: 0 1.25rem 0 1.5rem; border-radius: var(--radius--round); border: 1px solid var(--swatch--dark-900-o20); background: #fff; color: var(--swatch--dark-800); font-size: 1.125rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; transition: border-color .2s, background-color .2s, color .2s; }
  .dd-trigger:hover, .dd-trigger[aria-expanded="true"] { border-color: var(--swatch--dark-800); }
  .dd-trigger.is-on { background: var(--swatch--dark-800); border-color: var(--swatch--dark-800); color: #fff; }
  .dd-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dd-chev { display: flex; transition: transform .25s cubic-bezier(.2, .7, .2, 1); }
  .dd-trigger[aria-expanded="true"] .dd-chev { transform: rotate(180deg); }
  .dd-panel { position: absolute; top: calc(100% + .5rem); left: 0; min-width: 100%; width: 17.5rem; box-sizing: border-box; padding: .5rem; border-radius: var(--radius--main); background: var(--swatch--dark-900); color: #fff; box-shadow: 0 18px 40px rgb(31 29 30 / 18%); text-align: left; animation: dd-in .22s cubic-bezier(.2, .7, .2, 1); }
  .dd-panel[hidden] { display: none; }
  @keyframes dd-in { from { opacity: 0; transform: translateY(-6px) scale(.98); } to { opacity: 1; transform: none; } }
  .dd-opt { width: 100%; height: 2.75rem; padding: 0 .75rem; border-radius: .625rem; color: #fff; font-size: 1.0625rem; display: flex; align-items: center; gap: .75rem; text-align: left; }
  .dd-opt:hover, .dd-opt:focus-visible { background: rgb(255 255 255 / 8%); outline: 0; }
  .dd-box { width: 1.125rem; height: 1.125rem; border-radius: 5px; border: 1px solid rgb(255 255 255 / 35%); display: flex; align-items: center; justify-content: center; flex: none; transition: background-color .15s, border-color .15s; }
  .dd-box svg { opacity: 0; transition: opacity .15s; }
  .dd-opt[aria-selected="true"] .dd-box { background: #fff; border-color: #fff; }
  .dd-opt[aria-selected="true"] .dd-box svg { opacity: 1; }
  .dd-name { flex: 1; }
  .dd-n { font-size: .875rem; opacity: .55; }
  .dd-foot { display: flex; justify-content: space-between; align-items: center; gap: .5rem; margin-top: .375rem; padding: .625rem .25rem .125rem; border-top: 1px solid rgb(255 255 255 / 12%); }
  .dd-clear { color: #fff; opacity: .7; font-size: .9375rem; text-decoration: underline; padding: 0 .5rem; }
  .dd-done { height: 2.25rem; padding: 0 1rem; border-radius: var(--radius--round); background: #fff; color: var(--swatch--dark-900); font-size: .9375rem; }
  .fg-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; min-height: 2.25rem; }
  .fg-chips :global(.fg-chip) { height: 2.25rem; padding: 0 .75rem 0 1rem; border-radius: var(--radius--round); background: color-mix(in srgb, var(--swatch--dark-900) 8%, transparent); color: var(--swatch--dark-900); font-size: .9375rem; display: inline-flex; align-items: center; gap: .5rem; }
  .fg-chips :global(.fg-chip:hover) { background: color-mix(in srgb, var(--swatch--dark-900) 14%, transparent); }
  .fg-chips :global(.fg-chips-reset) { padding: 0 .5rem; font-size: .9375rem; color: var(--swatch--dark-800); text-decoration: underline; }

  /* Sections */
  .fg-section { padding: 2rem var(--site--margin) 0; }
  .fg-section--grid { padding-bottom: var(--_spacing---section-space--large); }
  .fg-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.5rem; }
  .fg-h2 { margin: 0; font-size: clamp(1.75rem, 2.6vw, 2.5rem); font-weight: 400; line-height: 1; letter-spacing: -.02em; color: var(--swatch--dark-900); }
  .fg-note { margin: 0; font-size: .875rem; color: var(--swatch--dark-800); }


  /* Tiles: same recipe as the homepage class cards (light tint, soft blur on the lower half, frosted label) */
  .fg-tile-content { position: absolute; z-index: 5; left: 0; right: 0; bottom: 0; padding: 1.5rem; display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; color: #fff; }
  .fg-tile-labels { display: flex; flex-wrap: wrap; gap: .375rem; }
  /* No blur on the photos: a soft dark fade on the bottom quarter keeps the text readable */
  .fg-tile-fade { position: absolute; inset: auto 0 0; height: 35%; background: linear-gradient(180deg, rgb(31 29 30 / 0), rgb(31 29 30 / 45%)); pointer-events: none; }
  .fg-tile-name { font-size: 1.25rem; line-height: 1.5; text-wrap: pretty; }

  /* Grid */
  .fg-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .fg-card { position: relative; display: block; aspect-ratio: 4 / 5; border-radius: var(--radius--main); overflow: hidden; color: #fff; background: var(--swatch--dark-800); }
  .fg-card[hidden] { display: none; }
  .fg-card-img { position: absolute; inset: 0; display: block; }
  .fg-card-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale .7s cubic-bezier(.2, .7, .2, 1); }
  .fg-card:hover img { scale: 1.05; }
  .fg-card:focus-visible { outline: 2px solid var(--swatch--dark-900); outline-offset: 4px; border-radius: var(--radius--main); }

  .fg-more-wrap { display: flex; justify-content: center; margin-top: 3rem; }
  .fg-btn { height: var(--button-size--medium); padding: 0 1.5rem; border-radius: 100vw; border: var(--border-width--main) solid var(--swatch--dark-800); background: var(--swatch--dark-800); color: #fff; font-size: 1rem; transition: background .3s, color .3s; }
  .fg-btn:hover { background: #fff; color: var(--swatch--dark-800); }
  .fg-btn[hidden], .fg-empty[hidden] { display: none; }
  .fg-empty { padding: 4.5rem 1.5rem; border: var(--border-width--main) solid var(--swatch--dark-900-o20); border-radius: var(--radius--main); display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; }
  .fg-empty p { margin: 0; }
  .fg-empty-title { font-size: 1.375rem; color: var(--swatch--dark-900); }

  @media (max-width: 1000px) { .fg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
  }
  @media (max-width: 700px) {
    .fg-bar { flex-wrap: wrap; }
    .fg-bar .fg-search { width: 100%; }
    .fg-bar .dd { flex: 1 1 0; min-width: 0; }
    .dd-trigger { min-width: 0; width: 100%; padding: 0 .875rem 0 1.125rem; font-size: 1rem; }
    .dd:last-child .dd-panel { left: auto; right: 0; }
    .dd-panel { width: min(20rem, calc(100vw - 2 * var(--site--margin))); }
    .fg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
