---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
import { tricks, LEVELS, CATEGORIES } from "../data/tricks";
// Figures catalogue (design "FiguresOther", after the Other° studio site):
// big title, a large underlined search (after Mura), level + type filters,
// and a grid that switches between 4 and 8 columns with the photos gliding into place (GSAP Flip).

const levelCount = (l: string) => tricks.filter((t) => t.level === l).length;
const catCount = (c: string) => tricks.filter((t) => t.category === c).length;
const srcset = (base: string) => `${base}-p-500.webp 500w, ${base}-p-800.webp 800w, ${base}.webp 1000w`;
const SHORT: Record<string, string> = { "Débutante": "débutante", "Intermédiaire": "inter.", "Avancée": "avancée" };
---

<BaseLayout title="Figures — Studio Ode" description="Le catalogue des figures de pole dance du studio Ode, à Lille." wfPage="6a96e3c256f4431a13f9f238">
  <main id="main" class="page_main fx">
    <section class="hero">
      <h1 class="ttl">Figures<sup aria-hidden="true">°</sup></h1>
      <p class="intro">Toutes les figures enseignées au studio, de la première rotation aux inversions avancées, avec les étapes pour les réussir.</p>
      <p class="counts">{LEVELS.map((l) => <span>{levelCount(l)} {SHORT[l]}</span>)}</p>
    </section>

    <div class="search" role="search">
      <label class="sr" for="fg-q">Rechercher une figure</label>
      <input type="search" id="fg-q" class="q" placeholder="Rechercher" autocomplete="off" spellcheck="false" />
      <button type="button" class="clear" id="fg-clear" aria-label="Effacer la recherche" hidden>
        <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 3l14 14M3 17L17 3" stroke="currentColor" stroke-width="1.2"></path></svg>
      </button>
      <svg class="mag" width="44" height="44" viewBox="0 0 44 44" fill="none" aria-hidden="true"><circle cx="18" cy="18" r="14.5" stroke="currentColor" stroke-width="1.2"></circle><path d="M28.5 28.5L42 42" stroke="currentColor" stroke-width="1.2"></path></svg>
      <span class="line" aria-hidden="true"></span>
      <p class="hint">Tape le nom d'une figure, en français ou en anglais.</p>
    </div>

    <div class="bar" id="catalogue">
      <div>
        <h2 class="h2"><span id="fg-title">Toutes les figures</span><sup id="fg-count">({tricks.length})</sup></h2>
        <div class="filters" role="group" aria-label="Niveau" data-key="level">
          <button type="button" class="f" aria-pressed="true" data-value="">Toutes</button>
          {LEVELS.map((l) => <button type="button" class="f" aria-pressed="false" data-value={l}>{l}<sup>{levelCount(l)}</sup></button>)}
        </div>
        <div class="filters" role="group" aria-label="Type de mouvement" data-key="cat">
          <button type="button" class="f" aria-pressed="true" data-value="">Tous les types</button>
          {CATEGORIES.map((c) => <button type="button" class="f" aria-pressed="false" data-value={c}>{c}<sup>{catCount(c)}</sup></button>)}
        </div>
      </div>
      <div class="views" role="group" aria-label="Affichage">
        <button type="button" class="v" aria-pressed="true" data-cols="std">
          <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><g fill="currentColor"><rect width="8" height="8"/><rect x="10" width="8" height="8"/><rect y="10" width="8" height="8"/><rect x="10" y="10" width="8" height="8"/></g></svg>Standard
        </button>
        <button type="button" class="v" aria-pressed="false" data-cols="dense">
          <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><g fill="currentColor">{[0, 1, 2, 3].map((x) => [0, 1, 2, 3].map((y) => <rect x={x * 5} y={y * 5} width="3" height="3" />))}</g></svg>Dense
        </button>
      </div>
    </div>

    <div class="grid" id="fg-grid">
      {tricks.map((t) => (
        <a href={`/figures/${t.slug}`} class="card" data-name={t.name} data-alias={t.alias ?? ""} data-level={t.level} data-cat={t.category}>
          <span class="ph"><img src={`${t.image}-p-500.webp`} srcset={srcset(t.image)} sizes="(max-width: 767px) 50vw, 25vw" alt="" loading="lazy" style={`object-position: ${t.imagePosition}${t.mirrored ? "; transform: scaleX(-1)" : ""}`} /></span>
          <span class="cap"><span class="nm">{t.name}</span><span class="lv">{t.level}</span></span>
        </a>
      ))}
    </div>

    <div class="more-wrap"><button type="button" class="pill" id="fg-more">Voir plus</button></div>
    <div class="empty" id="fg-empty" hidden>
      <p class="empty-t">Aucune figure ne correspond à ta recherche.</p>
      <p>Essaie un autre nom, ou retire un filtre.</p>
      <button type="button" class="pill" id="fg-reset">Voir toutes les figures</button>
    </div>
  </main>
  <WaitlistModal slot="after-footer" />

  <Fragment slot="scripts">
    <script is:inline src="/vendor/Flip.min.js"></script>
  </Fragment>
</BaseLayout>

<script>
  const PAGE = 24; // 6 rows of 4, or 3 rows of 8
  const grid = document.getElementById("fg-grid")!;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".card"));
  const q = document.getElementById("fg-q") as HTMLInputElement;
  const clearBtn = document.getElementById("fg-clear") as HTMLButtonElement;
  const more = document.getElementById("fg-more") as HTMLButtonElement;
  const empty = document.getElementById("fg-empty")!;
  const title = document.getElementById("fg-title")!;
  const count = document.getElementById("fg-count")!;
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".filters"));
  const views = Array.from(document.querySelectorAll<HTMLButtonElement>(".views .v"));
  const sel: Record<string, string> = { level: "", cat: "" };
  let limit = PAGE;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const okQ = (c: HTMLElement, nq: string) => !nq || norm(`${c.dataset.name} ${c.dataset.alias}`).includes(nq);
  const ok = (c: HTMLElement, key: "level" | "cat") => !sel[key] || c.dataset[key] === sel[key];

  // Every change goes through here: the grid's before/after is captured and Flip glides each photo to its new place.
  let flipTl: any = null;
  function change(mutate: () => void, duration = 0.7) {
    const w = window as any;
    if (reduce || !w.Flip || !w.gsap) { mutate(); return; }
    if (flipTl) flipTl.progress(1);
    const state = w.Flip.getState(cards);
    const h0 = grid.offsetHeight;
    mutate();
    // the photos are lifted out of the grid while they glide, so hold the grid's height and ease it to the new one (keeps the footer still)
    const h1 = grid.offsetHeight;
    w.gsap.fromTo(grid, { height: h0 }, { height: h1, duration, ease: "power3.inOut", overwrite: true, clearProps: "height" });
    flipTl = w.Flip.from(state, {
      duration, ease: "power3.inOut", absolute: true, stagger: 0.012, prune: true,
      onEnter: (els: Element[]) => w.gsap.fromTo(els, { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out", delay: 0.15 }),
      onLeave: (els: Element[]) => w.gsap.to(els, { opacity: 0, scale: 0.92, duration: 0.35, ease: "power2.in" }),
    });
  }

  function render() {
    const nq = norm(q.value.trim());
    const matches = cards.filter((c) => okQ(c, nq) && ok(c, "level") && ok(c, "cat"));
    cards.forEach((c) => (c.hidden = true));
    matches.forEach((c, i) => (c.hidden = i >= limit));
    const n = matches.length;
    title.textContent = !nq && !sel.level && !sel.cat ? "Toutes les figures" : "Résultats";
    count.textContent = `(${n})`;
    const left = n - Math.min(n, limit);
    more.hidden = left <= 0;
    more.textContent = `Voir plus de figures (${left})`;
    empty.hidden = n > 0;
    clearBtn.hidden = !q.value;
    // live counts: what each option would show with the other filter and the search
    groups.forEach((g) => {
      const key = g.dataset.key as "level" | "cat";
      const other = key === "level" ? "cat" : "level";
      g.querySelectorAll<HTMLButtonElement>(".f").forEach((b) => {
        b.setAttribute("aria-pressed", String(b.dataset.value === sel[key]));
        const sup = b.querySelector("sup");
        if (sup) sup.textContent = String(cards.filter((c) => okQ(c, nq) && ok(c, other) && c.dataset[key] === b.dataset.value).length);
      });
    });
  }

  groups.forEach((g) => g.querySelectorAll<HTMLButtonElement>(".f").forEach((b) => b.addEventListener("click", () => {
    const key = g.dataset.key!;
    if (sel[key] === b.dataset.value) return;
    change(() => { sel[key] = b.dataset.value!; limit = PAGE; render(); });
  })));
  views.forEach((v) => v.addEventListener("click", () => {
    if (v.getAttribute("aria-pressed") === "true") return;
    change(() => {
      views.forEach((x) => x.setAttribute("aria-pressed", String(x === v)));
      grid.classList.toggle("is-dense", v.dataset.cols === "dense");
    }, 0.9);
  }));
  let typing: number | undefined;
  q.addEventListener("input", () => { clearTimeout(typing); typing = window.setTimeout(() => change(() => { limit = PAGE; render(); }, 0.55), 120); });
  clearBtn.addEventListener("click", () => { q.value = ""; q.focus(); change(() => { limit = PAGE; render(); }, 0.55); });
  more.addEventListener("click", () => change(() => { limit += PAGE; render(); }, 0.6));
  document.getElementById("fg-reset")!.addEventListener("click", () => change(() => { q.value = ""; sel.level = ""; sel.cat = ""; limit = PAGE; render(); }));
  render();
</script>

<style>
  .fx { --ink: #1f1d1e; --red: #842636; color: var(--ink); background: #f6f6f6; padding: calc(var(--nav--height-total, 6rem) + 1rem) var(--site--margin, 2.5rem) 8rem; font-family: var(--_typography---font--primary-family), sans-serif; }
  :global(.nav_button_wrap) { color: #141414; border-color: rgb(20 20 20 / 20%) !important; }
  :global(.nav_button_line) { background-color: #141414 !important; }
  .fx p, .fx h1, .fx h2 { margin: 0; }
  .fx p::before, .fx p::after, .fx h1::before, .fx h1::after, .fx h2::before, .fx h2::after { content: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ttl, .h2, .q, .nm, .empty-t { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); letter-spacing: -.01em; }

  /* header */
  .hero { display: grid; grid-template-columns: 4fr 3fr 1fr; align-items: center; padding: 4.5rem 0 4rem; }
  .ttl { font-size: clamp(5rem, 9.2vw, 8.5rem); line-height: .9; }
  .ttl sup { font-family: var(--_typography---font--primary-family), sans-serif; font-size: .22em; vertical-align: top; position: relative; top: .5em; margin-left: .3em; color: var(--red); }
  .intro { max-width: 20rem; font-size: .875rem; line-height: 1.45; color: #3b3b3b; }
  .counts { display: flex; justify-content: flex-end; gap: 1rem; font-size: .8125rem; color: #3b3b3b; white-space: nowrap; }

  /* search, after Mura: one big word on a line, the magnifier at the end */
  .search { position: relative; display: flex; align-items: center; gap: 1.5rem; margin-bottom: 6.5rem; padding-bottom: .875rem; }
  .q { flex: 1; min-width: 0; border: 0; background: none; padding: 0; font-size: clamp(3rem, 6.2vw, 5.75rem); line-height: 1.1; color: var(--ink); outline: none; -webkit-appearance: none; appearance: none; }
  .q::placeholder { color: #a9a6a7; opacity: 1; }
  .q::-webkit-search-cancel-button { display: none; }
  .mag { flex: none; width: 2.75rem; height: 2.75rem; color: #6f6b6c; transition: color .3s; }
  .clear { flex: none; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 0; background: none; color: #6f6b6c; cursor: pointer; }
  .clear[hidden] { display: none; }
  .clear:hover { color: var(--ink); }
  .line { position: absolute; left: 0; right: 0; bottom: 0; height: 1px; background: rgb(31 29 30 / 35%); }
  .line::after { content: ""; position: absolute; inset: 0; background: var(--red); transform: scaleX(0); transform-origin: left; transition: transform .6s cubic-bezier(.65, 0, .35, 1); }
  .search:focus-within .line::after { transform: scaleX(1); }
  .search:focus-within .mag { color: var(--red); }
  .hint { position: absolute; left: 0; top: calc(100% + .75rem); font-size: .75rem; color: #3b3b3b; }

  /* title, filters and view switch */
  .bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 2.5rem; margin-bottom: 1.5rem; }
  .h2 { font-size: clamp(1.875rem, 2.4vw, 2.25rem); line-height: 1; }
  .h2 sup { font-family: var(--_typography---font--primary-family), sans-serif; font-weight: 400; letter-spacing: 0; font-size: .75rem; vertical-align: top; margin-left: .2rem; }
  .filters { display: flex; flex-wrap: wrap; gap: .375rem 1.125rem; margin-top: .875rem; }
  .filters + .filters { margin-top: .625rem; }
  .f { padding: 0; border: 0; background: none; font: inherit; font-size: .875rem; color: #a3a0a1; cursor: pointer; transition: color .3s; }
  .f sup { font-size: .6rem; margin-left: .15rem; }
  .f:hover, .f[aria-pressed="true"] { color: var(--ink); }
  .views { flex: none; display: flex; gap: .25rem; padding: .25rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 14%); }
  .v { display: flex; align-items: center; gap: .5rem; height: 2.5rem; padding: 0 1rem; border: 0; border-radius: 9999px; background: none; font: inherit; font-size: .875rem; color: #8a8586; cursor: pointer; transition: background-color .35s, color .35s; }
  .v:hover { color: var(--ink); }
  .v[aria-pressed="true"] { background: var(--ink); color: #fff; }
  .f:focus-visible, .v:focus-visible, .pill:focus-visible, .clear:focus-visible, .card:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* grid: 4 columns, or 8 when dense */
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; }
  .grid.is-dense { grid-template-columns: repeat(8, 1fr); }
  .card { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: #d9d7d7; color: #fff; text-decoration: none; }
  .card[hidden] { display: none; }
  .ph, .ph img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ph img { object-fit: cover; display: block; transition: scale .8s cubic-bezier(.2, .7, .2, 1); }
  .card:hover .ph img { scale: 1.04; }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: .75rem; padding: 2.5rem .875rem .75rem; background: linear-gradient(180deg, transparent, rgb(20 18 19 / 55%)); opacity: 0; transition: opacity .35s; }
  .card:hover .cap, .card:focus-visible .cap { opacity: 1; }
  .nm { font-size: 1.5rem; line-height: 1.05; }
  .lv { font-size: .75rem; opacity: .8; white-space: nowrap; }
  .is-dense .nm { font-size: 1rem; }
  .is-dense .lv { display: none; }
  .is-dense .cap { padding: 1.5rem .5rem .5rem; }

  .more-wrap { display: flex; justify-content: center; margin-top: 3.5rem; }
  .more-wrap:has(.pill[hidden]) { display: none; }
  .pill { display: inline-flex; align-items: center; height: 3rem; padding: 0 1.5rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: none; font: inherit; font-size: .9375rem; font-weight: 500; color: #3b3b3b; cursor: pointer; transition: background-color .25s, color .25s, border-color .25s; }
  .pill:hover { background: #3b3b3b; border-color: #3b3b3b; color: #fff; }
  .pill[hidden] { display: none; }
  .empty { display: flex; flex-direction: column; align-items: center; gap: .75rem; padding: 4rem 0; text-align: center; color: #3b3b3b; }
  .empty[hidden] { display: none; }
  .empty-t { font-size: 2rem; color: var(--ink); }
  .empty .pill { margin-top: 1rem; }

  @media (max-width: 767px) {
    .fx { padding: calc(var(--nav--height-total, 6rem) + .5rem) .75rem 5rem; }
    .hero { grid-template-columns: 1fr; gap: 1rem; padding: 3rem 0 2.5rem; }
    .ttl { font-size: 5.25rem; }
    .counts { justify-content: flex-start; }
    .search { gap: .75rem; margin-bottom: 4.5rem; padding-bottom: .5rem; }
    .q { font-size: 2.75rem; }
    .mag, .clear { width: 2rem; height: 2rem; }
    .bar { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .grid.is-dense { grid-template-columns: repeat(4, 1fr); }
    .cap { opacity: 1; padding: 2rem .625rem .625rem; }
    .nm { font-size: 1.125rem; }
    .lv { display: none; }
    .is-dense .cap { display: none; }
  }
</style>
