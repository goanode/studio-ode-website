---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
import { tricks, LEVELS, CATEGORIES, figSrcset, coverFactor } from "../data/tricks";
// Figures catalogue (design "FiguresOther", after the Other° studio site):
// in the homepage style: eyebrows, frosted pills with the burgundy + chrome heart hover, a compact search,
// level + type filters, and a grid that switches between 4 and 8 columns with the photos gliding into place (GSAP Flip).

const levelCount = (l: string) => tricks.filter((t) => t.level === l).length;
const catCount = (c: string) => tricks.filter((t) => t.category === c).length;
// hero collage, laid out on a 1440 × 900 board like the Concept page: [image, x, y, w, h, faded, hidden on mobile, depth]
const IMG = "/images/";
const COL: [string, number, number, number, number, boolean, boolean, number][] = [
  [IMG + "figures-stargazer-p-500.webp", 140, 70, 90, 110, true, true, 1.4],
  [IMG + "aerial-invert-p-800.webp", 330, 140, 190, 240, false, false, 1],
  [IMG + "please-look-at-the-first-pose----265877-w4L-p-500.webp", 570, 80, 90, 130, true, true, 1.6],
  [IMG + "figures-stargazer-p-800.webp", 1030, 60, 260, 400, false, false, 0.9],
  [IMG + "37165de30ebb4909ab52aaa06a86c422-p-500.avif", 1290, 120, 130, 170, true, false, 1.3],
  [IMG + "Hello-please-take-the-style-of-t-329741-ZHu-p-500.webp", -30, 230, 130, 180, true, false, 1.5],
  [IMG + "f830ef2fd533f1f45b6d4d1beba1face-p-500.avif", 200, 500, 120, 150, true, true, 1.2],
  [IMG + "Hello-please-take-the-style-of-t-391374-HCn-p-800.webp", 430, 600, 200, 220, false, false, 1],
  [IMG + "please-keep-the-background--the-233555-iP0-p-800.webp", 690, 610, 200, 290, false, true, 0.8],
  [IMG + "a919359daba17134b7c9ce30dbfe9490-p-500.avif", 1140, 560, 120, 160, true, false, 1.4],
  [IMG + "aerial-invert-p-500.webp", 1300, 700, 160, 200, true, true, 1.1],
];
const pct = (x: number, total: number) => `${((x / total) * 100).toFixed(3)}%`;
const srcset = (base: string) => `${base}-p-500.webp 500w, ${base}-p-800.webp 800w, ${base}.webp 1000w`;

// collage photos: offer 300/500/800px versions so each screen takes the smallest that is sharp enough
import { existsSync } from "node:fs";
const cset = (src: string) => {
  const m = src.match(/^(.*?)(?:-p-(?:500|800))?\.(webp|avif)$/);
  if (!m) return undefined;
  const c = ([[`${m[1]}-p-300.webp`, 300], [`${m[1]}-p-500.${m[2]}`, 500], [`${m[1]}-p-800.${m[2]}`, 800]] as const).filter(([u]) => existsSync(`public${u}`));
  return c.length ? c.map(([u, n]) => `${u} ${n}w`).join(", ") : undefined;
};
// the two biggest photos that show on every screen (one of them counts as "loaded" on desktop, the other on phones) get download priority
const lead = new Set(COL.map((c, i) => [c[3] * c[4], i, c[6]] as const).filter((c) => !c[2]).sort((a, b) => b[0] - a[0]).slice(0, 2).map((c) => c[1]));
---

<BaseLayout title="Figures de pole dance par niveau : étapes et conseils | Ode" viewTransition="fg-grid" description={`Le catalogue des figures de pole dance : ${tricks.length} figures de débutante à avancée (chair spin, superman, ayesha…), avec les étapes et conseils pour les réussir.`} wfPage="6a96e3c256f4431a13f9f238">
  <main id="main" class="page_main fx u-theme-light">
    <section class="hero" aria-label="Figures">
      <div class="col">
        {COL.map(([src, x, y, w, h, faded, hm, depth], i) => (
          <figure class:list={["cf", { faded, hm }]} data-depth={depth} data-side={x + w / 2 < 720 ? -1 : 1} style={`--x:${pct(x, 1440)};--y:${pct(y, 900)};--w:${pct(w, 1440)};--h:${pct(h, 900)}`}>
            <img src={src} srcset={cset(src)} sizes={`(max-width: 767px) 40vw, ${(w / 14.4).toFixed(1)}vw`} alt="" decoding="async" loading={hm ? "lazy" : undefined} fetchpriority={lead.has(i) ? "high" : undefined} />
          </figure>
        ))}
      </div>
      <div class="center">
        <h1 class="ttl"><span class="ode-th"><span class="vt-title">Figures</span><img class="ode-title-heart ode-icon-book" src="/images/ode-icon-book-s.webp" alt="" aria-hidden="true" /></span><span class="u-sr-only"> de pole dance</span></h1>
        <p class="intro">Toutes les figures de pole dance, de la première rotation aux inversions avancées.</p>
      </div>
    </section>

    <div class="bar" id="catalogue">
      <div>
        <h2 class="h2"><span id="fg-title">Toutes les figures</span><sup id="fg-count">({tricks.length})</sup></h2>
      </div>
      <div class="tools">
        <label class="search">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.25" stroke="currentColor" stroke-width="1.3"></circle><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.3"></path></svg>
          <span class="sr">Rechercher une figure</span>
          <input type="search" id="fg-q" placeholder="Rechercher une figure" autocomplete="off" spellcheck="false" />
          <button type="button" class="clear" id="fg-clear" aria-label="Effacer la recherche" hidden><svg width="12" height="12" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 3l14 14M3 17L17 3" stroke="currentColor" stroke-width="1.6"></path></svg></button>
        </label>
        <div class="views" role="group" aria-label="Affichage">
          <span class="th" aria-hidden="true"></span>
          <button type="button" class="v" aria-pressed="true" data-cols="std">
            <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><g fill="currentColor"><rect width="8" height="8"/><rect x="10" width="8" height="8"/><rect y="10" width="8" height="8"/><rect x="10" y="10" width="8" height="8"/></g></svg>Standard
          </button>
          <button type="button" class="v" aria-pressed="false" data-cols="dense">
            <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><g fill="currentColor">{[0, 1, 2, 3].map((x) => [0, 1, 2, 3].map((y) => <rect x={x * 5} y={y * 5} width="3" height="3" />))}</g></svg>Dense
          </button>
        </div>
      </div>
    </div>

    <div class="frows">
      <div class="filters" role="group" aria-label="Niveau" data-key="level">
        <button type="button" class="f" aria-pressed="true" data-value="">Toutes<img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button>
        {LEVELS.map((l) => <button type="button" class="f" aria-pressed="false" data-value={l}>{l}<sup>{levelCount(l)}</sup><img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button>)}
      </div>
      <div class="filters" role="group" aria-label="Type de mouvement" data-key="cat">
        <button type="button" class="f" aria-pressed="true" data-value="">Tous les types<img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button>
        {CATEGORIES.map((c) => <button type="button" class="f" aria-pressed="false" data-value={c}>{c}<sup>{catCount(c)}</sup><img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button>)}
      </div>
    </div>

    <div class="grid" id="fg-grid">
      {tricks.map((t) => (
        <a href={`/figures/${t.slug}`} class="card" data-name={t.name} data-alias={t.alias ?? ""} data-level={t.level} data-cat={t.category}>
          <span class="ph"><img src={`${t.image}-p-500.webp`} srcset={figSrcset(t)} sizes={`(max-width: 767px) ${Math.round(50 * coverFactor(t, 1))}vw, ${Math.round(25 * coverFactor(t, 1))}vw`} alt={`${t.name}, figure de pole dance ${t.level.toLowerCase()}`} loading="lazy" style={`object-position: ${t.imagePosition}${t.mirrored ? "; transform: scaleX(-1)" : ""}`} /></span>
          <span class="tags"><span class="tg">{t.level}</span><span class="tg">{t.category}</span></span>
          <span class="nm">{t.name}</span>
        </a>
      ))}
    </div>

    <div class="more-wrap"><button type="button" class="pill" id="fg-more"><span class="pill-t">Voir plus</span><img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button></div>
    <div class="empty" id="fg-empty" hidden>
      <p class="empty-t">Aucune figure ne correspond à ta recherche.</p>
      <p>Essaie un autre nom, ou retire un filtre.</p>
      <button type="button" class="pill" id="fg-reset">Voir toutes les figures<img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button>
    </div>
    <!-- SEO guide: where to start, per level, with links into the catalogue -->
    <section class="guide" aria-labelledby="guide-title">
      <h2 class="h2" id="guide-title">Par où commencer en pole dance&nbsp;?</h2>
      <div class="gcols">
        <div>
          <h3>Débutante</h3>
          <p>On commence par tourner et s’asseoir à la barre. Les premières rotations comme le <a href="/figures/chair-spin">chair spin</a>, le <a href="/figures/baby-angel">baby angel</a> ou l’<a href="/figures/air-walk">air walk</a> t’apprennent l’élan et la prise de mains&nbsp;; les assises comme le <a href="/figures/martini-sit">martini sit</a> ou le <a href="/figures/remi-sit">remi sit</a> te font lâcher les mains en toute sécurité.</p>
        </div>
        <div>
          <h3>Intermédiaire</h3>
          <p>Une fois à l’aise en hauteur, vient la tête en bas&nbsp;: l’<a href="/figures/aerial-invert">aerial invert</a> ouvre la porte aux figures inversées comme le <a href="/figures/scorpio">scorpio</a>, le <a href="/figures/meathook">meathook</a> ou le <a href="/figures/inverted-crucifix">crucifix inversé</a>, et aux figures tenues comme le <a href="/figures/superman">superman</a>.</p>
        </div>
        <div>
          <h3>Avancée</h3>
          <p>Les figures avancées demandent force, souplesse et beaucoup de pratique&nbsp;: <a href="/figures/ayesha">ayesha</a>, <a href="/figures/jade-split">jade split</a>, <a href="/figures/iron-x">iron X</a> ou <a href="/figures/jallegra">jallegra</a>. Travaille-les toujours avec une professeure et un tapis, et prends le temps de maîtriser les figures qui y mènent.</p>
        </div>
      </div>
    </section>
  </main>
  <WaitlistModal slot="after-footer" />
  <Fragment slot="head">
    <script is:inline>
      addEventListener("pagereveal", (e) => { const from = window.navigation && navigation.activation && navigation.activation.from && navigation.activation.from.url; if (e.viewTransition && from && new URL(from).pathname === "/") document.documentElement.classList.add("vt-in"); });
    </script>
  </Fragment>

  <Fragment slot="scripts">
    <script is:inline src="/vendor/Flip.min.js"></script>
    <script is:inline>
    // hero collage (like the Concept page): as you scroll down, the photos drift up and outwards and fade
    document.addEventListener("DOMContentLoaded", () => {
      const hero = document.querySelector(".fx .hero");
      if (!hero || matchMedia("(prefers-reduced-motion: reduce)").matches || !window.gsap || !window.ScrollTrigger) return;
      gsap.registerPlugin(ScrollTrigger);
      if (window.lenis) window.lenis.on("scroll", ScrollTrigger.update);
      const figs = [...hero.querySelectorAll(".cf")];
      gsap.to(figs, {
        y: (i, el) => -innerHeight * 0.35 * +el.dataset.depth,
        x: (i, el) => +el.dataset.side * innerWidth * 0.05 * +el.dataset.depth,
        opacity: 0, ease: "none",
        scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: true, invalidateOnRefresh: true },
      });
      addEventListener("load", () => ScrollTrigger.refresh());
    });
    </script>
  </Fragment>
</BaseLayout>

<script>
  const PAGE = 24; // 6 rows of 4, or 3 rows of 8
  const grid = document.getElementById("fg-grid")!;
  const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".card"));
  const q = document.getElementById("fg-q") as HTMLInputElement;
  const clearBtn = document.getElementById("fg-clear") as HTMLButtonElement;
  const more = document.getElementById("fg-more") as HTMLButtonElement;
  const empty = document.getElementById("fg-empty")!;
  const title = document.getElementById("fg-title")!;
  const count = document.getElementById("fg-count")!;
  const groups = Array.from(document.querySelectorAll<HTMLElement>(".filters"));
  const views = Array.from(document.querySelectorAll<HTMLButtonElement>(".views .v"));
  const sel: Record<string, string> = { level: "", cat: "" };
  let limit = PAGE;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const norm = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  const okQ = (c: HTMLElement, nq: string) => !nq || norm(`${c.dataset.name} ${c.dataset.alias}`).includes(nq);
  const ok = (c: HTMLElement, key: "level" | "cat") => !sel[key] || c.dataset[key] === sel[key];

  // Every change goes through here: the grid's before/after is captured and Flip glides each photo to its new place.
  let flipTl: any = null;
  function change(mutate: () => void, duration = 0.7) {
    const w = window as any;
    if (reduce || !w.Flip || !w.gsap) { mutate(); return; }
    if (flipTl) flipTl.progress(1);
    const state = w.Flip.getState(cards);
    const h0 = grid.offsetHeight;
    mutate();
    // the photos are lifted out of the grid while they glide, so hold the grid's height and ease it to the new one (keeps the footer still)
    const h1 = grid.offsetHeight;
    w.gsap.fromTo(grid, { height: h0 }, { height: h1, duration, ease: "power3.inOut", overwrite: true, clearProps: "height" });
    flipTl = w.Flip.from(state, {
      duration, ease: "power3.inOut", absolute: true, stagger: 0.012, prune: true,
      onEnter: (els: Element[]) => w.gsap.fromTo(els, { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.5, ease: "power2.out", delay: 0.15 }),
      onLeave: (els: Element[]) => w.gsap.to(els, { opacity: 0, scale: 0.92, duration: 0.35, ease: "power2.in" }),
    });
  }

  function render() {
    const nq = norm(q.value.trim());
    const matches = cards.filter((c) => okQ(c, nq) && ok(c, "level") && ok(c, "cat"));
    cards.forEach((c) => (c.hidden = true));
    matches.forEach((c, i) => (c.hidden = i >= limit));
    const n = matches.length;
    title.textContent = !nq && !sel.level && !sel.cat ? "Toutes les figures" : "Résultats";
    count.textContent = `(${n})`;
    const left = n - Math.min(n, limit);
    more.hidden = left <= 0;
    more.querySelector(".pill-t")!.textContent = `Voir plus de figures (${left})`;
    empty.hidden = n > 0;
    clearBtn.hidden = !q.value;
    // live counts: what each option would show with the other filter and the search
    groups.forEach((g) => {
      const key = g.dataset.key as "level" | "cat";
      const other = key === "level" ? "cat" : "level";
      g.querySelectorAll<HTMLButtonElement>(".f").forEach((b) => {
        b.setAttribute("aria-pressed", String(b.dataset.value === sel[key]));
        const sup = b.querySelector("sup");
        if (sup) sup.textContent = String(cards.filter((c) => okQ(c, nq) && ok(c, other) && c.dataset[key] === b.dataset.value).length);
      });
    });
  }

  groups.forEach((g) => g.querySelectorAll<HTMLButtonElement>(".f").forEach((b) => b.addEventListener("click", () => {
    const key = g.dataset.key!;
    if (sel[key] === b.dataset.value) return;
    change(() => { sel[key] = b.dataset.value!; limit = PAGE; render(); });
  })));
  const viewsBox = document.querySelector(".views")!;
  views.forEach((v) => v.addEventListener("click", () => {
    if (v.getAttribute("aria-pressed") === "true") return;
    change(() => {
      views.forEach((x) => x.setAttribute("aria-pressed", String(x === v)));
      viewsBox.classList.toggle("is-dense", v.dataset.cols === "dense");
      grid.classList.toggle("is-dense", v.dataset.cols === "dense");
    }, 0.9);
  }));
  let typing: number | undefined;
  q.addEventListener("input", () => { clearTimeout(typing); typing = window.setTimeout(() => change(() => { limit = PAGE; render(); }, 0.55), 120); });
  clearBtn.addEventListener("click", () => { q.value = ""; q.focus(); change(() => { limit = PAGE; render(); }, 0.55); });
  more.addEventListener("click", () => change(() => { limit += PAGE; render(); }, 0.6));
  document.getElementById("fg-reset")!.addEventListener("click", () => change(() => { q.value = ""; sel.level = ""; sel.cat = ""; limit = PAGE; render(); }));

  // Opening a figure: the clicked photo is handed to the trick page (it glides into the tall photo there)
  // and the other photos on screen squash into thin lines (cross-document view transition; plain navigation where unsupported).
  const canVT = "onpagereveal" in window && !reduce;
  const named: HTMLElement[] = [];
  const clearNames = () => { named.forEach((el) => { el.style.viewTransitionName = ""; el.style.removeProperty("view-transition-class"); }); named.length = 0; };
  if (canVT) {
    cards.forEach((card) => card.addEventListener("click", (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e as MouseEvent).button !== 0) return;
      clearNames();
      const vh = innerHeight;
      cards.forEach((c, i) => {
        if (c.hidden) return;
        const r = c.getBoundingClientRect();
        if (r.bottom < 0 || r.top > vh) return;
        const ph = c.querySelector<HTMLElement>(".ph")!;
        if (c === card) ph.style.viewTransitionName = "trick-photo";
        else { ph.style.viewTransitionName = `fg-${i}`; ph.style.setProperty("view-transition-class", "fg-gone"); }
        named.push(ph);
      });
    }));
    // coming back from a trick page: its photo glides back into its tile
    addEventListener("pagereveal", (e: any) => {
      const from = (window as any).navigation?.activation?.from?.url as string | undefined;
      if (!e.viewTransition || !from) return;
      const slug = new URL(from).pathname.replace(/\/$/, "").split("/").pop();
      const card = cards.find((c) => c.getAttribute("href")?.endsWith(`/${slug}`) && !c.hidden);
      if (!card) return;
      const ph = card.querySelector<HTMLElement>(".ph")!;
      ph.style.viewTransitionName = "trick-photo";
      named.push(ph);
      e.viewTransition.finished.finally(clearNames);
    });
    addEventListener("pageshow", (e) => { if ((e as PageTransitionEvent).persisted) clearNames(); });
  }
  render();
</script>

<style>
  .fx { --ink: #1f1d1e; --red: #401f28; color: #3b3b3b; background: #fff; padding: calc(var(--nav--height-total, 6rem) + 1rem) var(--site--margin) var(--_spacing---section-space--main); font-family: var(--_typography---font--primary-family), sans-serif; }
  .fx p, .fx h1, .fx h2 { margin: 0; }
  .fx > * p::before, .fx > * p::after, .fx h1::before, .fx h1::after, .fx h2::before, .fx h2::after { content: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ttl, .h2, .nm, .empty-t { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); letter-spacing: -.01em; color: var(--ink); }
  .ttl { letter-spacing: var(--_typography---letter-spacing--tight, -.03em); }
  .eb { margin-bottom: 0 !important; }

  /* header: like the Concept page — a collage of photos around the title, full screen; the photos drift away as you scroll */
  .hero { position: relative; height: 100svh; min-height: 40rem; margin: calc(-1 * (var(--nav--height-total, 6rem) + 1rem)) calc(-1 * var(--site--margin, 2.5rem)) 0; overflow: hidden; }
  .col { position: absolute; inset: 0; }
  .cf { position: absolute; left: var(--mx, var(--x)); top: var(--my, var(--y)); width: var(--mw, var(--w)); height: var(--mh, var(--h)); margin: 0; overflow: hidden; will-change: transform, opacity; }
  .cf.faded img { opacity: .35; }
  .cf img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; }
  .center { position: absolute; left: 50%; top: 50%; z-index: 2; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 1.5rem; text-align: center; }
  .ttl { margin-top: 0; font-size: 9.375rem; line-height: 1; white-space: nowrap; }
  .vt-title { view-transition-name: figures-title; }
  :global(html.vt-in) .ttl { --heart-delay: 1.4s; }
  .intro { width: 30rem; max-width: calc(100vw - 3rem); text-wrap: balance; font-size: var(--_typography---font-size--text-main); line-height: 1.5; }

  /* title row: search + view switch */
  .bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 2.5rem; margin-top: 2.5rem; }
  .guide { margin-top: clamp(5rem, 9vw, 8rem); padding-top: 2.5rem; border-top: 1px solid rgb(31 29 30 / 14%); }
  .gcols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; margin-top: 2.5rem; }
  .gcols h3 { margin: 0 0 .875rem; font-family: var(--_typography---font--primary-family), sans-serif; font-size: .75rem; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #6b6667; }
  .gcols p { margin: 0; font-size: var(--_typography---font-size--text-main); line-height: 1.6; }
  .gcols a { color: var(--ink); text-decoration: underline; text-decoration-color: rgb(31 29 30 / 30%); text-underline-offset: .2em; transition: color .3s, text-decoration-color .3s; }
  .gcols a:hover { color: var(--red); text-decoration-color: currentColor; }
  @media (max-width: 767px) { .gcols { grid-template-columns: 1fr; gap: 2rem; } }
  .h2 { display: block; margin-top: 0; font-size: clamp(2.25rem, 3.1vw, 2.75rem); line-height: 1; }
  .h2 sup { font-family: var(--_typography---font--primary-family), sans-serif; font-weight: 400; letter-spacing: 0; font-size: .8125rem; vertical-align: top; margin-left: .25rem; color: #3b3b3b; }
  .tools { display: flex; align-items: center; gap: .625rem; }
  .search { display: flex; align-items: center; gap: .625rem; width: 16.25rem; height: 3.375rem; padding: 0 1.25rem; border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: rgb(255 255 255 / 20%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); color: #3b3b3b; cursor: text; transition: width .5s cubic-bezier(.65, 0, .35, 1), border-color .3s; }
  .search:focus-within, .search:has(input:not(:placeholder-shown)) { width: 22.5rem; border-color: var(--red); }
  .search:focus-within svg { color: var(--red); }
  .search svg { flex: none; transition: color .3s; }
  .search input { flex: 1; min-width: 0; border: 0; background: none; padding: 0; font: inherit; font-size: .9375rem; color: var(--ink); outline: none; -webkit-appearance: none; appearance: none; }
