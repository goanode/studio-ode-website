---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaitlistModal from "../../components/WaitlistModal.astro";
import { tricks, LEVELS, figSrcset } from "../../data/tricks";
import { content } from "../../data/trickContent";
// Trick page (design "TrickPage", after Brandon Yasin): the name sits large at the bottom left and stays put,
// a tall photo on the right with the intro, tip and steps under it, then the next figure.
// Coming from the catalogue, the clicked photo glides into place (cross-document view transition, see figures.astro).

export function getStaticPaths() {
  // same order as the catalogue: by level, then A–Z
  const ordered = [...tricks].sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level) || a.name.localeCompare(b.name));
  return ordered.map((trick, i) => ({ params: { slug: trick.slug }, props: { trick, index: i + 1, next: ordered[(i + 1) % ordered.length], total: ordered.length } }));
}

const { trick, index, next, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const c = content[trick.slug];
const kind = trick.category === "Inversion" ? "une inversion" : trick.category === "Sol" ? "un mouvement au sol" : trick.category === "Rotation" ? "une rotation" : trick.category === "Montée" ? "une montée" : trick.category === "Assise" ? "une assise" : "une figure tenue";
const lvl = trick.level.toLowerCase();
// SEO: every page names the figure, its alias, "pole dance", its level and Lille
const intro = c?.intro ?? `${trick.name}${trick.alias ? `, aussi appelée « ${trick.alias} »,` : ""} est ${kind} de pole dance de niveau ${lvl}, enseignée en cours au studio Ode à Lille.`;
// the catalogue aims at pole dancers everywhere (not only Lille): "how to do X in pole dance", steps, tips, level
const aka = trick.alias ? ` (${trick.alias})` : "";
const description = `${trick.name}${aka} en pole dance, niveau ${lvl} : ${c ? c.intro + " " : ""}Les étapes, le conseil clé et les figures à maîtriser avant.`;
// internal links: figures to master first, then others of the same level (same type first)
const bySlug = Object.fromEntries(tricks.map((t) => [t.slug, t]));
const pre = (c?.pre ?? []).map((sl) => bySlug[sl]).filter(Boolean);
const related = tricks
  .filter((t) => t.slug !== trick.slug && t.level === trick.level && !pre.includes(t))
  .sort((a, b) => Number(b.category === trick.category) - Number(a.category === trick.category))
  .slice(0, 4);
const srcset = (base: string) => `${base}-p-500.webp 500w, ${base}-p-800.webp 800w, ${base}.webp 1024w`;
// the title heart hangs off the last word, wherever the name wraps
const _w = trick.name.split(" ");
const last = _w.pop();
const head = _w.length ? _w.join(" ") + " " : "";
---

<BaseLayout title={`${trick.name} en pole dance : étapes et conseils (${lvl}) | Ode`} viewTransition="trick-main" description={description} wfPage="6a96e3c256f4431a13f9f238">
  <main id="main" class="page_main tp u-theme-light">
    <a class="back" href="/figures" data-back><span aria-hidden="true">←</span> Toutes les figures</a>
    <div class="cols">
      <div class="left">
        <div class="stick">
          <h1 class="ttl"><span class="ode-th"><span class="mask"><span class="txt">{head}<span class="lw">{last}<img class="ode-title-heart" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></span></span></span></span></h1>
          <dl class="meta">
            <div><dt>Niveau</dt><dd>{trick.level}</dd></div>
            <div><dt>Type</dt><dd>{trick.category}</dd></div>
            {trick.alias && <div><dt>Aussi appelée</dt><dd>{trick.alias}</dd></div>}
            <div><dt>Étapes</dt><dd>{c ? pad(c.steps.length) : "bientôt"}</dd></div>
          </dl>
        </div>
      </div>
      <div class="right">
        <figure id="trick-main" class:list={["photo", { wide: trick.w > trick.h }]} style={`background-image: url(${trick.image}-p-500.webp)`}>
          <img src={`${trick.image}.webp`} srcset={figSrcset(trick)} width={trick.w} height={trick.h} sizes={trick.w > trick.h ? "(max-width: 767px) 100vw, 36vw" : "(max-width: 767px) 100vw, 44vw"} alt={`${trick.name}${aka}, figure de pole dance ${lvl}`} style={`object-position: ${trick.imagePosition}${trick.mirrored ? "; transform: scaleX(-1)" : ""}`} fetchpriority="high" />
        </figure>
        <p class="intro">{intro}</p>
        {c?.tip && <p class="tip"><b>Conseil</b> : {c.tip}</p>}
        {c ? (
          <ol class="steps">
            {c.steps.map((s, i) => (
              <li>
                <span class="n">{pad(i + 1)}</span>
                <div><h2 class="st">{s.title}</h2><p>{s.text}</p></div>
              </li>
            ))}
          </ol>
        ) : (
          <p class="soon">Les étapes détaillées de cette figure arrivent bientôt.</p>
        )}
        {pre.length > 0 && (
          <div class="links">
            <h2 class="lk-h">Avant de commencer</h2>
            <p>Maîtrise d’abord {pre.map((t, i) => <>{i > 0 && (i === pre.length - 1 ? " et " : ", ")}<a href={`/figures/${t.slug}`}>{t.name}</a></>)}.</p>
          </div>
        )}
        <div class="links">
          <h2 class="lk-h">Dans le même niveau</h2>
          <ul>{related.map((t) => <li><a href={`/figures/${t.slug}`}>{t.name}</a><span>{t.category}</span></li>)}</ul>
        </div>
        <p class="cta">Envie de l’apprendre en cours&nbsp;? Ode ouvre à Lille en 2027. <button type="button" data-modal-trigger="waitlist">Réserve ta place →</button></p>
      </div>
    </div>

    <nav class="next" aria-label="Figure suivante">
      <div>
        <p class="lab">Figure suivante</p>
        <p class="nx">{next.name}</p>
      </div>
      <a class="pill" href={`/figures/${next.slug}`} aria-label={`Voir la figure suivante : ${next.name}`}>Voir la figure<img class="hrt" src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></a>
    </nav>
  </main>
  <WaitlistModal slot="after-footer" />
  <Fragment slot="head">
    <script is:inline>
      // arriving from the catalogue with a page transition: let the photo land before the name rises
      addEventListener("pagereveal", (e) => {
        if (e.viewTransition) document.documentElement.classList.add("from-grid");
      });
      // "Toutes les figures" behaves like the browser's back button when the catalogue is in this tab's history:
      // the grid comes back with its filters and scroll position, and the photo glides back into its tile.
      addEventListener("click", (e) => {
        const a = e.target instanceof Element && e.target.closest("a[data-back]");
        if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        const isGrid = (u) => { try { const x = new URL(u); return x.origin === location.origin && x.pathname.replace(/\/$/, "") === "/figures"; } catch { return false; } };
        const nav = window.navigation;
        if (nav && nav.entries && nav.currentEntry) {
          const list = nav.entries().slice(0, nav.currentEntry.index).reverse();
          const hit = list.find((en) => isGrid(en.url));
          if (hit) { e.preventDefault(); nav.traverseTo(hit.key); }
          return;
        }
        if (isGrid(document.referrer) && history.length > 1) { e.preventDefault(); history.back(); }
      });
    </script>
  </Fragment>
</BaseLayout>

<style>
  .tp { --ink: #1f1d1e; --red: #401f28; position: relative; color: #3b3b3b; background: #fff; padding: var(--nav--height-total, 6rem) 0 0; font-family: var(--_typography---font--primary-family), sans-serif; }
  .tp p, .tp h1, .tp h2, .tp ol, .tp dl, .tp dd { margin: 0; padding: 0; }
  .tp p::before, .tp p::after, .tp h1::before, .tp h1::after, .tp h2::before, .tp h2::after { content: none; }
  .ttl, .st, .nx { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); letter-spacing: -.01em; color: var(--ink); }
  .ttl, .nx { letter-spacing: var(--_typography---letter-spacing--tight, -.03em); }

  .back { position: absolute; left: var(--site--margin, 2.5rem); top: calc(var(--nav--height-total, 6rem) + .5rem); z-index: 2; display: inline-flex; gap: .5rem; font-size: .875rem; color: #3b3b3b; text-decoration: none; transition: color .3s; }
  .back:hover { color: var(--red); }

  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 36vw); gap: 0 4rem; padding: 0 8.3vw 0 var(--site--margin, 2.5rem); }
  /* left: the name stays at the bottom of the screen while the right column scrolls */
  .stick { position: sticky; top: 0; height: 100svh; margin-top: calc(var(--nav--height-total, 6rem) * -1); display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; padding-bottom: 2.5rem; }
  .eb { margin-bottom: 0 !important; }
  .ttl { margin-top: 1rem !important; font-size: clamp(4.5rem, 10.4vw, 9.5rem); line-height: 1; --heart-delay: 1.2s; }
  /* the name rises out of a mask that only clips at the bottom, so the heart after the last word can stick out */
  .ttl .mask { display: block; clip-path: inset(-1em -1em 0 -1em); padding-bottom: .06em; }
  .ttl .lw { position: relative; display: inline-block; white-space: nowrap; }
  :global(html.from-grid) .ttl { --heart-delay: 1.8s; }
  .ttl .txt { display: block; animation: rise 1.1s cubic-bezier(.22, .8, .25, 1) .45s both; }
  :global(html.from-grid) .ttl .txt { animation-delay: 1.05s; }
  :global(html.from-grid) .meta { animation-delay: 1.4s; }
  .meta { display: flex; flex-wrap: wrap; gap: 1rem 3.5rem; margin-top: 2.25rem !important; opacity: 0; animation: fadeUp .8s ease .85s forwards; }
  .meta dt { margin-bottom: .375rem; font-size: .75rem; color: #6b6667; }
  .meta dd { font-size: .9375rem; color: var(--ink); }
  @keyframes rise { from { transform: translateY(105%); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(.625rem); } to { opacity: 1; transform: none; } }

  /* right: tall photo, then the text */
  .right { padding-top: 1.5rem; }
  .photo { margin: 0; height: min(84svh, 47.5rem); overflow: hidden; background: #d9d7d7 center / cover no-repeat; view-transition-name: trick-photo; }
  .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* landscape photos (horizontal figures) are shown whole, not cropped into the tall frame */
  .photo.wide { height: auto; }
  .photo.wide img { height: auto; }
  .links { margin-top: 3rem; }
  .lk-h { margin: 0 0 .875rem !important; font-size: .75rem !important; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: #6b6667; font-family: var(--_typography---font--primary-family), sans-serif !important; }
  .links p { font-size: var(--_typography---font-size--text-main); line-height: 1.5; }
  .links a { color: var(--ink); text-decoration: underline; text-decoration-color: rgb(31 29 30 / 30%); text-underline-offset: .2em; transition: color .3s, text-decoration-color .3s; }
  .links a:hover { color: var(--red); text-decoration-color: currentColor; }
  .links ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgb(31 29 30 / 14%); }
  .links li { display: flex; justify-content: space-between; align-items: baseline; padding: .875rem 0; border-bottom: 1px solid rgb(31 29 30 / 14%); }
  .links li a { font-family: var(--_typography---font--secondary-family); font-size: 1.5rem; letter-spacing: -.01em; text-decoration: none; }
  .links li span { font-size: .8125rem; color: #6b6667; }
  .cta { margin: 3rem 0 0 !important; font-size: var(--_typography---font-size--text-main); line-height: 1.5; color: #6b6667; }
  .cta button { padding: 0; border: 0; border-bottom: 1px solid currentColor; background: none; font: inherit; color: var(--red); cursor: pointer; }
  .intro { margin-top: 3.5rem !important; font-size: 1.625rem; line-height: 1.3; color: var(--ink); }
  .tip { margin-top: 1.75rem !important; padding: 1.125rem 1.25rem !important; border-left: 2px solid var(--red); background: #faf8f8; font-size: var(--_typography---font-size--text-main); line-height: 1.5; }
  .tip b { color: var(--red); font-weight: 500; }
  .steps { list-style: none; margin-top: 4.5rem !important; border-top: 1px solid rgb(31 29 30 / 14%); }
  .steps li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.625rem 0; border-bottom: 1px solid rgb(31 29 30 / 14%); }
  .n { padding-top: .5rem; font-size: .8125rem; color: var(--red); }
  .st { margin: 0; font-size: 1.875rem; line-height: 1.1; }
  .steps p { margin-top: .5rem !important; font-size: var(--_typography---font-size--text-main); line-height: 1.5; }
  .soon { margin-top: 4.5rem !important; padding: 1.625rem 0 !important; border-top: 1px solid rgb(31 29 30 / 14%); border-bottom: 1px solid rgb(31 29 30 / 14%); font-size: var(--_typography---font-size--text-main); line-height: 1.5; }

  .next { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-top: var(--_spacing---section-space--main); padding: 2.5rem var(--site--margin) 4rem; border-top: 1px solid rgb(31 29 30 / 14%); }
  .lab { font-size: .75rem; color: #6b6667; margin-bottom: .375rem !important; }
  .nx { font-size: calc(var(--_typography---font-size--h1) * 1.125); line-height: 1; }
  .pill { position: relative; display: inline-flex; align-items: center; padding: 0 1.5rem; min-height: calc(var(--_typography---font-size--text-main) + 1.6rem); font-size: var(--_typography---font-size--text-main); border-radius: 9999px; border: 1px solid rgb(31 29 30 / 20%); background: rgb(255 255 255 / 20%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); line-height: 1; color: var(--ink); text-decoration: none; white-space: nowrap; transition: background-color .35s, border-color .35s, color .35s; }
  .pill:hover, .pill:focus-visible { background: var(--red); border-color: var(--red); color: #fff; }
  .hrt { position: absolute; right: -.5rem; top: -.5rem; width: 2.125rem; height: auto; pointer-events: none; opacity: 0; transform: translateY(.875rem) rotate(-30deg) scale(.3); transition: transform .55s cubic-bezier(.3, 1.8, .5, 1), opacity .2s; filter: drop-shadow(0 6px 8px rgb(0 0 0 / 25%)); }
  .pill:hover .hrt, .pill:focus-visible .hrt { opacity: 1; transform: translateY(-.625rem) rotate(12deg) scale(1); }
  .back:focus-visible, .pill:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .ttl .txt, .meta { animation: none; opacity: 1; }
  }
  @media (max-width: 767px) {
    .back { left: var(--site--margin); top: calc(var(--nav--height-total, 6rem) + .25rem); }
    .cols { grid-template-columns: 1fr; padding: 2.75rem var(--site--margin) 0; }
    .stick { position: static; height: auto; margin: 0; padding: 0 0 1.75rem; }
    .ttl { font-size: clamp(3.5rem, 18vw, 4.5rem); }
    .meta { gap: .75rem 1.75rem; margin-top: 1.25rem !important; }
    .right { padding-top: 0; }
    .photo { height: 30rem; }
    .intro { margin-top: 2.25rem !important; font-size: 1.3125rem; }
    .st { font-size: 1.5rem; }
    .steps li { grid-template-columns: 2.25rem 1fr; }
    .next { flex-direction: column; align-items: flex-start; gap: 1.25rem; padding: 1.75rem var(--site--margin) 3rem; }
  }
</style>
