---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaitlistModal from "../../components/WaitlistModal.astro";
import FigureHero from "../../components/FigureHero.astro";
import { tricks, LEVELS } from "../../data/tricks";
import { content } from "../../data/trickContent";

export function getStaticPaths() {
  // same order as the catalogue: by level, then A–Z
  const ordered = [...tricks].sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level) || a.name.localeCompare(b.name));
  return ordered.map((trick, i) => ({ params: { slug: trick.slug }, props: { trick, next: ordered[(i + 1) % ordered.length], nextIndex: ((i + 1) % ordered.length) + 1, total: ordered.length } }));
}

const { trick, next, nextIndex, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const c = content[trick.slug];
const intro = c?.intro ?? `${trick.category === "Inversion" ? "Une inversion" : trick.category === "Sol" ? "Un mouvement au sol" : trick.category === "Rotation" ? "Une rotation" : trick.category === "Montée" ? "Une montée" : trick.category === "Assise" ? "Une assise" : "Une figure tenue"} de niveau ${trick.level.toLowerCase()}${trick.alias ? `, aussi appelée ${trick.alias}` : ""}.`;
---

<!-- Home page id: same hero load animation as the homepage and the catalogue -->
<BaseLayout title={`${trick.name} — Figures — Studio Ode`} description={intro} wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <main id="main" class="page_main">
    <FigureHero title={trick.name} image={trick.image} short />

    <div class="fp-body">
      <!-- Design M1: editorial sheet (labels in brackets, 12-column grid, process-style step rows) -->
      <article class="fp-wrap">
        <div class="fp-meta">
          <p class="fp-lab"><span>(niveau)</span>{trick.level}</p>
          <p class="fp-lab"><span>(type)</span>{trick.category}</p>
          <p class="fp-lab"><span>(étapes)</span>{c ? pad(c.steps.length) : "bientôt"}</p>
          {trick.alias && <p class="fp-lab"><span>(aussi appelée)</span>{trick.alias}</p>}
        </div>

        <div class="fp-12">
          <h2 class="fp-title">{trick.name}</h2>
          <figure class="fp-photo">
            <img src={`${trick.image}.webp`} srcset={`${trick.image}-p-500.webp 500w, ${trick.image}-p-800.webp 800w, ${trick.image}.webp 1024w`} sizes="(max-width: 767px) 100vw, 55vw" alt={`${trick.name} à la barre`} loading="lazy" style={`object-position: ${trick.imagePosition}; ${trick.mirrored ? "transform: scaleX(-1);" : ""}`} />
          </figure>
          <div class="fp-side">
            <div class="fp-brief">
              <p class="fp-lab"><span>(en bref)</span></p>
              <p class="fp-intro">{intro}</p>
            </div>
            {c?.tip && <p class="fp-lab fp-tip"><span>(conseil)</span>{c.tip}</p>}
          </div>
        </div>

        <div class="fp-steps-head"><p class="fp-lab"><span>(les étapes)</span></p>{c && <p class="fp-lab">{pad(c.steps.length)}</p>}</div>
        {c ? (
          <ol class="fp-steps">
            {c.steps.map((s, i) => (
              <li>
                <span class="fp-lab fp-n">({pad(i + 1)})</span>
                <h3 class="fp-st">{s.title}</h3>
                <p class="fp-sp">{s.text}</p>
              </li>
            ))}
          </ol>
        ) : (
          <p class="fp-soon">Les étapes de cette figure arrivent bientôt. En attendant, viens la travailler en cours avec Justine.</p>
        )}

        <nav class="fp-nav" aria-label="Navigation entre les figures">
          <a href="/figures" class="fp-back">← Toutes les figures</a>
          <a href={`/figures/${next.slug}`} class="fp-next-link">
            <span class="fp-lab"><span>(suivante)</span>{pad(nextIndex)} / {total}</span>
            <span class="fp-next">{next.name} →</span>
          </a>
        </nav>
      </article>
    </div>
  </main>

  <WaitlistModal slot="after-footer" />
</BaseLayout>

<style>
  .fp-body { position: relative; z-index: 1; background: var(--_theme---background, #fff); padding-top: 1px; }
  .fp-wrap { padding: 6rem 0 7.5rem; width: calc(100% - var(--site--margin) * 2); max-width: var(--max-width--main); margin-left: auto; margin-right: auto; color: var(--swatch--dark-800); }
  .fp-serif { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); }
  .fp-lab { margin: 0; font-size: .875rem; line-height: 1.5; color: var(--swatch--dark-800); }
  .fp-lab > span { opacity: .55; margin-right: .5rem; }
  .fp-meta { display: flex; flex-wrap: wrap; gap: .75rem 2.5rem; padding: 1rem 0; border-top: 1px solid var(--swatch--dark-900-o20); border-bottom: 1px solid var(--swatch--dark-900-o20); }
  .fp-12 { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; }
  /* line-height 1.15 leaves room for descenders (the "p" of "spin") */
  .fp-title { grid-column: 1 / -1; margin: 3.5rem 0 4rem; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(4.5rem, 10vw, 10.5rem); line-height: 1.15; letter-spacing: -.01em; color: var(--swatch--dark-800); text-wrap: balance; }
  .fp-photo { grid-column: 1 / 8; position: relative; margin: 0; aspect-ratio: 4 / 5; border-radius: var(--radius--main); overflow: hidden; background: var(--swatch--dark-800); }
  .fp-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fp-side { grid-column: 9 / 13; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .fp-brief { display: flex; flex-direction: column; gap: 1rem; }
  .fp-intro { margin: 0; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 2rem; line-height: 1.25; color: var(--swatch--dark-900); }
  .fp-steps-head { display: flex; justify-content: space-between; align-items: baseline; margin: 7.5rem 0 1.5rem; }
  .fp-steps { list-style: none; margin: 0; padding: 0; }
  .fp-steps li { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; align-items: start; padding: 1.75rem 0; border-top: 1px solid var(--swatch--dark-900-o20); }
  .fp-steps li:last-child { border-bottom: 1px solid var(--swatch--dark-900-o20); }
  /* small label + text nudged down to sit on the serif title's first line */
  .fp-n { grid-column: 1 / 3; padding-top: .7rem; }
  .fp-st { grid-column: 3 / 8; margin: 0; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 2rem; line-height: 1.15; letter-spacing: normal; color: var(--swatch--dark-900); }
  .fp-sp { grid-column: 9 / 13; margin: 0; padding-top: .55rem; font-size: 1rem; line-height: 1.55; }
  .fp-soon { margin: 0; padding: 1.75rem 0; border-top: 1px solid var(--swatch--dark-900-o20); border-bottom: 1px solid var(--swatch--dark-900-o20); font-size: 1.125rem; line-height: 1.5; }
  .fp-nav { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-top: 6rem; padding-top: 1.5rem; border-top: 1px solid var(--swatch--dark-900-o20); }
  .fp-back { font-size: 1rem; }
  .fp-back:hover, .fp-next-link:hover .fp-next { text-decoration: underline; text-underline-offset: .15em; }
  .fp-next-link { display: flex; flex-direction: column; align-items: flex-end; gap: .375rem; text-align: right; }
  .fp-next { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 2.5rem; line-height: 1.15; color: var(--swatch--dark-900); }
  .fp-back:focus-visible, .fp-next-link:focus-visible { outline: 2px solid var(--swatch--dark-900); outline-offset: 4px; }
  @media (max-width: 767px) {
    .fp-wrap { padding: 3rem 0 4.5rem; }
    .fp-meta { gap: .5rem 1.5rem; }
    .fp-12 { grid-template-columns: 1fr; }
    .fp-title { margin: 2rem 0; font-size: 4rem; }
    .fp-photo, .fp-side { grid-column: 1 / -1; }
    .fp-side { margin-top: 1.5rem; }
    .fp-intro { font-size: 1.5rem; }
    .fp-steps-head { margin: 4rem 0 1rem; }
    .fp-steps li { grid-template-columns: 3rem minmax(0, 1fr); row-gap: .5rem; padding: 1.25rem 0; }
    .fp-n { grid-column: 1; grid-row: 1 / 3; }
    .fp-st, .fp-sp { grid-column: 2; }
    .fp-sp { padding-top: 0; }
    .fp-n { padding-top: .45rem; }
    .fp-st { font-size: 1.625rem; }
    .fp-nav { flex-direction: column; align-items: flex-start; margin-top: 4rem; }
    .fp-next-link { align-items: flex-start; text-align: left; }
    .fp-next { font-size: 1.875rem; }
  }
</style>
