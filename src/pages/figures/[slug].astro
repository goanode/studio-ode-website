---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WaitlistModal from "../../components/WaitlistModal.astro";
import FigureHero from "../../components/FigureHero.astro";
import { tricks, LEVELS } from "../../data/tricks";
import { content } from "../../data/trickContent";

export function getStaticPaths() {
  // same order as the catalogue: by level, then A–Z
  const ordered = [...tricks].sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level) || a.name.localeCompare(b.name));
  return ordered.map((trick, i) => ({ params: { slug: trick.slug }, props: { trick, next: ordered[(i + 1) % ordered.length] } }));
}

const { trick, next } = Astro.props;
const c = content[trick.slug];
const intro = c?.intro ?? `${trick.category === "Inversion" ? "Une inversion" : trick.category === "Sol" ? "Un mouvement au sol" : trick.category === "Rotation" ? "Une rotation" : trick.category === "Montée" ? "Une montée" : trick.category === "Assise" ? "Une assise" : "Une figure tenue"} de niveau ${trick.level.toLowerCase()}${trick.alias ? `, aussi appelée ${trick.alias}` : ""}.`;
---

<!-- Home page id: same hero load animation as the homepage and the catalogue -->
<BaseLayout title={`${trick.name} — Figures — Studio Ode`} description={intro} wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <main id="main" class="page_main">
    <FigureHero title={trick.name} image={trick.image} short />

    <div class="fp-body">
      <section class="fp-wrap">
        <div class="fp-grid">
          <!-- Sharp photo of the pose, so it can be inspected -->
          <figure class="fp-photo">
            <img src={`${trick.image}.webp`} srcset={`${trick.image}-p-500.webp 500w, ${trick.image}-p-800.webp 800w, ${trick.image}.webp 1024w`} sizes="(max-width: 767px) 100vw, 45vw" alt={`${trick.name} à la barre`} loading="lazy" style={`object-position: ${trick.imagePosition}; ${trick.mirrored ? "transform: scaleX(-1);" : ""}`} />
            <figcaption class="fp-labels"><span class="card_classes_btn u-text-style-small">{trick.level}</span><span class="card_classes_btn u-text-style-small">{trick.category}</span></figcaption>
          </figure>

          <div class="fp-right">
            <h2 class="fp-title">{trick.name}</h2>
            <p class="fp-intro">{intro}</p>
            <div class="fp-steps-head">
              <div class="u-eyebrow-wrapper"><div class="u-eyebrow-layout"><div class="u-eyebrow-marker"></div><div class="u-eyebrow-text w-richtext"><p>Les étapes</p></div></div></div>
              {c && <p class="fp-count">{c.steps.length} étapes</p>}
            </div>
            {c ? (
              <ol class="fp-steps">
                {c.steps.map((s, i) => (
                  <li>
                    <span class="fp-n" aria-hidden="true">{i + 1}</span>
                    <div><h3 class="fp-st">{s.title}</h3><p>{s.text}</p></div>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="fp-soon">Les étapes de cette figure arrivent bientôt. En attendant, viens la travailler en cours avec Justine.</p>
            )}
          </div>
        </div>

        <nav class="fp-more" aria-label="Navigation entre les figures">
          <a href="/figures" class="fp-back">← Toutes les figures</a>
          <a href={`/figures/${next.slug}`} class="fp-pill fp-next">Figure suivante : {next.name} →</a>
        </nav>
      </section>
    </div>
  </main>

  <WaitlistModal slot="after-footer" />
</BaseLayout>

<style>
  /* Spacing on an 8px rhythm: 24 (title → intro), 48 (intro → steps), 96 (around the section) */
  .fp-body { position: relative; z-index: 1; background: var(--_theme---background, #fff); padding-top: 1px; }
  .fp-wrap { padding: 6rem 0; width: calc(100% - var(--site--margin) * 2); max-width: var(--max-width--main); margin-left: auto; margin-right: auto; }
  .fp-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 6rem; align-items: start; }
  .fp-photo { position: sticky; top: 1.5rem; margin: 0; aspect-ratio: 4 / 5; border-radius: var(--radius--main); overflow: hidden; background: var(--swatch--dark-800); }
  .fp-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fp-labels { position: absolute; left: 1.5rem; bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: .375rem; color: #fff; }
  .fp-right { display: flex; flex-direction: column; }
  /* line-height leaves room for descenders (the "p" of "spin"); negative top margin aligns the letters with the photo */
  .fp-title { margin: -.12em 0 0; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: clamp(3.5rem, 7vw, 7rem); line-height: 1.1; letter-spacing: -.01em; color: var(--swatch--dark-800); text-wrap: balance; }
  .fp-intro { margin: 1.5rem 0 0; max-width: 32rem; font-size: 1.125rem; line-height: 1.5; color: var(--swatch--dark-800); }
  .fp-steps-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 3rem 0 1.5rem; }
  .fp-steps-head .u-eyebrow-wrapper { margin: 0; }
  .fp-count { margin: 0; font-size: .875rem; color: var(--swatch--dark-800); }
  /* Steps (design L3): large serif numerals, serif step titles, hairlines; hovering one fades the others */
  .fp-steps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--swatch--dark-900-o20); }
  .fp-steps li { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1.5rem; align-items: start; padding: 1.75rem 0; border-bottom: 1px solid var(--swatch--dark-900-o20); transition: opacity .3s; }
  @media (hover: hover) { .fp-steps:hover li { opacity: .45; } .fp-steps:hover li:hover { opacity: 1; } }
  .fp-n { font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-variant-numeric: lining-nums; font-size: 4.5rem; line-height: .8; color: var(--swatch--dark-800); }
  .fp-steps .fp-st { margin: 0 0 .5rem; padding: 0; font-family: var(--_typography---font--secondary-family); font-weight: var(--_typography---font--primary-medium); font-size: 2rem; line-height: 1.1; letter-spacing: normal; color: var(--swatch--dark-900); }
  .fp-steps p { margin: 0; max-width: 30rem; font-size: 1rem; line-height: 1.55; color: var(--swatch--dark-800); }
  .fp-soon { margin: 0; padding: 1.75rem 0; border-top: 1px solid var(--swatch--dark-900-o20); border-bottom: 1px solid var(--swatch--dark-900-o20); font-size: 1.125rem; line-height: 1.5; color: var(--swatch--dark-800); }
  .fp-more { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 6rem; padding-top: 3rem; border-top: 1px solid var(--swatch--dark-900-o20); }
  .fp-back { font-size: 1rem; color: var(--swatch--dark-800); }
  .fp-back:hover { text-decoration: underline; }
  .fp-pill { height: 2.75rem; display: inline-flex; align-items: center; padding: 0 1.5rem; border-radius: var(--radius--round); border: 1px solid var(--swatch--dark-900-o20); color: var(--swatch--dark-800); font-size: 1.125rem; transition: border-color .2s, background-color .2s, color .2s; }
  .fp-next:hover { background: var(--swatch--dark-800); border-color: var(--swatch--dark-800); color: #fff; }
  .fp-back:focus-visible, .fp-next:focus-visible { outline: 2px solid var(--swatch--dark-900); outline-offset: 3px; }
  @media (max-width: 991px) { .fp-grid { gap: 3rem; } }
  @media (max-width: 767px) {
    .fp-wrap { padding: 3rem 0 4rem; }
    .fp-grid { grid-template-columns: 1fr; gap: 2rem; }
    .fp-photo { position: relative; top: 0; }
    .fp-labels { left: 1rem; bottom: 1rem; }
    .fp-title { font-size: 4rem; }
    .fp-intro { margin-top: 1rem; font-size: 1rem; }
    .fp-steps-head { margin: 2rem 0 1rem; }
    .fp-steps li { grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1rem; padding: 1.25rem 0; }
    .fp-n { font-size: 3rem; }
    .fp-steps .fp-st { font-size: 1.625rem; }
    .fp-more { margin-top: 4rem; padding-top: 2rem; }
    .fp-pill { height: 2.5rem; padding: 0 1.125rem; font-size: 1rem; }
  }
</style>
