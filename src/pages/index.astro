  <Fragment slot="scripts">
  <script is:inline src="/vendor/Flip.min.js"></script>
  <script is:inline>
  // course filters (All / Poledance / Flexibility / Flow / Strength) work like the Figures filters:
  // the chosen pill stays burgundy, the other classes fade and shrink away and the rest glide into place (GSAP Flip), slider back to the start.
  addEventListener("load", () => {
    const btns = [...document.querySelectorAll(".ode-course-filters [data-filter]")];
    const el = document.querySelector("#cours .slider_element");
    const sw = el && el.swiper;
    if (!btns.length || !sw) return;
    const slides = [...el.querySelectorAll(".card_classes_wrap")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = "", tl;
    const apply = (v) => {
      slides.forEach((s) => { s.style.display = !v || s.dataset.category === v ? "" : "none"; });
      sw.update(); sw.slideTo(0, 0);
    };
    btns.forEach((b) => b.addEventListener("click", () => {
      const v = b.dataset.filter;
      if (v === cur) return;
      cur = v;
      btns.forEach((x) => { x.setAttribute("aria-pressed", String(x === b)); x.closest(".button_main_wrap").classList.toggle("is-on", x === b); });
      if (reduce || !window.Flip || !window.gsap) { apply(v); return; }
      if (tl) tl.progress(1);
      const state = Flip.getState(slides);
      apply(v);
      tl = Flip.from(state, {
        duration: .7, ease: "power3.inOut", absolute: true, stagger: .012, prune: true,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: .92 }, { opacity: 1, scale: 1, duration: .5, ease: "power2.out", delay: .15 }),
        onLeave: (els) => gsap.to(els, { opacity: 0, scale: .92, duration: .35, ease: "power2.in" }),
      });
    }));
    btns[0].closest(".button_main_wrap").classList.add("is-on");
  });
  </script>
  <script is:inline>
gsap.registerPlugin(ScrollTrigger);
const splitTypes = document.querySelectorAll('.reveal-type');
splitTypes.forEach((char,i) => {
  const text = new SplitText(char, { type: 'words,chars', aria: 'none' });
  gsap.from(text.chars, {
    scrollTrigger: {
      trigger: char,
      start: 'top 80%',
      end: 'top 20%',
      scrub: true,
      markers: false
    },
    opacity: 0.2,
    stagger: 0.1,
  })
});
</script>
