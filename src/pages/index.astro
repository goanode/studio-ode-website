<BaseLayout viewTransition="main" title="Website Name" description="Place website meta description here" wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <Fragment slot="head">
  <script is:inline>
    // Preloader (P1): plays whenever the homepage is opened or reloaded, but not when coming from another page of
    // the site (menu click), when going back/forward, with reduced motion, or when opening a #section link
    try {
      const nav = performance.getEntriesByType("navigation")[0];
      const type = nav ? nav.type : "navigate";
      const internal = document.referrer && new URL(document.referrer).origin === location.origin;
      const show = type === "reload" || (type === "navigate" && !internal);
      if (show && !matchMedia("(prefers-reduced-motion: reduce)").matches && !location.hash) document.documentElement.classList.add("ode-pre", "ode-hold");
    } catch (e) {}
  </script>
  <style is:inline>
    strong, b {
      font-weight: inherit;
      opacity: 0.5;
    }
    /* Title hearts: same size as the heart on the Concept page title */
    /* Section titles (Concept, Communauté, Figures, Le visage…, Choisis ton cours, Questions?): 90px on desktop, scaled down on mobile */
    main .u-heading.w-variant-792802b6-ccdb-f982-5023-5fa970cf03d0, #faq .u-heading { --_text-style---font-size: calc(var(--_typography---font-size--h1) * 1.125); }
    .ode-th { --icon-base: calc(.34 * clamp(4rem, 6.7vw, 7.5rem)); }
    .ode-th .ode-title-heart:not(.ode-icon-question) { right: -.6em; }
    .ode-th .ode-title-heart.ode-icon-book { right: -.7em; }
    .ode-th .ode-title-heart.ode-icon-question { right: -.42em; }
  </style>
  </Fragment>

  <Fragment slot="body-start">
  <!-- Preloader (P1, like oharchitecture.com.au): "ODE" rolls up into "Coming soon 2027" while a thin burgundy line crosses the screen, then it fades away and ODE rises -->
  <div id="ode-pre" aria-hidden="true">
    <p class="roll"><span>ODE</span><span>Coming soon 2027</span></p>
    <i class="line"></i>
  </div>
  <script is:inline>
    (() => {
      const root = document.documentElement, pre = document.getElementById("ode-pre");
      if (!root.classList.contains("ode-pre")) { pre.remove(); return; }
      setTimeout(() => root.classList.remove("ode-hold"), 1250); // the big ODE starts rising as the photo settles
      setTimeout(() => { root.classList.remove("ode-pre"); pre.remove(); if (window.lenis) { lenis.start(); lenis.resize(); } }, 1650);
    })();
  </script>
  <div class="cursor_wrapper">
    <div class="cursor_element meet_teacher has-liquid-glass">
      <div class="cursor_text u-text-style-small">Contact me</div>
    </div>
  </div>
  </Fragment>

