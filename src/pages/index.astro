---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
---

<BaseLayout viewTransition="main" title="Cours de pole dance à Lille — Studio Ode" description="Ode, nouveau studio de pole dance à Lille : cours de débutante à avancée, pole flow, souplesse et renforcement, en petit groupe. Ouverture en 2027." wfPage="6a96e3c256f4431a13f9f238" flutedGlass>
  <Fragment slot="head">
  <script is:inline>
    (() => {
      const MAP = { "/concept": [".vt-concept", "concept-title"], "/communaute": [".vt-communaute", "communaute-title"], "/figures": [".vt-figures", "figures-title"] };
      const key = (u) => { try { return new URL(u, location.href).pathname.replace(/\.html$/, "").replace(/\/$/, ""); } catch { return ""; } };
      const name = (u) => { const m = MAP[key(u)]; if (!m) return null; const el = document.querySelector(m[0]); if (el) el.style.viewTransitionName = m[1]; return el; };
      // leaving the homepage for one of the three pages
      addEventListener("pageswap", (e) => { if (!window.__odeNavVT && e.viewTransition && e.activation && e.activation.entry) name(e.activation.entry.url); });
      // coming back to the homepage from one of them
      addEventListener("pagereveal", (e) => {
        const from = window.navigation && navigation.activation && navigation.activation.from;
        if (!e.viewTransition || !from) return;
        const el = name(from.url);
        if (el) e.viewTransition.finished.finally(() => { el.style.viewTransitionName = ""; });
      });
    })();
  </script>
  <script is:inline>if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("has-pl");</script>
  <style is:inline>
    .pl { display: none; }
    html.has-pl .pl { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: center; background: #fff; color: #1f1d1e; animation: pl-up .75s cubic-bezier(.76, 0, .24, 1) 1.8s forwards; pointer-events: none; }
    @keyframes pl-up { to { transform: translateY(-100%); visibility: hidden; } }
    .pl-wrap { position: relative; display: flex; flex-direction: column; align-items: center; }
    .pl-word { display: block; overflow: hidden; padding: 0 .04em .06em; font-family: var(--_typography---font--secondary-family), Georgia, serif; font-size: 7.5rem; line-height: 1.05; letter-spacing: -.03em; }
    .pl-word span { display: inline-block; transform: translateY(105%); animation: pl-rise .9s cubic-bezier(.16, 1, .3, 1) calc(.1s + var(--i) * .07s) forwards; }
    @keyframes pl-rise { to { transform: none; } }
    .pl-slot { position: absolute; right: -3.25rem; top: -.5rem; width: 3.25rem; height: 3.25rem; }
    .pl-slot img { position: absolute; inset: 0; width: 100%; height: auto; opacity: 0; filter: drop-shadow(0 .25rem .5rem rgb(0 0 0 / 22%)); animation: pl-swap .42s cubic-bezier(.3, 1.4, .5, 1) calc(.45s + var(--k) * .35s) both; }
    @keyframes pl-swap { 0% { opacity: 0; transform: scale(.6) rotate(-15deg); } 40%, 70% { opacity: 1; transform: scale(1) rotate(8deg); } 100% { opacity: 0; transform: scale(.85) rotate(20deg); } }
    .pl-slot img.last { animation: pl-land .5s cubic-bezier(.3, 1.6, .5, 1) 1.5s both; }
    @keyframes pl-land { from { opacity: 0; transform: scale(.4) rotate(-30deg); } to { opacity: 1; transform: scale(1) rotate(10deg); } }
    .pl-cnt { position: absolute; bottom: 1.5rem; font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: rgb(31 29 30 / 55%); opacity: 0; animation: pl-fade .6s ease .2s forwards; }
    .pl-cnt { right: var(--site--margin, 2.5rem); bottom: 1.25rem; font-family: var(--_typography---font--secondary-family), Georgia, serif; font-size: 2.75rem; line-height: 1; letter-spacing: -.02em; text-transform: none; font-variant-numeric: tabular-nums; color: #1f1d1e; }
    .pl-cnt b { font-weight: 400; }
    @keyframes pl-fade { to { opacity: 1; } }
    @media (max-width: 767px) { .pl-cnt { font-size: 2rem; } .pl-word { font-size: 5rem; } .pl-slot { right: -2.25rem; top: -.375rem; width: 2.25rem; height: 2.25rem; } }
    /* the homepage intro (hero letters, text, navbar) starts as the curtain lifts */
    html.has-pl .ode-hero-word .gsap_split_letter { animation-delay: calc(2.05s + var(--i) * .05s); }
    html.has-pl [fade-in] { animation-delay: calc(2.9s + var(--i, 0) * .05s); }
    html.has-pl .onav-logo { animation-delay: 2s; }
    html.has-pl .onav-links .ch { animation-delay: calc(2.15s + var(--li, 0) * .07s + var(--d) * .012s); }
    html.has-pl .onav-right > * { animation-delay: 2.4s; }
  </style>
  <style is:inline>
    strong, b {
      font-weight: inherit;
      opacity: 0.5;
    }
    /* Title hearts: same size as the heart on the Concept page title */
    /* Section titles (Concept, Communauté, Figures, La pole dance à Lille…, Choisis ton cours, Questions?): 90px on desktop, scaled down on mobile */
    main .u-heading.w-variant-792802b6-ccdb-f982-5023-5fa970cf03d0, #faq .u-heading { --_text-style---font-size: calc(var(--_typography---font-size--h1) * 1.125); }
    .ode-th { --icon-base: calc(.34 * clamp(4rem, 6.7vw, 7.5rem)); }
    .ode-th .ode-title-heart:not(.ode-icon-question) { right: -.6em; }
    .ode-th .ode-title-heart.ode-icon-book { right: -.7em; }
    .ode-th .ode-title-heart.ode-icon-question { right: -.42em; }
  </style>
  </Fragment>

  <Fragment slot="body-start">
  <!-- preloader (design N1), on every load of the homepage: O-D-E rise, "Lille · 2027" slides in, the chrome icons blend
       into one another on the E and end on the heart while a thin burgundy line runs, then the panel lifts like a curtain.
       Pure CSS, ~2.4 s; the hero's own intro waits for it (html.has-pl). Skipped with reduced motion. -->
  <div class="pl" aria-hidden="true">
    <div class="pl-wrap">
      <span class="pl-word"><span style="--i:0">O</span><span style="--i:1">D</span><span style="--i:2">E</span></span>
      <span class="pl-slot"><img src="/images/ode-icon-sparkle-s.webp" alt="" style="--k:0" /><img src="/images/ode-icon-book-s.webp" alt="" style="--k:1" /><img src="/images/Glanzende-chromen-envelop-met-hartzegel-p-300.webp" alt="" style="--k:2" /><img class="last" src="/images/ode-heart-s.webp" alt="" /></span>
    </div>
    <span class="pl-cnt" aria-hidden="true"><b>00</b>%</span>
  </div>
  <script is:inline>
    // loading counter 00 → 100 (0.2 s → 1.7 s)
    (() => { const el = document.querySelector(".pl-cnt b"); if (!el || !document.documentElement.classList.contains("has-pl")) return; const t0 = performance.now() + 200, d = 1500;
      const ease = (x) => (x < .5 ? 4 * x * x * x : 1 - Math.pow(-2 * x + 2, 3) / 2);
      const tick = (now) => { const x = Math.min(1, Math.max(0, (now - t0) / d)); el.textContent = String(Math.round(ease(x) * 100)).padStart(2, "0"); if (x < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick); })();
  </script>
  <div class="cursor_wrapper">
    <div class="cursor_element meet_teacher has-liquid-glass">
      <div class="cursor_text u-text-style-small">Écris-moi</div>
    </div>
  </div>
  </Fragment>

