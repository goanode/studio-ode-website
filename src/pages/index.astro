  <Fragment slot="scripts">
  <script is:inline>
  // phones: dots under the swipeable price cards (tap to jump, follow the swipe)
  document.addEventListener("DOMContentLoaded", () => {
    const rail = document.querySelector("#formules .u-grid");
    if (!rail) return;
    const cards = [...rail.querySelectorAll(":scope > .card_primary_wrap")];
    const dots = document.createElement("div");
    dots.className = "ode-price-dots";
    cards.forEach((c, i) => {
      const b = document.createElement("button");
      b.type = "button"; b.setAttribute("aria-label", `Formule ${i + 1}`);
      b.addEventListener("click", () => rail.scrollTo({ left: c.offsetLeft - rail.offsetLeft - parseFloat(getComputedStyle(rail).paddingLeft), behavior: "smooth" }));
      dots.append(b);
    });
    (rail.closest(".u-grid-wrapper") || rail).after(dots);
    const mark = () => {
      const x = rail.scrollLeft, w = rail.scrollWidth - rail.clientWidth;
      const i = w <= 0 ? 0 : Math.round((x / w) * (cards.length - 1));
      [...dots.children].forEach((b, k) => b.setAttribute("aria-current", String(k === i)));
    };
    rail.addEventListener("scroll", () => requestAnimationFrame(mark), { passive: true }); mark();
  });
  </script>
  <script is:inline src="/vendor/Flip.min.js"></script>
  <script is:inline>
  // course filters (All / Poledance / Flexibility / Flow / Strength) work like the Figures filters:
  // the chosen pill stays burgundy, the other classes fade and shrink away and the rest glide into place (GSAP Flip), slider back to the start.
  addEventListener("load", () => {
    const btns = [...document.querySelectorAll(".ode-course-filters [data-filter]")];
    const el = document.querySelector("#cours .slider_element");
    if (!btns.length || !el) return;
    const slides = [...el.querySelectorAll(".card_classes_wrap")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = "", tl;
    const apply = (v) => {
      slides.forEach((s) => { s.style.display = !v || s.dataset.category === v ? "" : "none"; });
      const sw = el.swiper; // may not exist yet if the slider hasn't been reached
      if (sw) { sw.update(); sw.slideTo(0, 0); }
    };
    btns.forEach((b) => b.addEventListener("click", () => {
      const v = b.dataset.filter;
      if (v === cur) return;
      cur = v;
      btns.forEach((x) => { x.setAttribute("aria-pressed", String(x === b)); x.closest(".button_main_wrap").classList.toggle("is-on", x === b); });
      if (reduce || !window.Flip || !window.gsap) { apply(v); return; }
      if (tl) tl.progress(1);
      const state = Flip.getState(slides);
      apply(v);
      tl = Flip.from(state, {
        duration: .7, ease: "power3.inOut", absolute: true, stagger: .012, prune: true,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: .92 }, { opacity: 1, scale: 1, duration: .5, ease: "power2.out", delay: .15 }),
        onLeave: (els) => gsap.to(els, { opacity: 0, scale: .92, duration: .35, ease: "power2.in" }),
      });
    }));
    btns[0].closest(".button_main_wrap").classList.add("is-on");
  });
  </script>
