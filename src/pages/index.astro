  var titles = {
    'Yearly': document.querySelectorAll('.card_primary_title.is-yearly'),
    '6-Monthly': document.querySelectorAll('.card_primary_title.is-6monthly'),
    'Monthly': document.querySelectorAll('.card_primary_title.is-monthly')
  };
  options.forEach(function (opt) {
    opt.addEventListener('click', function (e) {
      e.preventDefault();
      options.forEach(function (x) { x.classList.remove('is-active'); x.setAttribute('aria-checked', 'false'); });
      opt.classList.add('is-active');
      opt.setAttribute('aria-checked', 'true');
      opt.parentElement.setAttribute('data-active', Array.prototype.indexOf.call(options, opt));
      var selected = opt.getAttribute('data-key') || opt.textContent.trim();
      Object.keys(titles).forEach(function (key) {
        titles[key].forEach(function (el) {
          el.style.display = (key === selected) ? 'flex' : 'none';
        });
      });
    });
  });
  });
  </script>
