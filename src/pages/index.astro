    .ode-toggle .compare_toggle_option:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .ode-toggle-thumb { position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc((100% - 10px) / 3); border-radius: 9999px; background: #fff; transition: transform .45s cubic-bezier(.3, 1.3, .5, 1); }
    .ode-toggle[data-active="1"] .ode-toggle-thumb { transform: translateX(100%); }
    .ode-toggle[data-active="2"] .ode-toggle-thumb { transform: translateX(200%); }
    @media (max-width: 479px) { .ode-toggle .compare_toggle_option { padding: .6875rem .875rem !important; font-size: .875rem; } }
    @media (prefers-reduced-motion: reduce) { .ode-toggle-thumb { transition: none; } }
  </style>



  <Fragment slot="scripts">
    <script is:inline src="/vendor/split-type.min.js"></script>
  <script is:inline>
gsap.registerPlugin(ScrollTrigger);
const splitTypes = document.querySelectorAll('.reveal-type');
splitTypes.forEach((char,i) => {
  const text = new SplitType(char, {types: ['chars','words']});
  gsap.from(text.chars, {
    scrollTrigger: {
      trigger: char,
      start: 'top 80%',
      end: 'top 20%',
      scrub: true,
      markers: false
    },
    opacity: 0.2,
    stagger: 0.1,
  })
});
</script>
