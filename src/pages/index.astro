    /* Preloader (P1) */
    html:not(.ode-pre) #ode-pre { display: none; }
    html.ode-pre, html.ode-pre body { overflow: hidden; }
    html.ode-hold .ode-hero-word .gsap_split_letter, html.ode-hold [fade-in] { animation-play-state: paused; }
    #ode-pre { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: center; pointer-events: none; background: #f4f2f2; color: #1f1d1e; animation: opre-out 1.65s cubic-bezier(.53, .23, .25, 1) forwards; }
    #ode-pre .roll { position: relative; height: 4.5rem; margin: 0; overflow: hidden; text-align: center; }
    #ode-pre .roll span { display: flex; align-items: center; justify-content: center; height: 4.5rem; animation: opre-roll 1.65s cubic-bezier(.83, 0, .17, 1) forwards; }
    #ode-pre .roll span:first-child { font-family: var(--_typography---font--secondary-family); font-size: 4rem; line-height: 1; letter-spacing: -.03em; }
    #ode-pre .roll span + span { font-size: .8125rem; letter-spacing: .16em; text-transform: uppercase; }
    #ode-pre .line { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: #401f28; transform-origin: left; animation: opre-line 1.65s cubic-bezier(.76, 0, .24, 1) forwards; }
    @keyframes opre-roll { 0%, 18% { transform: none; } 70%, 100% { transform: translateY(-100%); } }
    @keyframes opre-line { 0% { transform: scaleX(0); } 55% { transform: scaleX(.58); } 100% { transform: scaleX(1); } }
    @keyframes opre-out { 0%, 76% { opacity: 1; } 100% { opacity: 0; } }
    @media (max-width: 767px) { #ode-pre .roll, #ode-pre .roll span { height: 3.5rem; } #ode-pre .roll span:first-child { font-size: 3rem; } }
    /* Hero: the big ODE letters rise into place and the text + button fade in, as soon as the page shows (pure CSS, no waiting for scripts) */
    .ode-hero-word .gsap_split_word { position: relative; display: inline-block; }
    .ode-hero-word .gsap_split_letter { position: relative; display: inline-block; animation: ode-rise 1s cubic-bezier(.165, .84, .44, 1) calc(var(--i) * .05s) both; }
    @keyframes ode-rise { from { transform: translateY(100%); } }
    [fade-in] { animation: ode-fade 1s cubic-bezier(.215, .61, .355, 1) calc(1s + var(--i, 0) * .05s) both; }
    @keyframes ode-fade { from { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .ode-hero-word .gsap_split_letter, [fade-in] { animation: none; } }
    /* the chosen course filter stays burgundy, like the Figures filters */
    .ode-course-filters .button_main_wrap.is-on .button_main_element { background-color: #401f28 !important; border-color: #401f28 !important; color: #fff !important; }
    /* the homepage "Concept" word glides into the concept page title */
    .vt-concept { view-transition-name: concept-title; }
    .vt-figures { view-transition-name: figures-title; }
    /* Formules: frosted pill with a white thumb that slides to the chosen option (design T1) */
    .ode-toggle { position: relative; display: grid !important; grid-template-columns: repeat(3, 1fr); gap: 0 !important; padding: 5px !important; border-radius: 9999px; background: rgb(255 255 255 / 14%) !important; border: 1px solid rgb(255 255 255 / 25%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
    .ode-toggle .compare_toggle_option { position: relative; z-index: 1; margin: 0; padding: .75rem 1.625rem !important; border: 0; border-radius: 9999px; background: none !important; font: inherit; font-size: 1rem; color: #fff !important; text-align: center; cursor: pointer; transition: color .35s; }
    .ode-toggle .compare_toggle_option.is-active { color: #fff !important; }
    .ode-toggle .compare_toggle_option:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .ode-toggle-thumb { position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc((100% - 10px) / 3); border-radius: 9999px; background: #401f28; transition: transform .45s cubic-bezier(.3, 1.3, .5, 1); }
    .ode-toggle[data-active="1"] .ode-toggle-thumb { transform: translateX(100%); }
