  <style is:global>
    /* the homepage "Concept" word glides into the concept page title */
    .vt-concept { view-transition-name: concept-title; }
    .vt-figures { view-transition-name: figures-title; }
    /* Silver icons floating up, now and then (POLEDANCE STUDIO section) */
    .ode-float { position: absolute; inset: 0; overflow: hidden; container-type: size; pointer-events: none; }
    .ode-float img { position: absolute; top: 100%; width: var(--w); height: auto; filter: blur(var(--b)) drop-shadow(0 10px 14px rgb(0 0 0 / 35%)); animation: ode-rise 36s linear infinite; will-change: transform; }
    @keyframes ode-rise { 0% { transform: translate(0, 0) rotate(var(--r0)); } 25% { transform: translate(var(--sw), -60cqh) rotate(calc((var(--r0) + var(--r1)) / 2)); } 50%, 100% { transform: translate(0, calc(-100cqh - 9rem)) rotate(var(--r1)); } }
    @media (max-width: 767px) { .ode-float img { width: calc(var(--w) * .6); } }
    @media (prefers-reduced-motion: reduce) { .ode-float { display: none; } }
    /* Formules: frosted pill with a white thumb that slides to the chosen option (design T1) */
    .ode-toggle { position: relative; display: grid !important; grid-template-columns: repeat(3, 1fr); gap: 0 !important; padding: 5px !important; border-radius: 9999px; background: rgb(255 255 255 / 14%) !important; border: 1px solid rgb(255 255 255 / 25%); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
    .ode-toggle .compare_toggle_option { position: relative; z-index: 1; margin: 0; padding: .75rem 1.625rem !important; border: 0; border-radius: 9999px; background: none !important; font: inherit; font-size: 1rem; color: #fff !important; text-align: center; cursor: pointer; transition: color .35s; }
    .ode-toggle .compare_toggle_option.is-active { color: #1f1d1e !important; }
    .ode-toggle .compare_toggle_option:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .ode-toggle-thumb { position: absolute; top: 5px; bottom: 5px; left: 5px; width: calc((100% - 10px) / 3); border-radius: 9999px; background: #fff; transition: transform .45s cubic-bezier(.3, 1.3, .5, 1); }
    .ode-toggle[data-active="1"] .ode-toggle-thumb { transform: translateX(100%); }
    .ode-toggle[data-active="2"] .ode-toggle-thumb { transform: translateX(200%); }
    @media (max-width: 479px) { .ode-toggle .compare_toggle_option { padding: .6875rem .875rem !important; font-size: .875rem; } }
    @media (prefers-reduced-motion: reduce) { .ode-toggle-thumb { transition: none; } }
  </style>



