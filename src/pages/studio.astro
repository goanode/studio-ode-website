---
import BaseLayout from "../layouts/BaseLayout.astro";
import WaitlistModal from "../components/WaitlistModal.astro";
import { MAPBOX_TOKEN } from "../config";
// Le studio (design "Ode Argent", after tci.fm/campuses): a light silver map of Lille in the site's colours.
// 1. intro: a chrome-silver globe turns under "Le studio arrive à Lille";
// 2. it flies down to Lille, tilted in 3D, where a burgundy pin with the chrome heart sits in a dashed burgundy area
//    (the exact address isn't known yet), and "Le studio" + the card (Bientôt, Réserve ta place) come in.
// With a Mapbox token (src/config.ts) the map is Mapbox (light-v11, recoloured); without one, MapLibre + OpenFreeMap
// (positron, recoloured the same way). Change LILLE once the address is known.
const LILLE = [3.09, 50.655];
const HEART = "/images/Glanzend-chromen-hart-op-transparante-achtergrond-p-300.webp";
---

<BaseLayout title="Le studio à Lille — Studio Ode" description="Ode ouvre son studio de pole dance à Lille à l’été 2027. L’adresse sera dévoilée bientôt : réserve ta place parmi les 50 fondatrices pour être prévenue en premier." wfPage="6a96e3c256f4431a13f9f238" footer={false}>
  <main id="main" class="page_main">
    <section class="st" aria-labelledby="st-title">
      <div class="st-map" id="st-map" role="region" aria-label="Carte : le studio Ode ouvrira à Lille"></div>
      <div class="st-haze" aria-hidden="true"></div>

      <!-- the pin is a map marker (moved into the map by the script) -->
      <div class="st-pin" id="st-pin" role="button" tabindex="0" aria-label="Zoomer sur le studio"><div class="st-pin-in" aria-hidden="true">
        <span class="st-lbl">Ode · bientôt à Lille</span>
        <span class="st-drop"><img src={HEART} alt="" /></span>
        <span class="st-pulse"></span>
      </div></div>

      <div class="st-zoom">
        <button type="button" data-zoom="1" aria-label="Zoomer">+</button>
        <span aria-hidden="true"></span>
        <button type="button" data-zoom="-1" aria-label="Dézoomer">−</button>
      </div>

      <!-- 1 · intro over the globe -->
      <div class="st-intro" aria-hidden="true">
        <p class="st-intro-h"><span class="ode-th">Le studio arrive à Lille<img class="ode-title-heart ode-icon-pin" src="/images/ode-icon-pin-s.webp" alt="" /></span></p>
        <p class="st-intro-p">Ouverture à l’été 2027. On t’y emmène.</p>
      </div>

      <!-- 2 · over Lille -->
      <div class="st-ui">
        <div class="st-left">
          <h1 id="st-title" class="st-h"><span class="ode-th">Le studio<img class="ode-title-heart ode-icon-pin" src="/images/ode-icon-pin-s.webp" alt="" aria-hidden="true" /></span></h1>
          <article class="st-card">
            <div class="st-body">
              <p class="st-tag"><span class="st-dot" aria-hidden="true"></span>Bientôt</p>
              <h2 class="st-name">Ode · Lille</h2>
              <p class="st-addr">L’adresse exacte sera dévoilée bientôt. Ouverture à l’été 2027.</p>
              <button type="button" class="st-btn" data-modal-trigger="waitlist">Réserve ta place<img src="/images/ode-heart-s.webp" alt="" aria-hidden="true" /></button>
              <p class="st-fine">Les 50 fondatrices sont prévenues en premier quand l’adresse tombe.</p>
            </div>
            <div class="st-img"><img src="/images/pole-flow-p-500.webp" alt="Danseuse à la barre au studio Ode" loading="lazy" width="500" height="605" /></div>
          </article>
        </div>
        <p class="st-coord">Lille · 50°39′ N · 3°05′ E</p>
      </div>
    </section>
  </main>
  <WaitlistModal slot="after-footer" />
</BaseLayout>

<script is:inline define:vars={{ MAPBOX_TOKEN, LILLE }}>
  (() => {
    const section = document.querySelector(".st"), el = document.getElementById("st-map");
    const useMapbox = !!MAPBOX_TOKEN;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const small = () => matchMedia("(max-width: 767px)").matches;
    const LIB = useMapbox
      ? { js: "https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.js", css: "https://api.mapbox.com/mapbox-gl-js/v3.9.4/mapbox-gl.css" }
      : { js: "https://unpkg.com/maplibre-gl@5.6.0/dist/maplibre-gl.js", css: "https://unpkg.com/maplibre-gl@5.6.0/dist/maplibre-gl.css" };
    const css = document.createElement("link"); css.rel = "stylesheet"; css.href = LIB.css; document.head.appendChild(css);
    const s = document.createElement("script"); s.src = LIB.js; s.onload = start;
    s.onerror = () => section.classList.add("is-arrived", "no-map");
    document.head.appendChild(s);

    // "Ode Argent": brushed silver like the studio walls, white streets, the only colour is the burgundy studio area
    const C = { land: "#efeded", block: "#e4e1e2", edge: "#d6d1d3", street: "#ffffff", casing: "#d1ccce", water: "#d7d5d9", park: "#e9e7e5", rail: "#c4bfc1", label: "#8a8486", halo: "#f3f1f1", wine: "#401f28", roof: "#ebe8e9" };

    // the studio view: Lille from above, tilted; the pin sits above the card
    const view = () => {
      const h = el.clientHeight;
      return { center: LILLE, zoom: small() ? 11.7 : 12.4, pitch: 55, bearing: -15, padding: { top: 0, left: 0, right: 0, bottom: Math.round(h * (small() ? 0.36 : 0.1)) } };
    };

    // a soft circle around the centre: the address isn't final yet
    const circle = ([lng, lat], km, n = 96) => ({
      type: "Feature", properties: {},
      geometry: { type: "Polygon", coordinates: [Array.from({ length: n + 1 }, (_, i) => {
        const a = (i / n) * Math.PI * 2;
        return [lng + (km / (111.32 * Math.cos((lat * Math.PI) / 180))) * Math.cos(a), lat + (km / 110.574) * Math.sin(a)];
      })] },
    });

    function start() {
      const gl = useMapbox ? window.mapboxgl : window.maplibregl;
      if (!gl) return section.classList.add("is-arrived", "no-map");
      if (useMapbox) gl.accessToken = MAPBOX_TOKEN;
      const map = new gl.Map({
        container: el,
        style: useMapbox ? "mapbox://styles/mapbox/light-v11" : "https://tiles.openfreemap.org/styles/positron",
        center: [8, 42], zoom: small() ? 0.6 : 1.4, pitch: 0, bearing: 0,
        projection: useMapbox ? "globe" : undefined,
        attributionControl: { compact: true },
        cooperativeGestures: small(),
        maxPitch: 70,
      });

      map.on("style.load", () => {
        if (useMapbox) map.setFog({ color: "#ffffff", "high-color": "#eceaeb", "horizon-blend": 0.1, "space-color": "#f2f1f1", "star-intensity": 0 });
        else {
          map.setProjection({ type: "globe" });
          map.setSky({ "sky-color": "#ffffff", "horizon-color": "#eceaeb", "fog-color": "#ffffff", "sky-horizon-blend": 0.5, "horizon-fog-blend": 0.6, "fog-ground-blend": 0.35, "atmosphere-blend": ["interpolate", ["linear"], ["zoom"], 0, 0.7, 5, 0.3, 8, 0] });
        }
        recolour();
        buildings();
        area();
      });

      const set = (fn, id, k, v) => { try { map[fn](id, k, v); } catch (e) {} };
      const recolour = () => {
        for (const l of map.getStyle().layers) {
          const id = l.id.toLowerCase(), t = l.type;
          if (t === "background") set("setPaintProperty", l.id, "background-color", C.land);
          else if (t === "fill") {
            if (/water|ocean|lake|river/.test(id)) set("setPaintProperty", l.id, "fill-color", C.water);
            else if (/building/.test(id)) { set("setPaintProperty", l.id, "fill-color", C.block); set("setPaintProperty", l.id, "fill-outline-color", C.edge); }
            else if (/park|grass|wood|forest|landcover|pitch|cemetery|garden|national|golf|scrub/.test(id)) set("setPaintProperty", l.id, "fill-color", C.park);
            else set("setPaintProperty", l.id, "fill-color", C.land);
            set("setPaintProperty", l.id, "fill-pattern", undefined);
          } else if (t === "line") {
            if (/water|river|canal|stream/.test(id)) set("setPaintProperty", l.id, "line-color", C.water);
            else if (/rail/.test(id)) set("setPaintProperty", l.id, "line-color", C.rail);
            else if (/case|casing|outline/.test(id)) set("setPaintProperty", l.id, "line-color", C.casing);
            else if (/admin|boundary/.test(id)) set("setPaintProperty", l.id, "line-color", C.casing);
            else if (/road|street|highway|bridge|tunnel|motorway|trunk|primary|secondary|tertiary|minor|service|path|link|transportation|ferry|aeroway/.test(id)) set("setPaintProperty", l.id, "line-color", C.street);
          } else if (t === "symbol") {
            if (/poi|transit|station|airport|aerodrome|shield|ref|number|housenum|oneway|ferry|rail/.test(id)) set("setLayoutProperty", l.id, "visibility", "none");
            else { set("setPaintProperty", l.id, "text-color", C.label); set("setPaintProperty", l.id, "text-halo-color", C.halo); set("setPaintProperty", l.id, "text-halo-width", 1.5); set("setPaintProperty", l.id, "icon-opacity", 0); }
          } else if (t === "fill-extrusion") map.removeLayer(l.id);
        }
      };

      // 3D buildings: silver roofs, walls a touch darker
      const buildings = () => {
        const src = useMapbox ? "composite" : "openmaptiles";
        if (!map.getSource(src)) return;
        const hk = useMapbox ? "height" : "render_height", bk = useMapbox ? "min_height" : "render_min_height";
        const labels = map.getStyle().layers.find((l) => l.type === "symbol" && l.layout && l.layout["text-field"] && (l.layout.visibility || "visible") === "visible");
        map.addLayer({
          id: "ode-3d", type: "fill-extrusion", source: src, "source-layer": "building", minzoom: 12.5,
          ...(useMapbox ? { filter: ["==", "extrude", "true"] } : {}),
          paint: {
            "fill-extrusion-color": C.roof,
            "fill-extrusion-height": ["interpolate", ["linear"], ["zoom"], 12.5, 0, 13.6, ["coalesce", ["get", hk], 10]],
            "fill-extrusion-base": ["coalesce", ["get", bk], 0],
            "fill-extrusion-opacity": 0.95,
            "fill-extrusion-vertical-gradient": true,
          },
        }, labels && labels.id);
      };

      const area = () => {
        map.addSource("ode-area", { type: "geojson", data: circle(LILLE, 5) });
        map.addSource("ode-core", { type: "geojson", data: circle(LILLE, 2.5) });
        map.addLayer({ id: "ode-area-fill", type: "fill", source: "ode-area", paint: { "fill-color": C.wine, "fill-opacity": 0.07 } });
        map.addLayer({ id: "ode-core-fill", type: "fill", source: "ode-core", paint: { "fill-color": C.wine, "fill-opacity": 0.05 } });
        map.addLayer({ id: "ode-area-line", type: "line", source: "ode-area", paint: { "line-color": C.wine, "line-opacity": 0.6, "line-width": 2, "line-dasharray": [2.5, 2.2] } });
      };

      // the pin: on the globe from the start, and it stays at every zoom
      const pin = document.getElementById("st-pin");
      new gl.Marker({ element: pin, anchor: "bottom" }).setLngLat(LILLE).addTo(map);
      const showPin = () => pin.classList.add("on");
      map.once("load", showPin);

      // the globe turns slowly, then flies down to Lille; the intro words make way for the title and card
      let spinning = !reduce, flown = false;
      const spin = () => {
        if (!spinning) return;
        const c = map.getCenter(); c.lng -= 2.4;
        map.easeTo({ center: c, duration: 1000, easing: (t) => t });
      };
      map.on("moveend", () => spinning && spin());
      const fly = (dur) => {
        spinning = false; flown = true;
        if (!dur) { map.jumpTo(view()); section.classList.add("is-arrived"); return showPin(); }
        map.flyTo({ ...view(), duration: dur, curve: 1.5, essential: true });
        setTimeout(() => section.classList.add("is-arrived"), dur * 0.55);
      };
      // if the map can't load (offline, blocked tiles), still show the title and card
      const safety = setTimeout(() => section.classList.add("is-arrived"), 12000);
      map.on("load", () => {
        clearTimeout(safety);
        if (reduce) return fly(0);
        spin();
        setTimeout(() => !flown && fly(7000), 2200);
      });
      ["mousedown", "touchstart", "wheel"].forEach((ev) => el.addEventListener(ev, () => { if (!flown) fly(4000); else spinning = false; }, { passive: true }));
      document.querySelectorAll("[data-zoom]").forEach((b) => b.addEventListener("click", () => map.easeTo({ zoom: map.getZoom() + +b.dataset.zoom, duration: 400 })));
      // click the pin: fly back to the studio view; already there, zoom in closer on the pin
      const toPin = (e) => {
        e.stopPropagation();
        const v = view(), near = Math.abs(map.getZoom() - v.zoom) < 0.4 && map.project(LILLE).dist(map.project(map.getCenter())) < el.clientHeight * 0.3;
        spinning = false; flown = true; section.classList.add("is-arrived");
        if (near) map.flyTo({ center: LILLE, zoom: Math.min(map.getZoom() + 2, 16.5), pitch: 60, bearing: v.bearing, padding: v.padding, duration: reduce ? 0 : 1800, essential: true });
        else map.flyTo({ ...v, duration: reduce ? 0 : 2400, curve: 1.4, essential: true });
      };
      pin.addEventListener("click", toPin);
      pin.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toPin(e); } });
    }
  })();
</script>

<style is:global>
  /* one screen, light: brushed-silver map, white haze, wine pin */
  .st { position: relative; height: 100vh; height: 100dvh; min-height: 40rem; overflow: hidden; isolation: isolate; color: #3b3b3b;
    background: radial-gradient(ellipse 70% 60% at 50% 44%, #ffffff 0%, #f3f2f2 55%, #e7e5e6 100%); }
  .st-map, .st-map.maplibregl-map, .st-map.mapboxgl-map { position: absolute; inset: 0; width: 100%; height: 100%; }
  .st-map canvas { outline: none; }
  .st-haze { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to bottom, #fff 0%, rgb(255 255 255 / .85) 9%, rgb(255 255 255 / 0) 28%, rgb(255 255 255 / 0) 52%, rgb(255 255 255 / .78) 78%, #fff 100%);
    opacity: 0; transition: opacity 1.4s ease; }
  .st.is-arrived .st-haze { opacity: 1; }

  /* pin */
  /* the map library sets the marker's own opacity, so the show/hide is on the inner box */
  .st-pin { width: 4rem; height: 7rem; pointer-events: none; }
  /* only the drop and its label take clicks (not the empty box around them) */
  .st-pin.on .st-drop, .st-pin.on .st-lbl { pointer-events: auto; cursor: pointer; }
  .st-pin:focus-visible { outline: none; }
  .st-pin:focus-visible .st-drop { box-shadow: 0 0 0 3px #fff, 0 0 0 5px #401f28; }
  .st-pin.on .st-drop { transition: transform .35s cubic-bezier(.34, 1.56, .64, 1); }
  .st-pin.on .st-drop:hover { transform: rotate(-45deg) scale(1.08); }
  .st-pin-in { position: relative; width: 100%; height: 100%; opacity: 0; transform: translateY(-1rem) scale(.8); transform-origin: 50% 100%; transition: opacity .6s ease, transform .8s cubic-bezier(.34, 1.56, .64, 1); }
  .st-pin.on .st-pin-in { opacity: 1; transform: none; }
  .st-drop { position: absolute; left: 0; bottom: .9rem; width: 4rem; height: 4rem; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: #401f28;
    display: grid; place-items: center; box-shadow: 0 18px 36px -10px rgb(64 31 40 / .55), inset 0 2px 0 rgb(255 255 255 / .18); }
  .st-drop img { width: 2.5rem; height: auto; transform: rotate(45deg); }
  .st-pulse { position: absolute; left: 50%; bottom: -.55rem; width: 2.75rem; height: 1.1rem; margin-left: -1.375rem; border-radius: 50%; background: rgb(64 31 40 / .28); animation: st-pulse 2.4s ease-out infinite; }
  @keyframes st-pulse { from { transform: scale(.55); opacity: .9; } to { transform: scale(3.4); opacity: 0; } }
  .st-lbl { position: absolute; left: 50%; bottom: 6.3rem; transform: translateX(-50%); white-space: nowrap; padding: .5rem .875rem; border-radius: 99rem;
    background: rgb(255 255 255 / .72); border: 1px solid rgb(31 29 30 / .12); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
    font: 500 .8125rem/1 var(--_typography---font--primary-family); color: #1f1d1e; box-shadow: 0 8px 24px -12px rgb(31 29 30 / .35); }

  /* glass zoom */
  .st-zoom { position: absolute; z-index: 3; right: 2rem; top: 6rem; display: flex; flex-direction: column; border-radius: 99rem; overflow: hidden;
    background: rgb(255 255 255 / .6); border: 1.5px solid rgb(31 29 30 / .14); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    opacity: 0; transition: opacity .8s ease .4s; }
  .st.is-arrived .st-zoom { opacity: 1; }
  .st-zoom button { width: 2.75rem; height: 2.75rem; border: 0; background: none; color: #1f1d1e; font: 400 1.25rem/1 var(--_typography---font--primary-family); cursor: pointer; transition: background .2s; }
  .st-zoom button:hover { background: rgb(255 255 255 / .8); }
  .st-zoom span { height: 1px; margin: 0 .625rem; background: rgb(31 29 30 / .14); }

  /* intro words under the globe */
  .st-intro { position: absolute; z-index: 2; left: 0; right: 0; bottom: 4rem; display: flex; flex-direction: column; align-items: center; gap: .875rem; text-align: center; padding: 0 1rem;
    pointer-events: none; transition: opacity .7s ease, transform .9s ease; }
  .st.is-arrived .st-intro { opacity: 0; transform: translateY(1rem); }
  .st-intro-h { margin: 0; font-family: var(--_typography---font--secondary-family); font-weight: 500; font-size: clamp(2.75rem, 6.4vw, 5.75rem); line-height: .95; letter-spacing: -.03em; color: #1f1d1e; text-wrap: balance; }
  .st-intro-p { margin: 0; font-size: 1rem; color: #5c5759; }

  /* title + card */
  .st-ui { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; padding: 0 6.5% 2.75rem; display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; pointer-events: none; }
  .st-ui > * { pointer-events: auto; }
  .st-left { display: flex; flex-direction: column; gap: 1.375rem; min-width: 0; }
  .st-h, .st-card, .st-coord { opacity: 0; transform: translateY(1.5rem); transition: opacity .9s ease, transform 1.1s cubic-bezier(.165, .84, .44, 1); }
  .st.is-arrived .st-h { opacity: 1; transform: none; transition-delay: .2s; }
  .st.is-arrived .st-card { opacity: 1; transform: none; transition-delay: .45s; }
  .st.is-arrived .st-coord { opacity: 1; transform: none; transition-delay: .7s; }
  .st-h { margin: 0; align-self: flex-start; font-family: var(--_typography---font--secondary-family); font-weight: 500; font-size: clamp(3.75rem, 8.6vw, 7.75rem); line-height: .92; letter-spacing: -.03em; color: #1f1d1e; }

  .st-card { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: 1rem; width: 37.5rem; max-width: 100%; padding: .875rem; border-radius: 1rem;
    background: #fff; border: 1px solid rgb(31 29 30 / .08); box-shadow: 0 34px 70px -34px rgb(31 29 30 / .4); }
  .st-body { display: flex; flex-direction: column; padding: .625rem .375rem .375rem .625rem; min-width: 0; }
  .st-tag { display: inline-flex; align-items: center; gap: .5rem; align-self: flex-start; margin: 0 0 .875rem; padding: .375rem .75rem; border-radius: 99rem;
    background: #f4eef0; color: #401f28; font: 600 .75rem/1 var(--_typography---font--primary-family); }
  .st-dot { width: .45rem; height: .45rem; border-radius: 50%; background: #401f28; animation: st-blink 1.6s ease-in-out infinite; }
  @keyframes st-blink { 50% { opacity: .3; } }
  .st-name { margin: 0; font-family: var(--_typography---font--secondary-family); font-weight: 500; font-size: clamp(2.25rem, 3.2vw, 2.875rem); line-height: 1; letter-spacing: -.02em; color: #1f1d1e; }
  .st-addr { margin: .625rem 0 1.5rem; font-size: .9375rem; line-height: 1.5; color: #625d5f; }
  .st-btn { margin-top: auto; display: flex; align-items: center; justify-content: center; gap: .625rem; height: 3rem; border: 0; border-radius: 99rem; background: #401f28; color: #fff; cursor: pointer;
    font: 500 .9375rem/1 var(--_typography---font--primary-family); transition: background .25s, transform .2s; }
  .st-btn img { width: 1.375rem; height: auto; transition: transform .4s cubic-bezier(.34, 1.56, .64, 1); }
  .st-btn:hover { background: #2b141b; }
  .st-btn:hover img { transform: scale(1.2) rotate(-10deg); }
  .st-btn:active { transform: scale(.98); }
  .st-fine { margin: .75rem 0 0; font-size: .75rem; line-height: 1.45; color: #6b6567; }
  .st-img { border-radius: .625rem; overflow: hidden; background: #ebe8e9; min-height: 15.5rem; }
  .st-img img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 58% 32%; }

  .st-coord { margin: 0 0 .375rem; padding: .625rem 1rem; border-radius: 99rem; white-space: nowrap; background: rgb(255 255 255 / .6); border: 1.5px solid rgb(31 29 30 / .12);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); font-size: .75rem; letter-spacing: .04em; color: #4a4547; }

  /* map attribution: small and quiet, above the haze */
  .st .maplibregl-ctrl-bottom-right, .st .mapboxgl-ctrl-bottom-right { z-index: 3; }
  .st .maplibregl-ctrl-attrib, .st .mapboxgl-ctrl-attrib { background: rgb(255 255 255 / .7) !important; font-size: 10px; }

  @media (max-width: 767px) {
    .st-zoom, .st-coord, .st-img { display: none; }
    .st-intro { bottom: 2.5rem; }
    .st-ui { padding: 0 .875rem 1rem; }
    .st-left { width: 100%; gap: .875rem; }
    .st-h { font-size: 3.75rem; margin-left: .25rem; }
    .st-card { grid-template-columns: 1fr; width: 100%; padding: 1.25rem 1.125rem 1.125rem; }
    .st-body { padding: 0; }
    .st-btn { height: 3.125rem; }
    .st-fine { text-align: center; }
    .st-haze { background: linear-gradient(to bottom, #fff 0%, rgb(255 255 255 / .8) 8%, rgb(255 255 255 / 0) 22%, rgb(255 255 255 / 0) 40%, rgb(255 255 255 / .85) 56%, #fff 64%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-pulse, .st-dot { animation: none; }
    .st-h, .st-card, .st-coord, .st-intro, .st-pin-in, .st-zoom, .st-haze { transition: none; }
  }
</style>
