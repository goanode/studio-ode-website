---
import VariantLayout from "../../layouts/VariantLayout.astro";
import Pic from "../../components/variants/Pic.astro";
import { WAITLIST_URL, studio, pillars, classes, journey, founder, plans, nav } from "../../data/ode";
---

<VariantLayout title="Ode — Variante éditoriale" flutedGlass bodyClass="ed">
  <header class="ed-header">
    <a href="/variantes/editorial" class="ed-logo" aria-label="Ode, accueil">
      <img src="/images/odestudiotestsmall2x-p-500.webp" alt="" width="250" height="67" />
    </a>
    <p class="ed-header-meta">(studio de pole dance, {studio.city})</p>
    <nav class="ed-header-nav" aria-label="Principale">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="ed-pill" href={WAITLIST_URL}>Liste d'attente</a>
    </nav>
  </header>

  <main>
    <!-- Hero: one long sentence, with the studio's photography set into the type -->
    <section class="ed-hero">
      <h1 class="ed-statement">
        Ode est un studio
        <span class="ed-inline" aria-hidden="true"><Pic name="Hello-please-take-the-style-of-t-329741-ZHu" sizes="12vw" eager /></span>
        de pole dance où l'on apprend la force, la grâce
        <span class="ed-inline ed-inline--wide" aria-hidden="true"><Pic name="ea27f15c4ddd5e50ea8bd0309f3aae76" ext="avif" sizes="16vw" eager /></span>
        et l'art d'occuper l'espace.
      </h1>
      <div class="ed-hero-foot">
        <p class="ed-small">(ouverture à {studio.city} en {studio.opening})</p>
        <div class="ed-hero-intro">
          <p>{studio.intro}</p>
          <a class="ed-button" href={WAITLIST_URL}>Rejoindre la liste d'attente</a>
        </div>
      </div>
    </section>

    <div class="ed-wide glass" tlg-fluted-glass-canvas tlg-fluted-glass-mode="scroll" tlg-fluted-glass-segments="48">
      <Pic name="please-look-at-the-first-pose----820406-SN7" sizes="100vw" tlg-fluted-glass-image="" />
    </div>

    <!-- Studio -->
    <section class="ed-section ed-studio" aria-labelledby="studio-title">
      <div class="ed-studio-side">
        <p class="ed-small">(le studio)</p>
        <Pic name="please-keep-the-background--the-233555-iP0" sizes="(max-width: 800px) 60vw, 25vw" class="ed-studio-img" />
      </div>
      <div class="ed-studio-main">
        <h2 id="studio-title" class="ed-lead">{studio.manifesto}</h2>
        <div class="ed-pillars">
          {
            pillars.map((p) => (
              <div class="ed-pillar">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            ))
          }
        </div>
        <a class="ed-link" href="/concept">Découvrir notre concept</a>
      </div>
    </section>

    <!-- Classes: a list, with the photo following the pointer on hover -->
    <section class="ed-section ed-classes" id="cours" aria-labelledby="cours-title">
      <div class="ed-section-head">
        <h2 id="cours-title" class="ed-h2">Les cours</h2>
        <p class="ed-small">({String(classes.length).padStart(2, "0")})</p>
      </div>
      <ul class="ed-class-list">
        {
          classes.map((c) => (
            <li class="ed-class">
              <span class="ed-class-name">{c.name}</span>
              <span class="ed-class-meta">{c.level}</span>
              <span class="ed-class-meta">{c.length}</span>
              <span class="ed-class-meta">avec {founder.name}</span>
              <Pic name={c.image} ext={c.ext} sizes="(max-width: 800px) 30vw, 22vw" class="ed-class-img" />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Journey: a real sequence, so it is numbered -->
    <section class="ed-journey" aria-labelledby="journey-title">
      <div class="ed-journey-inner">
        <p class="ed-small">(avant l'ouverture)</p>
        <h2 id="journey-title" class="ed-h2">Trois étapes jusqu'à ton premier cours</h2>
        <ol class="ed-steps">
          {
            journey.map((s, i) => (
              <li>
                <span class="ed-step-num">({String(i + 1).padStart(2, "0")})</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
        <a class="ed-button ed-button--light" href={WAITLIST_URL}>Rejoindre la liste d'attente</a>
      </div>
    </section>

    <!-- Founder -->
    <section class="ed-section ed-founder" aria-label="La fondatrice">
      <Pic name={founder.image} ext={founder.ext} sizes="(max-width: 800px) 90vw, 35vw" class="ed-founder-img" />
      <figure>
        <blockquote class="ed-quote">« {founder.quote} »</blockquote>
        <figcaption><span>{founder.name}</span> {founder.role}</figcaption>
      </figure>
    </section>

    <!-- Plans -->
    <section class="ed-section ed-plans" id="formules" aria-labelledby="formules-title">
      <div class="ed-section-head">
        <h2 id="formules-title" class="ed-h2">Les formules</h2>
        <p class="ed-small">(tarifs mensuels, sans engagement)</p>
      </div>
      <div class="ed-plan-grid">
        {
          plans.map((p) => (
            <article class:list={["ed-plan", { "ed-plan--featured": p.featured }]}>
              <h3>{p.name}</h3>
              <p class="ed-price">
                {p.price}&nbsp;€<span>par mois</span>
              </p>
              <ul>
                {p.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Closing -->
    <section class="ed-closing" aria-labelledby="closing-title">
      <img src="/images/Glanzend-chromen-hart-op-transparante-achtergrond-p-800.webp" alt="" class="ed-heart" width="800" height="521" loading="lazy" />
      <h2 id="closing-title" class="ed-closing-title">Prête à évoluer&nbsp;?</h2>
      <p>Les places des premiers mois seront limitées. Les inscrites de la liste choisissent leur créneau en premier.</p>
      <a class="ed-button" href={WAITLIST_URL}>Rejoindre la liste d'attente</a>
    </section>
  </main>

  <footer class="ed-footer">
    <div class="ed-footer-cols">
      <div>
        <p class="ed-small">(navigation)</p>
        <a href="/variantes/editorial">Accueil</a>
        <a href="/concept">Concept</a>
        <a href="#cours">Cours</a>
        <a href="#formules">Formules</a>
      </div>
      <div>
        <p class="ed-small">(contact)</p>
        <a href="mailto:bonjour@ode-studio.fr">bonjour@ode-studio.fr</a>
        <a href="https://instagram.com/">Instagram</a>
      </div>
      <div>
        <p class="ed-small">(statut)</p>
        <p class="ed-status"><span aria-hidden="true"></span>Ouverture prévue en {studio.opening}</p>
      </div>
    </div>
    <img src="/images/odestudiotestsmall2x-p-2000.webp" alt="Studio Ode" class="ed-footer-logo" width="2000" height="535" loading="lazy" />
    <p class="ed-small ed-copy">© {new Date().getFullYear()} Ode, {studio.city}</p>
  </footer>

  <script is:inline slot="scripts">
    // Classes list: the photo follows the pointer while hovering a row (desktop only)
    (function () {
      if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
      document.querySelectorAll(".ed-class").forEach(function (row) {
        var img = row.querySelector(".ed-class-img");
        var x = gsap.quickTo(img, "x", { duration: 0.5, ease: "power3" });
        var y = gsap.quickTo(img, "y", { duration: 0.5, ease: "power3" });
        row.addEventListener("pointermove", function (e) {
          var r = row.getBoundingClientRect();
          x(e.clientX - r.left);
          y(e.clientY - r.top);
        });
      });
    })();
  </script>
</VariantLayout>

<style>
  :global(body.ed) {
    --bg: #dcddd9;
    --ink: #1f1517;
    --wine: #6b1622;
    --wine-deep: #3d0c13;
    --muted: #5d5557;
    --rule: rgba(31, 21, 23, 0.22);
    --pad: clamp(1.25rem, 3.2vw, 3rem);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  /* Header */
  .ed-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--pad);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  .ed-logo img {
    width: 7.5rem;
    filter: contrast(1.3) brightness(0.55);
  }
  .ed-header-meta {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .ed-header-nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.9375rem;
  }
  .ed-header-nav a {
    text-decoration: none;
  }
  .ed-pill {
    padding: 0.45rem 1rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }
  .ed-pill:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .ed-small {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Hero */
  .ed-hero {
    padding: clamp(3rem, 9vw, 8rem) var(--pad) clamp(2rem, 4vw, 3.5rem);
  }
  .ed-statement {
    margin: 0;
    max-width: 20ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 7.6vw, 9.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .ed-inline {
    display: inline-block;
    width: 1.5em;
    height: 0.78em;
    margin: 0 0.06em;
    vertical-align: -0.04em;
    border-radius: 999px;
    overflow: hidden;
  }
  .ed-inline--wide {
    width: 2.1em;
  }
  .ed-inline :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ed-hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(2.5rem, 6vw, 5rem);
  }
  .ed-hero-intro {
    max-width: 30rem;
  }
  .ed-hero-intro p {
    margin: 0 0 1.5rem;
  }

  .ed-button {
    display: inline-block;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    background: var(--wine);
    color: #f4ecec;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: background 0.2s;
  }
  .ed-button:hover {
    background: var(--wine-deep);
  }
  .ed-button--light {
    background: #f1e9ea;
    color: var(--wine-deep);
  }
  .ed-button--light:hover {
    background: #fff;
  }

  .ed-wide {
    height: min(78vh, 56vw);
    margin: 0 var(--pad);
    border-radius: 4px;
  }

  /* Generic section */
  .ed-section {
    padding: clamp(4.5rem, 10vw, 9rem) var(--pad);
  }
  .ed-section-head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .ed-h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.4rem, 5vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  /* Studio */
  .ed-studio {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .ed-studio-side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .ed-studio-img {
    width: 78%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 4px;
  }
  .ed-lead {
    margin: 0 0 clamp(3rem, 6vw, 5rem);
    max-width: 24ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.9rem, 3.4vw, 3.4rem);
    line-height: 1.12;
  }
  .ed-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem clamp(2rem, 4vw, 4rem);
    margin-bottom: 3rem;
  }
  .ed-pillar {
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .ed-pillar h3 {
    margin: 0 0 0.6rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .ed-pillar p {
    margin: 0;
    max-width: 38ch;
    color: var(--muted);
  }
  .ed-link {
    font-size: 0.9375rem;
    text-underline-offset: 0.3em;
  }

  /* Classes */
  .ed-class-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .ed-class {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 10rem 5rem 10rem;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--rule);
    cursor: default;
  }
  .ed-class-name {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 3.4vw, 3.1rem);
    font-weight: 300;
    line-height: 1;
    transition: color 0.25s, transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .ed-class-meta {
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .ed-class-img {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: clamp(10rem, 16vw, 15rem);
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 4px;
    pointer-events: none;
    opacity: 0;
    translate: -50% -50%;
    scale: 0.85;
    transition: opacity 0.25s, scale 0.35s;
  }
  @media (hover: hover) and (pointer: fine) {
    .ed-class:hover .ed-class-name {
      color: var(--wine);
      transform: translateX(0.75rem);
    }
    .ed-class:hover .ed-class-img {
      opacity: 1;
      scale: 1;
    }
  }

  /* Journey */
  .ed-journey {
    margin: 0 var(--pad);
    border-radius: 4px;
    background: var(--wine);
    color: #f1e9ea;
  }
  .ed-journey-inner {
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
  }
  .ed-journey .ed-small {
    color: rgba(241, 233, 234, 0.7);
    margin-bottom: 1rem;
  }
  .ed-journey .ed-h2 {
    max-width: 16ch;
  }
  .ed-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    margin: clamp(3rem, 6vw, 5rem) 0;
    padding: 0;
    list-style: none;
  }
  .ed-steps li {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(241, 233, 234, 0.3);
  }
  .ed-step-num {
    font-size: 0.875rem;
    color: rgba(241, 233, 234, 0.7);
  }
  .ed-steps h3 {
    margin: 1.25rem 0 0.6rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
  }
  .ed-steps p {
    margin: 0;
    max-width: 34ch;
    color: rgba(241, 233, 234, 0.82);
  }

  /* Founder */
  .ed-founder {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .ed-founder-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    border-radius: 4px;
  }
  .ed-founder figure {
    margin: 0;
  }
  .ed-quote {
    margin: 0 0 2rem;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.7rem, 3vw, 3rem);
    line-height: 1.15;
    max-width: 26ch;
  }
  .ed-founder figcaption {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .ed-founder figcaption span {
    color: var(--ink);
    margin-right: 0.5rem;
  }

  /* Plans */
  .ed-plan-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .ed-plan {
    padding: 2rem clamp(1.25rem, 2.5vw, 2.25rem) 2.5rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
  }
  .ed-plan--featured {
    background: var(--ink);
    color: #ece7e7;
    border-color: var(--ink);
  }
  .ed-plan h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .ed-price {
    margin: 2.5rem 0 2rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
  }
  .ed-price span {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    color: var(--muted);
  }
  .ed-plan--featured .ed-price span {
    color: rgba(236, 231, 231, 0.65);
  }
  .ed-plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .ed-plan li {
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }
  .ed-plan--featured li {
    border-color: rgba(236, 231, 231, 0.2);
  }

  /* Closing */
  .ed-closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(4rem, 9vw, 8rem) var(--pad) clamp(5rem, 10vw, 9rem);
  }
  .ed-heart {
    width: clamp(9rem, 18vw, 16rem);
    margin-bottom: 1rem;
  }
  .ed-closing-title {
    margin: 0 0 1.5rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3rem, 9vw, 9rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .ed-closing p {
    max-width: 34rem;
    margin: 0 0 2rem;
    color: var(--muted);
  }

  /* Footer */
  .ed-footer {
    padding: 4rem var(--pad) 2rem;
    border-top: 1px solid var(--rule);
  }
  .ed-footer-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .ed-footer-cols > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .ed-footer-cols .ed-small {
    margin-bottom: 0.6rem;
  }
  .ed-footer-cols a {
    text-decoration: none;
    width: fit-content;
  }
  .ed-footer-cols a:hover {
    text-decoration: underline;
  }
  .ed-status {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .ed-status span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--wine);
    box-shadow: 0 0 0 4px rgba(107, 22, 34, 0.15);
  }
  .ed-footer-logo {
    width: 100%;
    margin: clamp(3rem, 8vw, 6rem) 0 1.5rem;
    filter: contrast(1.25) brightness(0.6);
  }
  .ed-copy {
    text-align: right;
  }

  /* Tablet & mobile */
  @media (max-width: 900px) {
    .ed-header {
      grid-template-columns: 1fr auto;
    }
    .ed-header-meta {
      display: none;
    }
    .ed-header-nav a:not(.ed-pill) {
      display: none;
    }
    .ed-hero-foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .ed-studio,
    .ed-founder {
      grid-template-columns: 1fr;
    }
    .ed-studio-img {
      width: 55%;
    }
    .ed-pillars,
    .ed-steps,
    .ed-plan-grid,
    .ed-footer-cols {
      grid-template-columns: 1fr;
    }
    .ed-class {
      grid-template-columns: 5.5rem 1fr;
      gap: 0.4rem 1.25rem;
      align-items: center;
    }
    .ed-class-img {
      position: static;
      grid-row: 1 / span 4;
      width: 5.5rem;
      opacity: 1;
      translate: none;
      scale: 1;
    }
    .ed-class-meta {
      font-size: 0.875rem;
    }
  }
</style>
