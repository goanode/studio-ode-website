---
import VariantLayout from "../../layouts/VariantLayout.astro";

const variants = [
  {
    href: "/",
    name: "Actuelle",
    text: "Le site Webflow d'origine, reconstruit à l'identique en Astro.",
  },
  {
    href: "/variantes/editorial",
    name: "Éditoriale",
    text: "Inspirée d'OH Architecture : fond acier clair, grandes phrases en serif avec les photos glissées dans le texte, liste des cours avec aperçu au survol.",
  },
  {
    href: "/variantes/nocturne",
    name: "Nocturne",
    text: "Version sombre et cinématique : lettres chromées O·D·E à l'ouverture, panneaux qui s'empilent, cours qui défilent à l'horizontale.",
  },
];
---

<VariantLayout title="Ode — Variantes de design">
  <main class="vi">
    <h1>Variantes de la page d'accueil</h1>
    <p class="vi-note">Brouillons pour comparer des directions. Les textes et tarifs sont provisoires.</p>
    <ul>
      {
        variants.map((v) => (
          <li>
            <a href={v.href}>
              <span class="vi-name">{v.name}</span>
              <span class="vi-text">{v.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</VariantLayout>

<style>
  .vi {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(3rem, 10vw, 8rem) 1.5rem;
    font-family: var(--sans);
    color: #1f1517;
  }
  :global(body) {
    background: #dcddd9;
  }
  h1 {
    margin: 0 0 1rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
  }
  .vi-note {
    margin: 0 0 3rem;
    color: #5d5557;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgba(31, 21, 23, 0.22);
  }
  a {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(31, 21, 23, 0.22);
    text-decoration: none;
  }
  a:hover .vi-name {
    color: #6b1622;
  }
  .vi-name {
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
  }
  .vi-text {
    color: #5d5557;
  }
  @media (max-width: 640px) {
    a {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
