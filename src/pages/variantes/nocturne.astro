---
import VariantLayout from "../../layouts/VariantLayout.astro";
import Pic from "../../components/variants/Pic.astro";
import { WAITLIST_URL, studio, pillars, classes, founder, plans, nav } from "../../data/ode";

const letters = [
  { file: "O", w: 818, h: 838 },
  { file: "D", w: 880, h: 838 },
  { file: "E", w: 750, h: 838 },
];
---

<VariantLayout title="Ode — Variante nocturne" flutedGlass bodyClass="nc">
  <header class="nc-header">
    <a href="/variantes/nocturne" class="nc-logo" aria-label="Ode, accueil">
      <img src="/images/odestudiotestsmall2x-p-500.webp" alt="" width="250" height="67" />
    </a>
    <nav class="nc-nav" aria-label="Principale">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a class="nc-pill" href={WAITLIST_URL}>Liste d'attente</a>
    </nav>
  </header>

  <main>
    <!-- Hero: the chrome letters are the one big moment -->
    <section class="nc-hero">
      <div class="nc-hero-bg glass" tlg-fluted-glass-canvas tlg-fluted-glass-mode="scroll" tlg-fluted-glass-segments="40">
        <Pic name="please-keep-the-background--the-233555-iP0" sizes="100vw" eager tlg-fluted-glass-image="" />
      </div>
      <div class="nc-hero-shade" aria-hidden="true"></div>
      <h1 class="nc-word">
        <span class="nc-sr">Ode</span>
        {
          letters.map((l) => (
            <img src={`/images/${l.file}.webp`} alt="" width={l.w} height={l.h} class="nc-letter" fetchpriority="high" />
          ))
        }
      </h1>
      <div class="nc-hero-foot">
        <p>Studio de pole dance à {studio.city}. Ouverture en {studio.opening}.</p>
        <a class="nc-button" href={WAITLIST_URL}>Rejoindre la liste d'attente</a>
      </div>
    </section>

    <!-- Manifesto: lights up word by word as you scroll -->
    <section class="nc-manifesto">
      <p class="nc-manifesto-text" data-reveal>{studio.manifesto}</p>
    </section>

    <!-- Pillars: full-height panels that stack over each other -->
    <section class="nc-pillars" aria-label="Ce que tu travailles chez Ode">
      {
        pillars.map((p, i) => (
          <article class="nc-panel" style={`--i:${i}`}>
            <div class="nc-panel-img">
              <Pic name={p.image} ext={p.ext} sizes="(max-width: 800px) 100vw, 50vw" />
            </div>
            <div class="nc-panel-text">
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </div>
          </article>
        ))
      }
    </section>

    <!-- Classes: horizontal track pinned while you scroll (desktop) -->
    <section class="nc-classes" id="cours" aria-labelledby="nc-cours-title">
      <div class="nc-classes-pin">
        <div class="nc-classes-head">
          <h2 id="nc-cours-title" class="nc-h2">Choisis ton cours</h2>
          <p>Cinq cours réguliers, des workshops chaque mois, une seule professeure pour commencer : {founder.name}</p>
        </div>
        <div class="nc-track">
          {
            classes.map((c) => (
              <article class="nc-card">
                <Pic name={c.image} ext={c.ext} sizes="(max-width: 800px) 75vw, 28vw" />
                <div class="nc-card-body">
                  <h3>{c.name}</h3>
                  <p>
                    {c.level}, {c.length}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Founder -->
    <section class="nc-founder" aria-label="La fondatrice">
      <Pic name={founder.image} ext={founder.ext} sizes="(max-width: 800px) 100vw, 50vw" class="nc-founder-img" />
      <div class="nc-founder-text">
        <p class="nc-founder-name">{founder.name}</p>
        <p class="nc-founder-role">{founder.role}</p>
        <blockquote>« {founder.quote} »</blockquote>
      </div>
    </section>

    <!-- Plans -->
    <section class="nc-plans" id="formules" aria-labelledby="nc-formules-title">
      <h2 id="nc-formules-title" class="nc-h2">Les formules</h2>
      <p class="nc-plans-note">Tarifs mensuels, sans engagement. Tarif fondateur pour les inscrites de la liste.</p>
      <div class="nc-plan-grid">
        {
          plans.map((p) => (
            <article class:list={["nc-plan", { "nc-plan--featured": p.featured }]}>
              <h3>{p.name}</h3>
              <p class="nc-price">
                {p.price}&nbsp;€<span> / mois</span>
              </p>
              <ul>
                {p.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Closing: the chrome envelope stands for the waitlist -->
    <section class="nc-closing" aria-labelledby="nc-closing-title">
      <img src="/images/Glanzende-chromen-envelop-met-hartzegel-p-800.webp" alt="" width="800" height="533" class="nc-envelope" loading="lazy" />
      <h2 id="nc-closing-title" class="nc-closing-title">Sois là le premier soir</h2>
      <p>Inscris-toi sur la liste d'attente : tu reçois l'invitation à l'ouverture et un premier cours offert.</p>
      <a class="nc-button" href={WAITLIST_URL}>Rejoindre la liste d'attente</a>
    </section>
  </main>

  <footer class="nc-footer">
    <img src="/images/odestudiotestsmall2x-p-1600.webp" alt="Studio Ode" width="1600" height="428" loading="lazy" class="nc-footer-logo" />
    <div class="nc-footer-row">
      <nav aria-label="Pied de page">
        <a href="/concept">Concept</a>
        <a href="#cours">Cours</a>
        <a href="#formules">Formules</a>
        <a href="https://instagram.com/">Instagram</a>
      </nav>
      <p>© {new Date().getFullYear()} Ode, {studio.city}</p>
    </div>
  </footer>

  <script is:inline slot="scripts">
    (function () {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      gsap.registerPlugin(ScrollTrigger);

      // Hero: chrome letters rise into place once, on load
      if (!reduce) {
        gsap.from(".nc-letter", { yPercent: 40, opacity: 0, rotateX: -35, duration: 1.4, ease: "expo.out", stagger: 0.12, delay: 0.15 });
        gsap.from(".nc-hero-foot > *", { opacity: 0, y: 16, duration: 1, ease: "power2.out", stagger: 0.1, delay: 0.7 });
      }

      // Manifesto: words go from dim to bright as you scroll
      var el = document.querySelector("[data-reveal]");
      if (el) {
        var words = el.textContent.trim().split(/\s+/);
        el.setAttribute("aria-label", el.textContent.trim());
        el.innerHTML = words.map(function (w) { return '<span aria-hidden="true">' + w + "</span>"; }).join(" ");
        if (!reduce) {
          gsap.fromTo(el.children, { opacity: 0.18 }, {
            opacity: 1, stagger: 0.08, ease: "none",
            scrollTrigger: { trigger: el, start: "top 75%", end: "bottom 45%", scrub: true },
          });
        }
      }

      // Classes: pin the section and slide the cards sideways (desktop only)
      ScrollTrigger.matchMedia({
        "(min-width: 901px)": function () {
          if (reduce) return;
          var track = document.querySelector(".nc-track");
          var distance = function () { return track.scrollWidth - window.innerWidth + 64; };
          gsap.to(track, {
            x: function () { return -distance(); },
            ease: "none",
            scrollTrigger: {
              trigger: ".nc-classes-pin",
              start: "top top",
              end: function () { return "+=" + distance(); },
              pin: true,
              scrub: 1,
              invalidateOnRefresh: true,
            },
          });
        },
      });
    })();
  </script>
</VariantLayout>

<style>
  :global(body.nc) {
    --night: #1a0a0d;
    --wine: #5c111b;
    --wine-glow: #8a1e2b;
    --blush: #ecdcda;
    --muted: rgba(236, 220, 218, 0.62);
    --hair: rgba(236, 220, 218, 0.16);
    --pad: clamp(1.25rem, 3.2vw, 3rem);
    background: var(--night);
    color: var(--blush);
    font-family: var(--sans);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .nc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* Header */
  .nc-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.1rem var(--pad) 1.6rem;
    background: linear-gradient(to bottom, rgba(26, 10, 13, 0.8), rgba(26, 10, 13, 0));
  }
  .nc-logo img {
    width: 7rem;
  }
  .nc-nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-size: 0.9375rem;
  }
  .nc-nav a {
    text-decoration: none;
  }
  .nc-pill {
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    background: rgba(236, 220, 218, 0.12);
    border: 1px solid rgba(236, 220, 218, 0.28);
    backdrop-filter: blur(10px);
  }

  .nc-button {
    display: inline-block;
    padding: 0.95rem 1.6rem;
    border-radius: 999px;
    background: var(--blush);
    color: var(--night);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background 0.2s, transform 0.2s;
  }
  .nc-button:hover {
    background: #fff;
  }

  /* Hero */
  .nc-hero {
    position: relative;
    height: 100svh;
    min-height: 36rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .nc-hero-bg {
    position: absolute;
    inset: 0;
  }
  .nc-hero-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 55%, transparent 0%, rgba(26, 10, 13, 0.35) 55%, rgba(26, 10, 13, 0.92) 100%),
      linear-gradient(to bottom, rgba(26, 10, 13, 0.25), rgba(26, 10, 13, 0.85));
  }
  .nc-word {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    gap: clamp(0.25rem, 1.2vw, 1.25rem);
    margin: 0;
    perspective: 900px;
  }
  .nc-letter {
    width: auto;
    height: clamp(5rem, 26vw, 26rem);
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.45));
  }
  .nc-hero-foot {
    position: absolute;
    z-index: 1;
    left: var(--pad);
    right: var(--pad);
    bottom: clamp(1.5rem, 4vw, 3rem);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .nc-hero-foot p {
    margin: 0;
    max-width: 22rem;
    color: var(--muted);
  }

  /* Manifesto */
  .nc-manifesto {
    padding: clamp(6rem, 16vw, 14rem) var(--pad);
  }
  .nc-manifesto-text {
    margin: 0 auto;
    max-width: 22ch;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.2rem, 5.6vw, 5.6rem);
    line-height: 1.04;
    text-align: center;
  }

  /* Pillars: sticky stacked panels */
  .nc-pillars {
    padding: 0 var(--pad) clamp(4rem, 8vw, 7rem);
  }
  .nc-panel {
    position: sticky;
    top: calc(5rem + var(--i) * 1.25rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(82vh, 46rem);
    margin-bottom: 8vh;
    border-radius: 6px;
    overflow: hidden;
    background: linear-gradient(135deg, #2a0e13, var(--wine));
    box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.35);
  }
  .nc-panel-img {
    position: relative;
    min-height: 20rem;
  }
  .nc-panel-img :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nc-panel-text {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(2rem, 5vw, 4.5rem);
  }
  .nc-panel h2 {
    margin: 0 0 1.25rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3rem, 7vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .nc-panel p {
    margin: 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 1.125rem;
  }

  /* Classes */
  .nc-classes-pin {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding: 6rem 0 3rem;
    overflow: hidden;
  }
  .nc-classes-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding: 0 var(--pad);
  }
  .nc-classes-head p {
    margin: 0;
    max-width: 26rem;
    color: var(--muted);
  }
  .nc-h2 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2.6rem, 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .nc-track {
    display: flex;
    gap: 1.25rem;
    padding: 0 var(--pad);
    width: max-content;
  }
  .nc-card {
    position: relative;
    width: clamp(15rem, 26vw, 24rem);
    aspect-ratio: 3 / 4;
    border-radius: 6px;
    overflow: hidden;
  }
  .nc-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .nc-card:hover :global(img) {
    transform: scale(1.04);
  }
  .nc-card-body {
    position: absolute;
    inset: auto 0 0;
    padding: 4rem 1.25rem 1.25rem;
    background: linear-gradient(to top, rgba(26, 10, 13, 0.9), transparent);
  }
  .nc-card h3 {
    margin: 0 0 0.25rem;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.9rem;
    line-height: 1.05;
  }
  .nc-card p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* Founder */
  .nc-founder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(5rem, 10vw, 9rem) var(--pad);
  }
  .nc-founder-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    border-radius: 6px;
  }
  .nc-founder-name {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3.5rem, 8vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }
  .nc-founder-role {
    margin: 0.75rem 0 2.5rem;
    color: var(--muted);
  }
  .nc-founder blockquote {
    margin: 0;
    max-width: 30ch;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    line-height: 1.2;
  }

  /* Plans */
  .nc-plans {
    padding: clamp(4rem, 8vw, 7rem) var(--pad);
  }
  .nc-plans-note {
    margin: 1rem 0 clamp(2.5rem, 5vw, 4rem);
    color: var(--muted);
  }
  .nc-plan-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .nc-plan {
    padding: 2rem 1.75rem 2.25rem;
    border-radius: 6px;
    border: 1px solid var(--hair);
    background: rgba(236, 220, 218, 0.03);
  }
  .nc-plan--featured {
    background: linear-gradient(160deg, var(--wine-glow), var(--wine));
    border-color: transparent;
  }
  .nc-plan h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
  }
  .nc-price {
    margin: 2rem 0 1.75rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1;
  }
  .nc-price span {
    font-family: var(--sans);
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .nc-plan ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .nc-plan li {
    padding: 0.65rem 0;
    border-top: 1px solid var(--hair);
  }

  /* Closing */
  .nc-closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(5rem, 10vw, 9rem) var(--pad);
    background: radial-gradient(ellipse at 50% 30%, rgba(138, 30, 43, 0.55), transparent 65%);
  }
  .nc-envelope {
    width: clamp(12rem, 26vw, 22rem);
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 30px 40px rgba(0, 0, 0, 0.5));
  }
  .nc-closing-title {
    margin: 0 0 1.25rem;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .nc-closing p {
    max-width: 32rem;
    margin: 0 0 2rem;
    color: var(--muted);
  }

  /* Footer */
  .nc-footer {
    padding: 3rem var(--pad) 2rem;
    border-top: 1px solid var(--hair);
  }
  .nc-footer-logo {
    width: 100%;
    opacity: 0.9;
  }
  .nc-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .nc-footer-row nav {
    display: flex;
    gap: 1.5rem;
  }
  .nc-footer-row a {
    text-decoration: none;
    color: var(--blush);
  }
  .nc-footer-row p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .nc-nav a:not(.nc-pill) {
      display: none;
    }
    .nc-hero-foot {
      flex-direction: column;
      align-items: flex-start;
    }
    .nc-panel {
      position: relative;
      top: auto;
      grid-template-columns: 1fr;
      grid-template-rows: 60vh auto;
      min-height: 0;
      margin-bottom: 1.25rem;
    }
    .nc-classes-head,
    .nc-founder {
      flex-direction: column;
      align-items: flex-start;
      grid-template-columns: 1fr;
    }
    .nc-track {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .nc-card {
      flex: 0 0 75vw;
      scroll-snap-align: start;
    }
    .nc-plan-grid {
      grid-template-columns: 1fr;
    }
    .nc-footer-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
