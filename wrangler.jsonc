// Cloudflare Workers config: serves the static Astro build from ./dist
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studio-ode-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Show our own 404 page for unknown URLs
    "not_found_handling": "404-page",
    // /concept serves concept.html
    "html_handling": "auto-trailing-slash"
  }
}
